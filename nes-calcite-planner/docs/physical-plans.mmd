%% SELECT id + 1 AS a, val FROM events WHERE val > 20 INTO sink
%% Each box is one pipeline. Arrows point in the direction the data flows.
flowchart LR
    subgraph NOW["Now: Calcite 'Map' = projection, C++ and NES pipelining decide the rest"]
        direction TB
        n1["SourceScan events<br/>origin 1"]
        subgraph n_p2["pipeline (added by NES pipelining)"]
            direction TB
            n2["Scan [ID, VAL, TS]<br/><i>added by NES</i>"]
            n3["Selection VAL > 20"]
            n4["'Map' CALCITE_F0 := ID + 1<br/><i>its output schema [CALCITE_F0, VAL]<br/>drops ID, TS: a map that is not a map</i>"]
            n5["Map a := CALCITE_F0, val := VAL<br/><i>renames added by C++ for the sink</i>"]
            n6["Emit [a, val]<br/><i>added by NES</i>"]
            n2 --> n3 --> n4 --> n5 --> n6
        end
        n7["Sink"]
        n1 --> n2
        n6 --> n7
    end

    subgraph A["Option A: Calcite places every Scan and Emit"]
        direction TB
        a1["SourceScan events<br/>origin 1"]
        subgraph a_p2["pipeline (all operators from Calcite)"]
            direction TB
            a2["Scan [ID, VAL, TS]"]
            a3["Selection VAL > 20"]
            a4["Map CALCITE_F0 := ID + 1<br/><i>record now holds ID, VAL, TS, CALCITE_F0</i>"]
            a5["Emit [CALCITE_F0 as a, VAL as val]<br/><i>drops ID, TS, reorders, renames</i>"]
            a2 --> a3 --> a4 --> a5
        end
        a6["Sink [a, val]"]
        a1 --> a2
        a5 --> a6
    end

    subgraph B["Option B: Calcite places only the Emits a projection needs"]
        direction TB
        b1["SourceScan events<br/>origin 1"]
        subgraph b_p2["pipeline 1"]
            direction TB
            b2["Scan [ID, VAL, TS]<br/><i>added by NES</i>"]
            b3["Selection VAL > 20"]
            b4["Map CALCITE_F0 := ID + 1"]
            b5["Emit [CALCITE_F0 as a, VAL as val]<br/><i>from Calcite, for the projection</i>"]
            b2 --> b3 --> b4 --> b5
        end
        subgraph b_p3["pipeline 2 (extra: buffer written and read again)"]
            direction TB
            b6["Scan [a, val]<br/><i>from Calcite</i>"]
            b7["Emit [a, val]<br/><i>added by NES before the sink</i>"]
            b6 --> b7
        end
        b8["Sink [a, val]"]
        b1 --> b2
        b5 --> b6
        b7 --> b8
    end

    classDef calcite fill:#dbeafe,stroke:#1d4ed8,color:#0b1d4f;
    classDef nes fill:#fde68a,stroke:#b45309,color:#3b2203;
    classDef cpp fill:#fecaca,stroke:#b91c1c,color:#450a0a;
    class n1,n3,n4,n7,a1,a2,a3,a4,a5,a6,b1,b3,b4,b5,b6,b8 calcite;
    class n2,n6,b2,b7 nes;
    class n5 cpp;
