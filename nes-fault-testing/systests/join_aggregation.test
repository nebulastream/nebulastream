CREATE LOGICAL SOURCE joinGenLeft(idL UINT64 NOT NULL, timestampL UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR joinGenLeft TYPE Generator SET(
       'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
       1 AS "SOURCE".SEED,
       'source-node-2:8080' AS "SOURCE"."HOST",
       'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
       'emit_rate 100' AS "SOURCE".GENERATOR_RATE_CONFIG,
       'SEQUENCE UINT64 0 0 1, SEQUENCE UINT64 0 1000000 30' AS "SOURCE".GENERATOR_SCHEMA);

CREATE LOGICAL SOURCE joinGenRight(idR UINT64 NOT NULL, timestampR UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR joinGenRight TYPE Generator SET(
       'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
       2 AS "SOURCE".SEED,
       'source-node-1:8080' AS "SOURCE"."HOST",
       'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
       'emit_rate 100' AS "SOURCE".GENERATOR_RATE_CONFIG,
       'SEQUENCE UINT64 0 0 1, SEQUENCE UINT64 0 1000000 30' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE SINK joinAggGenChecksumSink(count_id UINT64 NOT NULL) TYPE Checksum;

SELECT count(idL) as count_id FROM (
    SELECT * FROM (SELECT * FROM joinGenLeft) INNER JOIN (SELECT * FROM joinGenRight) ON idL = idR WINDOW SLIDING (timestampL, timestampR, size 1 sec, advance by 500 ms)
) WINDOW SLIDING (start, size 1 sec, advance by 500 ms)
INTO joinAggGenChecksumSink;
----
2000 433289
