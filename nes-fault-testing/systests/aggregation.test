CREATE LOGICAL SOURCE aggGen(id UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR aggGen TYPE Generator SET(
       'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
       1 AS "SOURCE".SEED,
       'source-node-1:8080' AS "SOURCE"."HOST",
       'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
       'emit_rate 100' AS "SOURCE".GENERATOR_RATE_CONFIG,
       'SEQUENCE UINT64 0 0 1, SEQUENCE UINT64 0 1000000 30' AS "SOURCE".GENERATOR_SCHEMA);

CREATE SINK aggGenChecksumSink(max_id UINT64 NOT NULL) TYPE Checksum;

SELECT max(id) as max_id FROM aggGen WINDOW SLIDING(timestamp, size 1 sec, advance by 500 ms) INTO aggGenChecksumSink;
----
2000 116000