CREATE LOGICAL SOURCE aggGenLeft(idL UINT64 NOT NULL, timestampL UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR aggGenLeft TYPE Generator SET(
       'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
       1 AS "SOURCE".SEED,
       'source-node-2:8080' AS "SOURCE"."HOST",
       'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
       'emit_rate 100' AS "SOURCE".GENERATOR_RATE_CONFIG,
       'SEQUENCE UINT64 0 0 1, SEQUENCE UINT64 0 1000000 30' AS "SOURCE".GENERATOR_SCHEMA);

CREATE LOGICAL SOURCE aggGenRight(idR UINT64 NOT NULL, timestampR UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR aggGenRight TYPE Generator SET(
       'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
       2 AS "SOURCE".SEED,
       'source-node-1:8080' AS "SOURCE"."HOST",
       'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
       'emit_rate 100' AS "SOURCE".GENERATOR_RATE_CONFIG,
       'SEQUENCE UINT64 0 0 1, SEQUENCE UINT64 0 1000000 30' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE SINK aggJoinGenChecksumSink(start UINT64 NOT NULL, end UINT64 NOT NULL, sL UINT64 NOT NULL, idL UINT64 NOT NULL, cntL UINT64 NOT NULL, sR UINT64 NOT NULL, idR UINT64 NOT NULL, cntR UINT64 NOT NULL) TYPE Checksum;

SELECT * FROM (
    SELECT start as sL, idL, count(idL) as cntL FROM aggGenLeft GROUP BY idL WINDOW SLIDING(timestampL, size 1 sec, advance by 500 ms)
) INNER JOIN (
    SELECT start as sR, idR, count(idR) as cntR FROM aggGenRight GROUP BY idR WINDOW SLIDING(timestampR, size 1 sec, advance by 500 ms)
) ON idL = idR WINDOW SLIDING(sL, sR, size 1 sec, advance by 500 ms)
INTO aggJoinGenChecksumSink;
