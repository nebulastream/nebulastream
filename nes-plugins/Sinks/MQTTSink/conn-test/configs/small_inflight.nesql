-- An MQTT sink that publishes with QoS 2.
-- The limits are small, so the client rejects messages, and the sink has to retry their buffers and apply backpressure.
CREATE SINK mqtt_small_inflight_output (data UINT8) TYPE MQTT SET (
    'tcp://localhost:1883' AS MQTT_SINK.SERVER_URI,
    'conntest'             AS MQTT_SINK.TOPIC,
    'JSON'                 AS OUTPUT_FORMATTER."TYPE",
    2                      AS MQTT_SINK.QOS,
    4                      AS MQTT_SINK.MAX_OUTSTANDING_MESSAGES,
    4                      AS MQTT_SINK.BACKPRESSURE_UPPER_THRESHOLD,
    2                      AS MQTT_SINK.BACKPRESSURE_LOWER_THRESHOLD
);
