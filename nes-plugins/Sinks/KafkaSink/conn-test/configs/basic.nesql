-- A minimal Kafka sink.
-- The connection tests replace BROKERS and TOPIC with the broker and the topic of each test.
-- The tests run no output formatter, so 'JSON' describes the bytes that the harness gives the sink.
-- The harness lays them out in buffers as the output formatter does.
CREATE SINK kafka_output (data UINT8) TYPE Kafka SET (
    'localhost:9092' AS "SINK".BROKERS,
    'conntest'       AS "SINK".TOPIC,
    'JSON'           AS "SINK".OUTPUT_FORMAT
);
