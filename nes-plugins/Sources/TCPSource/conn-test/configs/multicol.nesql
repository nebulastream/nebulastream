-- A TCP source with a mixed-type schema, so the tests' write and read-back are checked beyond a single UINT8 column.
CREATE LOGICAL SOURCE multi_input (id INT32 NOT NULL, label VARSIZED NOT NULL, ratio FLOAT64 NOT NULL);

CREATE PHYSICAL SOURCE FOR multi_input TYPE TCPSource SET (
    'localhost' AS TCP_SOURCE.SOCKET_HOST,
    9000        AS TCP_SOURCE.SOCKET_PORT,
    100         AS TCP_SOURCE.FLUSH_INTERVAL_MS,
    'JSON'      AS INPUT_FORMATTER."TYPE"
);
