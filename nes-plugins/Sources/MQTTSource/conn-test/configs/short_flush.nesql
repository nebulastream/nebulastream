-- An MQTT source that holds a partly filled buffer back for 2 s.
-- partial_buffer_held declares the same interval in its binding, because the framework does not read connector keys.
CREATE LOGICAL SOURCE smoke_input (data UINT8);

CREATE PHYSICAL SOURCE FOR smoke_input TYPE MQTT SET (
    'tcp://localhost:1883' AS "SOURCE".SERVER_URI,
    'sensors'              AS "SOURCE".TOPIC,
    1                      AS "SOURCE".QOS,
    2000                   AS "SOURCE".FLUSH_INTERVAL_MS,
    'JSON'                 AS INPUT_FORMATTER."TYPE"
);
