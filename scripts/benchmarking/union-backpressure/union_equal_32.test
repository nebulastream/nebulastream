CREATE SINK checksum(start UINT64 NOT NULL, end UINT64 NOT NULL, id INT32 NOT NULL, num UINT64 NOT NULL) TYPE Checksum;

SELECT start, end, auctionId AS id, COUNT(auctionId) AS num FROM bid
GROUP BY auctionId
WINDOW TUMBLING (timestamp, size 10 sec)
INTO checksum;
