+namespace {
+void dropTargetFeature(llvm::Function& func, llvm::StringRef feature) {
+	if (!func.hasFnAttribute("target-features")) {
+		return;
+	}
+	llvm::SmallVector<llvm::StringRef> features;
+	func.getFnAttribute("target-features").getValueAsString().split(features, ',', -1, false);
+	std::string kept;
+	for (auto f : features) {
+		if (f != feature) {
+			kept += (kept.empty() ? "" : ",") + f.str();
+		}
+	}
+	func.addFnAttr("target-features", kept);
+}
+} // namespace
