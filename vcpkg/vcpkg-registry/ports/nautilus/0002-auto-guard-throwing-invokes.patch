+#include <exception>
+#include <list>
+#include <optional>
+#include <type_traits>
+#include <utility>
+
+namespace nautilus {
+
+namespace tracing {
+
+/**
+ * Internal control-flow exception used to stop tracing the current path.
+ *
+ * This is deliberately distinct from TraceTerminationException: that exception
+ * belongs to the symbolic executor, whereas this one requests a return from the
+ * traced function after normal C++ stack unwinding has run its destructors.
+ */
+class TraceExitException final : public std::exception {};
+
+[[noreturn]] inline void exitTrace() {
+	throw TraceExitException {};
+}
+
+} // namespace tracing
+
+namespace details {
+
+inline thread_local std::exception_ptr currentException;
+inline thread_local unsigned invocationDepth = 0;
+
+/**
+ * Generated stack storage used to communicate a parked exception from a guarded
+ * native call back into the generated function. The pointer is written by the
+ * runtime thread, so generated code never embeds the tracing thread's TLS address.
+ */
+struct ExceptionHolder {
+	std::exception_ptr* exception;
+};
+
+static_assert(std::is_trivially_constructible_v<ExceptionHolder>);
+static_assert(std::is_trivially_destructible_v<ExceptionHolder>);
+
+#ifdef ENABLE_TRACING
+
+// Each active function trace owns one lazily initialized symbolic holder. A list
+// keeps outer holders stable while Nautilus recursively traces a generated callee.
+inline thread_local std::list<std::optional<val<ExceptionHolder*>>> traceExceptionHolders;
+
+class TraceExceptionHolderScope {
+public:
+	TraceExceptionHolderScope() {
+		traceExceptionHolders.emplace_back();
+	}
+
+	~TraceExceptionHolderScope() {
+		traceExceptionHolders.pop_back();
+	}
+
+	TraceExceptionHolderScope(const TraceExceptionHolderScope&) = delete;
+	TraceExceptionHolderScope& operator=(const TraceExceptionHolderScope&) = delete;
+};
+
+inline val<ExceptionHolder*>& getOrCreateTraceExceptionHolder() {
+	auto& holder = traceExceptionHolders.back();
+	if (!holder) {
+		auto& ref = tracing::traceAlloca(sizeof(ExceptionHolder), alignof(ExceptionHolder));
+		holder.emplace(ref);
+		holder->set(&ExceptionHolder::exception, static_cast<std::exception_ptr*>(nullptr));
+	}
+	return *holder;
+}
+
+#endif
+
+template <typename R>
+R exceptionSentinel() noexcept {
+	if constexpr (std::is_default_constructible_v<R>) {
+		return R {};
+	} else {
+		static_assert(std::is_trivially_copyable_v<R>,
+		              "a potentially throwing proxy must return a trivially copyable nautilus boundary type");
+		return std::bit_cast<R>(std::array<std::byte, sizeof(R)> {});
+	}
+}
+
+struct InvocationScope {
+	InvocationScope() : outermost(++invocationDepth == 1), uncaughtOnEntry(std::uncaught_exceptions()) {
+		if (outermost) {
+			currentException = nullptr;
+		}
+	}
+
+	~InvocationScope() noexcept {
+		if (outermost && std::uncaught_exceptions() > uncaughtOnEntry) {
+			currentException = nullptr;
+		}
+		--invocationDepth;
+	}
+
+	InvocationScope(const InvocationScope&) = delete;
+	InvocationScope& operator=(const InvocationScope&) = delete;
+
+	[[nodiscard]] bool isOutermost() const {
+		return outermost;
+	}
+
+private:
+	bool outermost;
+	int uncaughtOnEntry;
+};
+
+inline void updateExceptionHolder(ExceptionHolder* holder) noexcept {
+	holder->exception = currentException ? &currentException : nullptr;
+}
+
+template <typename R, typename... Args>
+R guardedRuntimeProxy(ExceptionHolder* holder, void* rawFunction, Args... args) noexcept {
+	auto function = reinterpret_cast<R (*)(Args...)>(rawFunction);
+	try {
+		if constexpr (std::is_void_v<R>) {
+			function(args...);
+			updateExceptionHolder(holder);
+			return;
+		} else {
+			auto result = function(args...);
+			updateExceptionHolder(holder);
+			return result;
+		}
+	} catch (...) {
+		if (!currentException) {
+			currentException = std::current_exception();
+		}
+		updateExceptionHolder(holder);
+		if constexpr (!std::is_void_v<R>) {
+			return exceptionSentinel<R>();
+		}
+	}
+}
+
+[[nodiscard]] inline bool hasParkedExceptionProxy() noexcept {
+	return static_cast<bool>(currentException);
+}
+
+} // namespace details
+
+[[nodiscard]] inline bool hasParkedException() {
+	return static_cast<bool>(details::currentException);
+}
+
+inline void rethrowIfParked() {
+	if (details::currentException) {
+		std::rethrow_exception(std::exchange(details::currentException, nullptr));
+	}
+}
+
+} // namespace nautilus
