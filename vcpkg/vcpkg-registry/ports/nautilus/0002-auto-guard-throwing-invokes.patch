+			    guardedRuntimeProxy<R, FunctionArguments...>, guardedFnAttrs)(
+			    exceptionHolder, val<void*> {reinterpret_cast<void*>(fnptr)}, std::forward<ValueArguments>(args)...);
+			traceExitIfExceptionSet(exceptionHolder);
+			return result;
+		}
+	}
