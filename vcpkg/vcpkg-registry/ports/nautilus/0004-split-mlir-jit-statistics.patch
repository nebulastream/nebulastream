+	int64_t blocks = 0;
+	int64_t instructions = 0;
+};
+
+LLVMIRSnapshot computeLLVMIRSnapshot(const llvm::Module& module) {
+	LLVMIRSnapshot snapshot;
+	for (const auto& function : module) {
+		++snapshot.functions;
+		if (!function.isDeclaration()) {
+			++snapshot.definedFunctions;
+		}
+		for (const auto& block : function) {
+			++snapshot.blocks;
+			snapshot.instructions += static_cast<int64_t>(block.size());
+		}
+	}
+	return snapshot;
