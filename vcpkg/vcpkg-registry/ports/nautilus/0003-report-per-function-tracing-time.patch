+TEST_CASE("CompilationStatistics: reports trace time for each module function") {
+	auto backend = getAnyBackend();
+	if (backend.empty()) {
+		SKIP("No compilation backend available");
+	}
+
+	Options options;
+	options.setOption("engine.backend", backend);
+	options.setOption("engine.compilationStrategy", std::string("legacy"));
+
+	NautilusEngine engine(options);
+	auto module = engine.createModule();
+	module.registerFunction("addOne", statsAddOne);
+	module.registerFunction("timesTwo", statsTimesTwo);
+	auto compiled = module.compile();
+
+	REQUIRE(compiled.getFunction<int32_t(int32_t)>("addOne")(3) == 4);
+	REQUIRE(compiled.getFunction<int32_t(int32_t)>("timesTwo")(3) == 6);
+
+	auto stats = compiled.getStatistics();
+	REQUIRE(stats != nullptr);
+	for (const auto* key : {"tracing.functions.addOne.ms", "tracing.functions.timesTwo.ms"}) {
+		INFO("missing key: " << key);
+		const auto* value = stats->find(key);
+		REQUIRE(value != nullptr);
+		REQUIRE(std::holds_alternative<double>(*value));
+		REQUIRE(std::get<double>(*value) >= 0.0);
+	}
+}
