+auto invoke(const FunctionAttributes fnAttrs, std::string_view symbolName, ValueArguments&&... args) {
+	return CallableNamedRuntimeFunction<R>(symbolName, fnAttrs)(std::forward<ValueArguments>(args)...);
+}
