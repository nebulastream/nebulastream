+// AArch64 ELF references the C++ EH personality indirectly through a hidden `DW.ref.<personality>` pointer
+// (DW_EH_PE_indirect|pcrel|sdata8) in both the static and the PIC relocation model, whereas x86-64 ELF uses
+// DW_EH_PE_absptr under the JIT's default static model. Because this splice renames every external declaration
+// to its runtime address, the personality becomes @"0x<addr>" and the CIE then needs a symbol named
+// `DW.ref.0x<addr>`, which the JIT symbol registry (bare `0x<addr>` names only) can never define:
+//   JIT session error: Symbols not found: [ DW.ref.0x7FFF448ABE74 ]
+// Spliced NAUTILUS_INLINE helpers only ever carry cleanup landing pads (std::string growth), and exceptions cannot
+// unwind through JIT frames at this version anyway, so strip EH from the spliced module: invoke -> call, drop the
+// orphaned pads, remove the personality, mark nounwind. x86 artifacts are untouched (host-arch guard).
+static void stripExceptionHandling(llvm::Module& module) {
+	for (auto& func : module) {
+		if (func.isDeclaration()) {
+			continue;
+		}
+		llvm::SmallVector<llvm::InvokeInst*, 8> invokes;
+		for (auto& bb : func) {
+			if (auto* inv = llvm::dyn_cast<llvm::InvokeInst>(bb.getTerminator())) {
+				invokes.push_back(inv);
+			}
+		}
+		for (auto* inv : invokes) {
+			llvm::changeToCall(inv);
+		}
+		llvm::EliminateUnreachableBlocks(func);
+		bool hasPad = false;
+		for (auto& bb : func) {
+			if (bb.isEHPad()) {
+				hasPad = true;
+				break;
+			}
+		}
+		if (func.hasPersonalityFn() && !hasPad) {
+			func.setPersonalityFn(nullptr);
+		}
+		if (!hasPad) {
+			func.addFnAttr(llvm::Attribute::NoUnwind);
+		}
+	}
+	// the personality declaration is now unused: erase it so the rename loop below never sees it
+	llvm::SmallVector<llvm::Function*, 8> dead;
+	for (auto& f : module) {
+		if (f.isDeclaration() && !f.isIntrinsic() && f.use_empty()) {
+			dead.push_back(&f);
+		}
+	}
+	for (auto* f : dead) {
+		f->eraseFromParent();
+	}
+}
+#endif
