+	}
+	auto componentsOrError = createJit(options);
+	if (!componentsOrError) {
+		return componentsOrError.takeError();
+	}
+	auto components = std::move(*componentsOrError);
+	if (auto error = components.jit->addObjectFile(std::move(object))) {
+		return std::move(error);
+	}
+	return std::unique_ptr<MLIRJit>(new MLIRJit(std::move(components.jit), components.objectLayer));
+}
