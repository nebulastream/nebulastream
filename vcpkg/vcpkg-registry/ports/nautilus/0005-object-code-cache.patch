+std::unique_ptr<MLIRJit> configureJit(llvm::Expected<std::unique_ptr<MLIRJit>> maybeJit,
+                                      const std::vector<std::string>& jitProxyFunctionSymbols,
+                                      const std::vector<void*>& jitProxyFunctionTargetAddresses) {
+	if (jitProxyFunctionSymbols.size() != jitProxyFunctionTargetAddresses.size()) {
+		throw RuntimeException("MLIR JIT symbol and address vectors differ in size");
+	}
+	if (!maybeJit) {
+		throw RuntimeException("Could not construct MLIR JIT: " + llvm::toString(maybeJit.takeError()));
+	}
+
+	auto jit = std::move(*maybeJit);
+	const auto runtimeSymbolMap = [&](llvm::orc::MangleAndInterner interner) {
+		auto symbolMap = llvm::orc::SymbolMap();
+		for (std::size_t index = 0; index < jitProxyFunctionSymbols.size(); ++index) {
+			auto* address = jitProxyFunctionTargetAddresses[index];
+			if (address == nullptr) {
+				continue;
+			}
+			symbolMap[interner(jitProxyFunctionSymbols[index])] = {llvm::orc::ExecutorAddr::fromPtr(address),
+			                                                       llvm::JITSymbolFlags::Exported};
+		}
+
+		// Let plugins contribute additional (name -> address) entries to the
+		// ORC symbol map (e.g. the inlining plugin adds the hex-formatted
+		// runtime addresses of inlinable helpers so linked bitcode resolves).
+		if (const auto& hook = getLLVMBackendHooks().jitSymbolContributor) {
+			hook([&](const std::string& name, void* address) {
+				symbolMap[interner(name)] = {llvm::orc::ExecutorAddr::fromPtr(address), llvm::JITSymbolFlags::Exported};
+			});
+		}
+		return symbolMap;
+	};
+	if (auto error = jit->registerSymbols(runtimeSymbolMap)) {
+		throw RuntimeException("Could not register MLIR JIT symbols: " + llvm::toString(std::move(error)));
+	}
+	if (auto error = jit->initialize()) {
+		throw RuntimeException("Could not initialize MLIR JIT: " + llvm::toString(std::move(error)));
+	}
+	return jit;
+}
