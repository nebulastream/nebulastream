+
+static_assert(std::is_same_v<decltype(&forwardCxxPersonality), _Unwind_Personality_Fn>);
+
+} // namespace
+
+void* getExceptionPersonalityAddress() {
+	return reinterpret_cast<void*>(&forwardCxxPersonality);
+}
+
