+std::filesystem::path findArtifact(const std::filesystem::path& directory, std::string_view extension) {
+	for (const auto& entry : std::filesystem::directory_iterator(directory)) {
+		if (entry.path().extension() == extension) {
+			return entry.path();
+		}
+	}
+	return {};
+}
