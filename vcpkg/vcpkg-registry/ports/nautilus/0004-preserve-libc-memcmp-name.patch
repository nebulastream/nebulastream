 namespace nautilus::passes {
 
+// Keep the canonical name of libc compare functions (memcmp / bcmp) that LLVM can
+// fold into inline word compares via ExpandMemCmp / LibCallSimplifier. These must
+// not be address-renamed during bitcode splicing; the JIT resolves them by name
+// against the current process, so a named call to @memcmp still links.
+static bool isFoldableLibcName(llvm::StringRef name) {
+	return name == "memcmp" || name == "bcmp";
+}
