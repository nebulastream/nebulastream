+/** Engine-scoped addresses made available to the native JIT linker. */
+class ExternalSymbolRegistry {
+public:
+	using Entries = std::unordered_map<std::string, void*>;
+	using Snapshot = std::shared_ptr<const Entries>;
+
+	ExternalSymbolRegistry() = default;
+	ExternalSymbolRegistry(const ExternalSymbolRegistry&) = delete;
+	ExternalSymbolRegistry& operator=(const ExternalSymbolRegistry&) = delete;
+
+	ExternalSymbolRegistry(ExternalSymbolRegistry&& other) noexcept {
+		std::lock_guard lock(other.mutex_);
+		entries_ = std::move(other.entries_);
+	}
+
+	ExternalSymbolRegistry& operator=(ExternalSymbolRegistry&&) = delete;
+
+	void registerSymbol(std::string_view symbolName, void* address) {
+		if (symbolName.empty() || address == nullptr) {
+			throw std::invalid_argument("External symbol requires a non-empty name and non-null address");
+		}
+
+		std::lock_guard lock(mutex_);
+		const auto name = std::string(symbolName);
+		const auto [entry, inserted] = entries_.try_emplace(name, address);
+		if (!inserted && entry->second != address) {
+			throw std::invalid_argument("External symbol '" + name + "' is already registered with another address");
+		}
+	}
+
+	[[nodiscard]] Snapshot snapshot() const {
+		std::lock_guard lock(mutex_);
+		return std::make_shared<const Entries>(entries_);
+	}
+
+private:
+	mutable std::mutex mutex_;
+	Entries entries_;
+};
