IMWRITE_PNG_BILEVEL: Literal[int] = 18
IMWRITE_WEBP_QUALITY: Literal[int] = 64

def _check_image(image):
    if not image.flags.c_contiguous:
        raise ValueError("NES cv2 requires a C-contiguous image")

def _opencv_depth(T: type):
    if T is np.uint8:
        return i64(0)
    elif T is np.int8:
        return i64(1)
    elif T is np.uint16:
        return i64(2)
    elif T is np.int16:
        return i64(3)
    elif T is np.int32:
        return i64(4)
    elif T is np.float32:
        return i64(5)
    elif T is np.float64:
        return i64(6)
    elif T is np.float16:
        return i64(7)
    else:
        compile_error("NES cv2 does not support this ndarray element type")

def _check_uint8(T: type):
    if T is not np.uint8:
        compile_error("This OpenCV operation requires a uint8 ndarray")

def _image_shape(image):
    channels = 0
    if static.len(image.shape) == 2:
        height, width = image.shape
        channels = 1
    elif static.len(image.shape) == 3:
        height, width, channels = image.shape
    else:
        compile_error("NES cv2 supports only 2D or 3D ndarrays")
    return (height, width, channels)

def _raise_native_error(status, error_pointer, error_size):
    if status != i8(0):
        raise RuntimeError(str(error_pointer, int(error_size)))

def imencode(extension, image: np.ndarray[T, N], params=(), T: type, N: Literal[int]):
    """Encode an image using any codec and pixel type supported by OpenCV."""
    _check_image(image)
    height, width, channels = _image_shape(image)

    result_pointer = Ptr[byte]()
    result_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    native_params = List[i64]()
    for parameter in params:
        native_params.append(i64(parameter))
    from C import nes_cv_imencode(
        Ptr[byte], i64, Ptr[byte], i64, i64, i64, i64, i64,
        Ptr[i64], i64,
        Ptr[Ptr[byte]], Ptr[i64], Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_imencode(
        extension.ptr,
        i64(len(extension)),
        image.data.as_byte(),
        i64(image.nbytes),
        i64(width),
        i64(height),
        i64(channels),
        _opencv_depth(T),
        native_params.arr.ptr,
        i64(len(native_params)),
        __ptr__(result_pointer),
        __ptr__(result_size),
        __ptr__(error_pointer),
        __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)

    encoded = np.ndarray[np.uint8, 1]((int(result_size),), Ptr[np.uint8](result_pointer.as_byte()))
    return (True, encoded)

def cvtColor(image: np.ndarray[T, N], code: Literal[int], dstCn=0, T: type, N: Literal[int]):
    """Convert an image using an OpenCV color conversion code."""
    _check_image(image)
    height, width, channels = _image_shape(image)
    result_pointer = Ptr[byte]()
    result_size = i64(0)
    result_width = i64(0)
    result_height = i64(0)
    result_channels = i64(0)
    result_element_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_cvt_color(
        Ptr[byte], i64, i64, i64, i64, i64, i64, i64,
        Ptr[Ptr[byte]], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64],
        Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_cvt_color(
        image.data.as_byte(), i64(image.nbytes), i64(width), i64(height), i64(channels), _opencv_depth(T), i64(code), i64(dstCn),
        __ptr__(result_pointer), __ptr__(result_size), __ptr__(result_width), __ptr__(result_height),
        __ptr__(result_channels), __ptr__(result_element_size), __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)
    if (code == COLOR_BGR2GRAY or code == COLOR_RGB2GRAY or code == COLOR_BGRA2GRAY or code == COLOR_RGBA2GRAY
            or code == COLOR_BGR5652GRAY or code == COLOR_BGR5552GRAY or code == COLOR_YUV2GRAY_420
            or code == COLOR_YUV2GRAY_UYVY or code == COLOR_YUV2GRAY_YUY2):
        return np.ndarray[T, 2]((int(result_height), int(result_width)), Ptr[T](result_pointer.as_byte()))
    return np.ndarray[T, 3](
        (int(result_height), int(result_width), int(result_channels)), Ptr[T](result_pointer.as_byte()))

def applyColorMap(image: np.ndarray[T, N], color_map: Literal[int], T: type, N: Literal[int]):
    """Apply any built-in OpenCV color map."""
    _check_image(image)
    _check_uint8(T)
    height, width, channels = _image_shape(image)
    result_pointer = Ptr[byte]()
    result_size = i64(0)
    result_width = i64(0)
    result_height = i64(0)
    result_channels = i64(0)
    result_element_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_apply_color_map(
        Ptr[byte], i64, i64, i64, i64, i64,
        Ptr[Ptr[byte]], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64],
        Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_apply_color_map(
        image.data.as_byte(), i64(image.nbytes), i64(width), i64(height), i64(channels), i64(color_map),
        __ptr__(result_pointer), __ptr__(result_size), __ptr__(result_width), __ptr__(result_height),
        __ptr__(result_channels), __ptr__(result_element_size), __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)
    return np.ndarray[np.uint8, 3](
        (int(result_height), int(result_width), int(result_channels)), Ptr[np.uint8](result_pointer.as_byte()))

def resize(
    image: np.ndarray[T, N],
    dsize,
    fx=0.0,
    fy=0.0,
    interpolation: Literal[int] = INTER_LINEAR,
    T: type,
    N: Literal[int]):
    """Resize an image using any OpenCV interpolation mode."""
    _check_image(image)
    height, width, channels = _image_shape(image)
    result_pointer = Ptr[byte]()
    result_size = i64(0)
    result_width = i64(0)
    result_height = i64(0)
    result_channels = i64(0)
    result_element_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_resize(
        Ptr[byte], i64, i64, i64, i64, i64, i64, i64, float, float, i64,
        Ptr[Ptr[byte]], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64],
        Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_resize(
        image.data.as_byte(), i64(image.nbytes), i64(width), i64(height), i64(channels), _opencv_depth(T),
        i64(dsize[0]), i64(dsize[1]), float(fx), float(fy), i64(interpolation),
        __ptr__(result_pointer), __ptr__(result_size), __ptr__(result_width), __ptr__(result_height),
        __ptr__(result_channels), __ptr__(result_element_size), __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)
    if static.len(image.shape) == 2:
        return np.ndarray[T, 2]((int(result_height), int(result_width)), Ptr[T](result_pointer.as_byte()))
    return np.ndarray[T, 3]((int(result_height), int(result_width), int(result_channels)), Ptr[T](result_pointer.as_byte()))

def imdecode(encoded: np.ndarray[T, N], flags: Literal[int], T: type, N: Literal[int]):
    """Decode an image using an OpenCV image-read mode."""
    _check_image(encoded)
    _check_uint8(T)
    result_pointer = Ptr[byte]()
    result_size = i64(0)
    result_width = i64(0)
    result_height = i64(0)
    result_channels = i64(0)
    result_element_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_imdecode(
        Ptr[byte], i64, i64, Ptr[Ptr[byte]], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64],
        Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_imdecode(
        encoded.data.as_byte(), i64(encoded.nbytes), i64(flags), __ptr__(result_pointer), __ptr__(result_size),
        __ptr__(result_width), __ptr__(result_height), __ptr__(result_channels), __ptr__(result_element_size),
        __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)
    if flags == IMREAD_UNCHANGED:
        if result_channels != i64(1) or result_element_size != i64(2):
            raise ValueError("NES cv2.IMREAD_UNCHANGED expects a 16-bit single-channel image")
        return np.ndarray[np.uint16, 2](
            (int(result_height), int(result_width)), Ptr[np.uint16](result_pointer.as_byte()))
    if (flags == IMREAD_GRAYSCALE or flags == IMREAD_REDUCED_GRAYSCALE_2
            or flags == IMREAD_REDUCED_GRAYSCALE_4 or flags == IMREAD_REDUCED_GRAYSCALE_8):
        return np.ndarray[np.uint8, 2](
            (int(result_height), int(result_width)), Ptr[np.uint8](result_pointer.as_byte()))
    if result_element_size != i64(1):
        raise ValueError("NES cv2.imdecode needs an explicit statically typed wrapper for this decoded pixel depth")
    return np.ndarray[np.uint8, 3](
        (int(result_height), int(result_width), int(result_channels)), Ptr[np.uint8](result_pointer.as_byte()))

def rectangle(
    image: np.ndarray[T, N],
    point1,
    point2,
    color,
    thickness=1,
    lineType: Literal[int] = LINE_8,
    shift=0,
    T: type,
    N: Literal[int]):
    """Draw an in-place rectangle and return the input ndarray."""
    _check_image(image)
    height, width, channels = _image_shape(image)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_rectangle(
        Ptr[byte], i64, i64, i64, i64, i64, i64, i64, i64, i64, float, float, float, i64, i64, i64,
        Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_rectangle(
        image.data.as_byte(), i64(image.nbytes), i64(width), i64(height), i64(channels), _opencv_depth(T),
        i64(point1[0]), i64(point1[1]), i64(point2[0]), i64(point2[1]),
        float(color[0]), float(color[1]), float(color[2]), i64(thickness), i64(lineType), i64(shift),
        __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)
    return image

def warpAffine(
    src: np.ndarray[T, N],
    M,
    dsize,
    dst=None,
    flags: Literal[int] = INTER_LINEAR,
    borderMode: Literal[int] = BORDER_CONSTANT,
    borderValue=(0.0, 0.0, 0.0, 0.0),
    T: type,
    N: Literal[int]):
    """Apply a 2x3 affine transform using OpenCV's interpolation and border modes."""
    _check_image(src)
    if dst is not None:
        raise ValueError("NES cv2.warpAffine does not yet reuse a caller-provided dst allocation")
    if static.len(M.shape) != 2 or M.shape[0] != 2 or M.shape[1] != 3:
        raise ValueError("cv2.warpAffine transformation matrix must have shape (2, 3)")
    height, width, channels = _image_shape(src)
    result_pointer = Ptr[byte]()
    result_size = i64(0)
    result_width = i64(0)
    result_height = i64(0)
    result_channels = i64(0)
    result_element_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_warp_affine(
        Ptr[byte], i64, i64, i64, i64, i64,
        float, float, float, float, float, float,
        i64, i64, i64, i64, float, float, float, float,
        Ptr[Ptr[byte]], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_warp_affine(
        src.data.as_byte(), i64(src.nbytes), i64(width), i64(height), i64(channels), _opencv_depth(T),
        float(M[0, 0]), float(M[0, 1]), float(M[0, 2]),
        float(M[1, 0]), float(M[1, 1]), float(M[1, 2]),
        i64(dsize[0]), i64(dsize[1]), i64(flags), i64(borderMode),
        float(borderValue[0]), float(borderValue[1]), float(borderValue[2]), float(borderValue[3]),
        __ptr__(result_pointer), __ptr__(result_size), __ptr__(result_width), __ptr__(result_height),
        __ptr__(result_channels), __ptr__(result_element_size), __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)
    if N == 2:
        return np.ndarray[T, 2]((int(result_height), int(result_width)), Ptr[T](result_pointer.as_byte()))
    return np.ndarray[T, 3](
        (int(result_height), int(result_width), int(result_channels)), Ptr[T](result_pointer.as_byte()))

def normalize(
    src: np.ndarray[T, N],
    dst=None,
    alpha=1.0,
    beta=0.0,
    norm_type: Literal[int] = NORM_L2,
    dtype: Literal[int] = -1,
    mask=None,
    T: type,
    N: Literal[int]):
    """Normalize an array using OpenCV's norm and output-depth parameters."""
    _check_image(src)
    if dst is not None:
        raise ValueError("NES cv2.normalize does not yet reuse a caller-provided dst allocation")
    if mask is not None:
        raise ValueError("NES cv2.normalize does not yet support a mask")
    height, width, channels = _image_shape(src)
    result_pointer = Ptr[byte]()
    result_size = i64(0)
    result_width = i64(0)
    result_height = i64(0)
    result_channels = i64(0)
    result_element_size = i64(0)
    error_pointer = Ptr[byte]()
    error_size = i64(0)
    from C import nes_cv_normalize(
        Ptr[byte], i64, i64, i64, i64, i64, float, float, i64, i64,
        Ptr[Ptr[byte]], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[i64], Ptr[Ptr[byte]], Ptr[i64]) -> i8
    status = nes_cv_normalize(
        src.data.as_byte(), i64(src.nbytes), i64(width), i64(height), i64(channels), _opencv_depth(T),
        float(alpha), float(beta), i64(norm_type), i64(dtype), __ptr__(result_pointer), __ptr__(result_size),
        __ptr__(result_width), __ptr__(result_height), __ptr__(result_channels), __ptr__(result_element_size),
        __ptr__(error_pointer), __ptr__(error_size))
    _raise_native_error(status, error_pointer, error_size)

    if dtype == -1:
        if N == 2:
            return np.ndarray[T, 2]((int(result_height), int(result_width)), Ptr[T](result_pointer.as_byte()))
        return np.ndarray[T, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[T](result_pointer.as_byte()))
    elif dtype == CV_8U:
        if N == 2:
            return np.ndarray[np.uint8, 2](
                (int(result_height), int(result_width)), Ptr[np.uint8](result_pointer.as_byte()))
        return np.ndarray[np.uint8, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.uint8](result_pointer.as_byte()))
    elif dtype == CV_8S:
        if N == 2:
            return np.ndarray[np.int8, 2]((int(result_height), int(result_width)), Ptr[np.int8](result_pointer.as_byte()))
        return np.ndarray[np.int8, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.int8](result_pointer.as_byte()))
    elif dtype == CV_16U:
        if N == 2:
            return np.ndarray[np.uint16, 2](
                (int(result_height), int(result_width)), Ptr[np.uint16](result_pointer.as_byte()))
        return np.ndarray[np.uint16, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.uint16](result_pointer.as_byte()))
    elif dtype == CV_16S:
        if N == 2:
            return np.ndarray[np.int16, 2](
                (int(result_height), int(result_width)), Ptr[np.int16](result_pointer.as_byte()))
        return np.ndarray[np.int16, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.int16](result_pointer.as_byte()))
    elif dtype == CV_32S:
        if N == 2:
            return np.ndarray[np.int32, 2](
                (int(result_height), int(result_width)), Ptr[np.int32](result_pointer.as_byte()))
        return np.ndarray[np.int32, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.int32](result_pointer.as_byte()))
    elif dtype == CV_32F:
        if N == 2:
            return np.ndarray[np.float32, 2](
                (int(result_height), int(result_width)), Ptr[np.float32](result_pointer.as_byte()))
        return np.ndarray[np.float32, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.float32](result_pointer.as_byte()))
    elif dtype == CV_64F:
        if N == 2:
            return np.ndarray[np.float64, 2](
                (int(result_height), int(result_width)), Ptr[np.float64](result_pointer.as_byte()))
        return np.ndarray[np.float64, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.float64](result_pointer.as_byte()))
    elif dtype == CV_16F:
        if N == 2:
            return np.ndarray[np.float16, 2](
                (int(result_height), int(result_width)), Ptr[np.float16](result_pointer.as_byte()))
        return np.ndarray[np.float16, 3](
            (int(result_height), int(result_width), int(result_channels)), Ptr[np.float16](result_pointer.as_byte()))
    else:
        compile_error("NES cv2.normalize does not yet expose this OpenCV output depth")
