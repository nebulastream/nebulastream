{{/* Pages are generated by the _content.gotmpl content adapters and have no backing
     file, so Hugo's built-in relative .md link resolution can't see them. This adapter
     mirrors docs/technical (mounted at assets/technical). To add a page: drop a
     plain .md file there, then add one row below. */}}
{{ $pages := slice
  (dict "path" "QueryEngineTaskQueue" "title" "Query Engine Task Queue" "weight" 10 "source" "technical/QueryEngine_TaskQueue.md")
  (dict "path" "IRBinding" "title" "IR Binding" "weight" 20 "source" "technical/ir_binding.md")
  (dict "path" "Dependency" "title" "Dependency Handling" "weight" 30 "source" "technical/dependency.md")
  (dict "path" "NullHandling" "title" "Null Handling" "weight" 40 "source" "technical/null_handling.md")
  (dict "path" "ModelInference" "title" "Model Inference" "weight" 50 "source" "technical/model_inference.md")
  (dict "path" "WatermarkingProgressWindowTriggering" "title" "Watermarking, Progress & Window Triggering" "weight" 60 "source" "technical/watermarking_progress_window_triggering.md")
  (dict "path" "Serialization" "title" "Serialization" "weight" 70 "source" "technical/serialization.md")
}}
{{ range $pages }}
  {{ $resource := resources.Get .source }}
  {{ $.AddPage (dict
    "path" .path
    "title" .title
    "weight" .weight
    "kind" "page"
    "params" (dict "sourceBasename" (path.Base .source))
    "content" (dict "mediaType" "text/markdown" "value" $resource.Content)
  ) }}
{{ end }}
