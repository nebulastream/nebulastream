{{/* Pages are generated by the _content.gotmpl content adapters and have no backing
     file, so Hugo's built-in relative .md link resolution can't see them. This adapter
     mirrors docs/getting-started (mounted at assets/getting-started). To add a page:
     drop a plain .md file there, then add one row below. */}}
{{ $pages := slice
  (dict "path" "GetStarted" "title" "Quick Start" "weight" 10 "source" "getting-started/get_started.md")
  (dict "path" "SingleNode" "title" "Single-Node Deployment" "weight" 20 "source" "getting-started/single_node.md")
  (dict "path" "Distributed" "title" "Distributed Deployment" "weight" 30 "source" "getting-started/distributed.md")
}}
{{ range $pages }}
  {{ $resource := resources.Get .source }}
  {{ $.AddPage (dict
    "path" .path
    "title" .title
    "weight" .weight
    "kind" "page"
    "params" (dict "sourceBasename" (path.Base .source))
    "content" (dict "mediaType" "text/markdown" "value" $resource.Content)
  ) }}
{{ end }}
