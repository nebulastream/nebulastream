{{/* Pages are generated by the _content.gotmpl content adapters and have no backing
     file, so Hugo's built-in relative .md link resolution can't see them. This adapter
     mirrors docs/guide (mounted at assets/guide). To add a page: drop a plain .md file
     there, then add one row below. */}}
{{ $pages := slice
  (dict "path" "GeneralOverview" "title" "Overview" "weight" 10 "source" "guide/overview.md")
  (dict "path" "general-concepts" "title" "Stream Processing Theory" "weight" 20 "source" "guide/general_concepts.md")
  (dict "path" "APIConcepts" "title" "API Concepts" "weight" 30 "source" "guide/query_api.md")
  (dict "path" "SourcesAndSinks" "title" "Sources and Sinks" "weight" 40 "source" "guide/sources-and-sinks.md")
  (dict "path" "Operators" "title" "Operators" "weight" 50 "source" "guide/operators.md")
  (dict "path" "Functions" "title" "Functions" "weight" 60 "source" "guide/functions.md")
}}
{{ range $pages }}
  {{ $resource := resources.Get .source }}
  {{ $.AddPage (dict
    "path" .path
    "title" .title
    "weight" .weight
    "kind" "page"
    "params" (dict "sourceBasename" (path.Base .source))
    "content" (dict "mediaType" "text/markdown" "value" $resource.Content)
  ) }}
{{ end }}
