{{/* Pages are generated by the _content.gotmpl content adapters and have no backing
     file, so Hugo's built-in relative .md link resolution can't see them. This adapter
     mirrors docs/development (mounted at assets/development). To add a page: drop a
     plain .md file there, then add one row below. */}}
{{ $pages := slice
  (dict "path" "developer" "title" "Build instructions" "weight" 10 "source" "development/development.md")
  (dict "path" "RunningWorkflowsLocally" "title" "Running Workflows Locally" "weight" 20 "source" "development/running_workflows_locally.md")
  (dict "path" "PackagingDockerImages" "title" "Packaging Docker Images" "weight" 30 "source" "development/packaging_docker_images.md")
  (dict "path" "FixClangTidyWarnings" "title" "Fix Clang-Tidy Warnings" "weight" 40 "source" "development/fix_clang_tidy_warnings.md")
  (dict "path" "Serialization" "title" "Serialization" "weight" 50 "source" "development/serialization.md")
  (dict "path" "Systests" "title" "System Tests" "weight" 60 "source" "development/systests.md")
  (dict "path" "HowToAddASource" "title" "How to add a Source" "weight" 70 "source" "development/how_to_add_a_source.md")
  (dict "path" "HowToAddASink" "title" "How to add a Sink" "weight" 80 "source" "development/how_to_add_a_sink.md")
  (dict "path" "HowToAddAPlacementStrategy" "title" "How to add a Placement Strategy" "weight" 90 "source" "development/how_to_add_a_placement_strategy.md")
  (dict "path" "HowToAddAnOptimizerRule" "title" "How to add an Optimizer Rule" "weight" 100 "source" "development/how_to_add_an_optimizer_rule.md")
  (dict "path" "Extensibility" "title" "Extensibility, Plugins, and Registries" "weight" 110 "source" "development/extensibility.md")
  (dict "path" "Testing" "title" "Testing" "weight" 120 "source" "development/testing.md")
}}
{{ range $pages }}
  {{ $resource := resources.Get .source }}
  {{ $.AddPage (dict
    "path" .path
    "title" .title
    "weight" .weight
    "kind" "page"
    "params" (dict "sourceBasename" (path.Base .source))
    "content" (dict "mediaType" "text/markdown" "value" $resource.Content)
  ) }}
{{ end }}
