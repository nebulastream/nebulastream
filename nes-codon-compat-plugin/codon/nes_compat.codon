"""Stand-ins for Python builtins that Codon's stdlib does not define. NES imports this module into every Codon UDF
module (`from nes_compat import *`), so UDF code that names these builtins compiles.

NES passes VARSIZED values to Codon UDFs as str, never as bytes. The bytes types therefore only need to exist: a check
such as `isinstance(x, (bytes, bytearray))` resolves to False at compile time and the str is used as is.
"""


class bytes:
    pass


class bytearray:
    pass
