# name: differential/JoinEquivalence.test
# description: Ensure differential queries agree for logically equivalent joins
# groups: [Differential, Join]

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE Generator SET(
    3 AS "SOURCE".SEED,
    'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    'SEQUENCE UINT64 1 5 1, SEQUENCE UINT64 50 90 10, SEQUENCE UINT64 1000 1800 200' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE LOGICAL SOURCE stream2(key1_s2 UINT64 NOT NULL, key2_s2 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, ts UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE Generator SET(
    2 AS "SOURCE".SEED,
    'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    'SEQUENCE UINT64 1 5 1, SEQUENCE UINT64 10 14 1, SEQUENCE UINT64 1 5 1, SEQUENCE UINT64 100 140 10, SEQUENCE UINT64 1000 1800 200, SEQUENCE UINT64 1000 1800 200' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE LOGICAL SOURCE stream4(id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream4 TYPE Generator SET(
    4 AS "SOURCE".SEED,
    'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    'SEQUENCE UINT64 1 5 1, SEQUENCE UINT64 200 240 10, SEQUENCE UINT64 1000 1800 200' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE LOGICAL SOURCE stream4_1(id4_1 UINT64 NOT NULL, value4_1 UINT64 NOT NULL, timestamp4_1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream4_1 TYPE Generator SET(
    5 AS "SOURCE".SEED,
    'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    'SEQUENCE UINT64 1 5 1, SEQUENCE UINT64 300 340 10, SEQUENCE UINT64 1000 1800 200' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE SINK sinkStreamStream2Stream4Stream4_1(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start2 UINT64 NOT NULL, end2 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, key1_s2 UINT64 NOT NULL, key2_s2 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, ts UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL, id4_1 UINT64 NOT NULL, value4_1 UINT64 NOT NULL, timestamp4_1 UINT64 NOT NULL) TYPE File;

SELECT e.start1, e.end1, e.start2, e.end2, e.window_start AS "START", e.window_end AS "END",
       e.id, e."VALUE", e.timestamp1, e.key1_s2, e.key2_s2, e.id2, e.value2, e.ts, e.timestamp2,
       e.id4, e.value4, e.timestamp4, f.id4_1, f.value4_1, f.timestamp4_1
FROM TABLE(HOP((
        SELECT c.window_start AS start2, c.window_end AS end2, c.start1, c.end1, c.id, c."VALUE", c.timestamp1,
               c.key1_s2, c.key2_s2, c.id2, c.value2, c.ts, c.timestamp2, d.id4, d.value4, d.timestamp4
        FROM TABLE(HOP((
            SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1,
                   b.key1_s2, b.key2_s2, b.id2, b.value2, b.ts, b.timestamp2
            FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS a
            JOIN TABLE(HOP(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS b
            ON a.window_start = b.window_start AND a.id = b.id2),
            DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS c
        JOIN TABLE(HOP(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS d
        ON c.window_start = d.window_start AND c.id = d.id4),
    DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS e
JOIN TABLE(HOP(TABLE stream4_1, DESCRIPTOR(timestamp4_1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS f
ON e.window_start = f.window_start AND e.id = f.id4_1
INTO sinkStreamStream2Stream4Stream4_1;
====
SELECT e.start1, e.end1, e.start2, e.end2, e.window_start AS "START", e.window_end AS "END",
       e.id, e."VALUE", e.timestamp1, e.key1_s2, e.key2_s2, e.id2, e.value2, e.ts, e.timestamp2,
       e.id4, e.value4, e.timestamp4, f.id4_1, f.value4_1, f.timestamp4_1
FROM TABLE(HOP((
        SELECT c.window_start AS start2, c.window_end AS end2, c.start1, c.end1, c.id, c."VALUE", c.timestamp1,
               c.key1_s2, c.key2_s2, c.id2, c.value2, c.ts, c.timestamp2, d.id4, d.value4, d.timestamp4
        FROM TABLE(HOP((
            SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1,
                   b.key1_s2, b.key2_s2, b.id2, b.value2, b.ts, b.timestamp2
            FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS a
            JOIN TABLE(HOP(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS b
            ON a.window_start = b.window_start AND NOT (a.id <> b.id2)),
            DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS c
        JOIN TABLE(HOP(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS d
        ON c.window_start = d.window_start AND NOT (c.id <> d.id4)),
    DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS e
JOIN TABLE(HOP(TABLE stream4_1, DESCRIPTOR(timestamp4_1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS f
ON e.window_start = f.window_start AND NOT (e.id <> f.id4_1)
INTO sinkStreamStream2Stream4Stream4_1;


CREATE LOGICAL SOURCE streamCSV(id UINT64 NOT NULL, value UINT64 NOT NULL, timestampCSV UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR streamCSV TYPE File;
ATTACH FILE small/stream.csv

CREATE LOGICAL SOURCE streamCSV2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestampCSV2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR streamCSV2 TYPE File;
ATTACH FILE small/stream2.csv

CREATE SINK sinkStreamStream2(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestampCSV UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestampCSV2 UINT64 NOT NULL) TYPE File;

SELECT s.window_start AS "START", s.window_end AS "END", s.id, s."VALUE", s.timestampCSV, s2.id2, s2.value2, s2.timestampCSV2
FROM TABLE(TUMBLE(TABLE streamCSV, DESCRIPTOR(timestampCSV), INTERVAL '1' SECOND)) AS s
JOIN TABLE(TUMBLE(TABLE streamCSV2, DESCRIPTOR(timestampCSV2), INTERVAL '1' SECOND)) AS s2
ON s.window_start = s2.window_start AND s.id = s2.id2 AND s."VALUE" = s2.value2
WHERE s."VALUE" < 15
INTO sinkStreamStream2;
====
SELECT *
FROM (
    SELECT s.window_start AS "START", s.window_end AS "END", s.id, s."VALUE", s.timestampCSV, s2.id2, s2.value2, s2.timestampCSV2
    FROM TABLE(TUMBLE(TABLE streamCSV, DESCRIPTOR(timestampCSV), INTERVAL '1' SECOND)) AS s
    JOIN TABLE(TUMBLE(TABLE streamCSV2, DESCRIPTOR(timestampCSV2), INTERVAL '1' SECOND)) AS s2
    ON s.window_start = s2.window_start AND s.id = s2.id2 AND s."VALUE" = s2.value2
)
WHERE "VALUE" < 15
INTO sinkStreamStream2;
