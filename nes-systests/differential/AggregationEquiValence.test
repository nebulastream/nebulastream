# name: differential/AggregationEquivalence.test
# description: Ensure differential queries agree for logically equivalent aggregation
# groups: [Differential, Aggregation, CompilationIntensive] TODO #1272

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE Generator SET(
    1 AS "SOURCE".SEED,
    'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    'SEQUENCE UINT64 1 5 1, SEQUENCE UINT64 10 50 10, SEQUENCE UINT64 0 20000 5000' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE SINK sinkStream(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, sumValue UINT64) TYPE File;

SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS sumValue
FROM TABLE(HOP(
  (SELECT id, window_start AS "START", SUM("VALUE") AS "VALUE"
   FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '5' SECOND))
   GROUP BY window_start, window_end, id),
  DESCRIPTOR("START"), INTERVAL '5' SECOND, INTERVAL '10' SECOND))
GROUP BY window_start, window_end, id
INTO sinkStream;
====
SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS sumValue
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '5' SECOND, INTERVAL '10' SECOND))
GROUP BY window_start, window_end, id
INTO sinkStream;
