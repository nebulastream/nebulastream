# name: align/AlignNNChained.test
# description: Two NN ALIGN() operators chained back to back (stage 2 consumes stage 1's output)
# groups: [Align]

CREATE LOGICAL SOURCE alignChainLeft(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignChainLeft TYPE File;
ATTACH INLINE
1,10,10
1,30,30
1,32,32
1,50,50
1,55,55
1,58,58
1,61,61
1,100,100

CREATE LOGICAL SOURCE alignChainRight(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, ts2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignChainRight TYPE File;
ATTACH INLINE
2,5,5
2,15,15
2,31,31
2,45,45
2,60,60
2,62,62

CREATE LOGICAL SOURCE alignChainMid(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignChainMid TYPE File;
ATTACH INLINE
1,10,10,2,5
1,30,30,2,31
1,32,32,2,31
1,50,50,2,45
1,55,55,2,60
1,58,58,2,60
1,61,61,2,60

CREATE LOGICAL SOURCE alignChainThird(id3 UINT64 NOT NULL, value3 UINT64 NOT NULL, ts3 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignChainThird TYPE File;
ATTACH INLINE
3,100,5
3,200,40
3,300,53
3,400,70
3,500,95

CREATE SINK sinkAlignChainStage1(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL) TYPE File;

CREATE SINK sinkAlignChainStage2(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, id3 UINT64 NOT NULL, value3 UINT64 NOT NULL) TYPE File;

SELECT * FROM ALIGN(alignChainLeft, ts1, alignChainRight, ts2, NN) INTO sinkAlignChainStage1;
----
1 10 10 2 5
1 30 30 2 31
1 32 32 2 31
1 50 50 2 45
1 55 55 2 60
1 58 58 2 60
1 61 61 2 60

SELECT * FROM ALIGN(alignChainMid, ts1, alignChainThird, ts3, NN) INTO sinkAlignChainStage2;
----
1 10 10 2 5 3 100
1 30 30 2 31 3 200
1 32 32 2 31 3 200
1 50 50 2 45 3 300
1 55 55 2 60 3 300
1 58 58 2 60 3 300
1 61 61 2 60 3 300
