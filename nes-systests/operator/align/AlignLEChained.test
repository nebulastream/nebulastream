# name: align/AlignLEChained.test
# description: Two LE ALIGN() operators chained back to back (stage 2 consumes stage 1's output)
# groups: [Align]

CREATE LOGICAL SOURCE alignLEChainLeft(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLEChainLeft TYPE File;
ATTACH INLINE
1,10,10
1,30,30
1,32,32
1,50,50
1,55,55
1,58,58
1,61,61
1,100,100

CREATE LOGICAL SOURCE alignLEChainRight(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, ts2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLEChainRight TYPE File;
ATTACH INLINE
2,5,5
2,15,15
2,31,31
2,45,45
2,60,60
2,62,62

CREATE LOGICAL SOURCE alignLEChainMid(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLEChainMid TYPE File;
ATTACH INLINE
1,10,10,2,5
1,30,30,2,15
1,32,32,2,31
1,50,50,2,45
1,55,55,2,45
1,58,58,2,45
1,61,61,2,60

CREATE LOGICAL SOURCE alignLEChainThird(id3 UINT64 NOT NULL, value3 UINT64 NOT NULL, ts3 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLEChainThird TYPE File;
ATTACH INLINE
3,100,5
3,200,40
3,300,53
3,400,70
3,500,95

CREATE SINK sinkAlignLEChainStage1(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL) TYPE File;

CREATE SINK sinkAlignLEChainStage2(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, id3 UINT64 NOT NULL, value3 UINT64 NOT NULL) TYPE File;

SELECT * FROM ALIGN(alignLEChainLeft, ts1, alignLEChainRight, ts2, <=) INTO sinkAlignLEChainStage1;
----
1 10 10 2 5
1 30 30 2 15
1 32 32 2 31
1 50 50 2 45
1 55 55 2 45
1 58 58 2 45
1 61 61 2 60

SELECT * FROM ALIGN(alignLEChainMid, ts1, alignLEChainThird, ts3, <=) INTO sinkAlignLEChainStage2;
----
1 10 10 2 5 3 100
1 30 30 2 15 3 100
1 32 32 2 31 3 100
1 50 50 2 45 3 200
1 55 55 2 45 3 300
1 58 58 2 45 3 300
1 61 61 2 60 3 300
