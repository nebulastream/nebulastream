# name: align/AlignNN.test
# description: Smoke test for the left-anchored NN ALIGN() strategy
# groups: [Align]

CREATE LOGICAL SOURCE alignLeft(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLeft TYPE File;
ATTACH INLINE
1,10,10
1,30,30
1,32,32
1,50,50
1,55,55
1,58,58
1,61,61
1,100,100

CREATE LOGICAL SOURCE alignRight(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, ts2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignRight TYPE File;
ATTACH INLINE
2,5,5
2,15,15
2,31,31
2,45,45
2,60,60
2,62,62

CREATE SINK sinkAlignNN(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL) TYPE File;

SELECT * FROM ALIGN(alignLeft, ts1, alignRight, ts2, NN) INTO sinkAlignNN;
----
1 10 10 2 5
1 30 30 2 31
1 32 32 2 31
1 50 50 2 45
1 55 55 2 60
1 58 58 2 60
1 61 61 2 60
