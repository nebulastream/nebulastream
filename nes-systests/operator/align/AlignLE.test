# name: align/AlignLE.test
# description: Smoke test for the backward (LE) ALIGN() strategy
# groups: [Align]

CREATE LOGICAL SOURCE alignLELeft(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLELeft TYPE File;
ATTACH INLINE
1,10,10
1,30,30
1,32,32
1,50,50
1,55,55
1,58,58
1,61,61
1,100,100

CREATE LOGICAL SOURCE alignLERight(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, ts2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR alignLERight TYPE File;
ATTACH INLINE
2,5,5
2,15,15
2,31,31
2,45,45
2,60,60
2,62,62

CREATE SINK sinkAlignLE(id UINT64 NOT NULL, value UINT64 NOT NULL, ts1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL) TYPE File;

SELECT * FROM ALIGN(alignLELeft, ts1, alignLERight, ts2, <=) INTO sinkAlignLE;
----
1 10 10 2 5
1 30 30 2 15
1 32 32 2 31
1 50 50 2 45
1 55 55 2 45
1 58 58 2 45
1 61 61 2 60
