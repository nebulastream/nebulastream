# name: join/JoinMultipleStreams.test
# description: Test join operator
# groups: [WindowOperators, Join, CompilationIntensive] TODO #1272

# Source definitions
CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH FILE small/stream.csv

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH FILE small/stream2.csv

CREATE LOGICAL SOURCE stream4(id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream4 TYPE File;
ATTACH FILE small/stream4.csv

CREATE LOGICAL SOURCE stream4_1(id4_1 UINT64 NOT NULL, value4_1 UINT64 NOT NULL, timestamp4_1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream4_1 TYPE File;
ATTACH FILE small/stream4.csv

CREATE LOGICAL SOURCE stream7(id7 UINT64 NOT NULL, value7 UINT64 NOT NULL, timestamp7 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream7 TYPE File;
ATTACH FILE small/stream7.csv

CREATE LOGICAL SOURCE stream7_1(id7_1 UINT64 NOT NULL, value7_1 UINT64 NOT NULL, timestamp7_1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream7_1 TYPE File;
ATTACH FILE small/stream7.csv

CREATE SINK sinkStreamStream2(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkStreamStream2Stream4(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL)  TYPE File;
CREATE SINK sinkStreamStream2Stream4Stream4_1(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start2 UINT64 NOT NULL, end2 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL, id4_1 UINT64 NOT NULL, value4_1 UINT64 NOT NULL, timestamp4_1 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkStream7Stream7_1(start UINT64 NOT NULL, end UINT64 NOT NULL, id7 UINT64 NOT NULL, value7 UINT64 NOT NULL, timestamp7 UINT64 NOT NULL, id7_1 UINT64 NOT NULL, value7_1 UINT64 NOT NULL, timestamp7_1 UINT64 NOT NULL) TYPE File;

# Query 1 - Join two streams
SELECT l.window_start AS "START", l.window_end AS "END",
       l.id, l."VALUE", l.timestamp1, r.id2, r.value2, r.timestamp2
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS l
JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '1' SECOND)) AS r
ON l.window_start = r.window_start AND id = id2
INTO sinkStreamStream2;
----
