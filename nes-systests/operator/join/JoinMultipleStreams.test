# Query 4 - Join two streams with a sliding stream
SELECT l.window_start AS "START", l.window_end AS "END",
       l.id7, l.value7, l.timestamp7, r.id7_1, r.value7_1, r.timestamp7_1
FROM TABLE(HOP(TABLE stream7, DESCRIPTOR(timestamp7), INTERVAL '0.25' SECOND, INTERVAL '1' SECOND)) AS l
JOIN TABLE(HOP(TABLE stream7_1, DESCRIPTOR(timestamp7_1), INTERVAL '0.25' SECOND, INTERVAL '1' SECOND)) AS r
ON l.window_start = r.window_start AND id7 = id7_1
INTO sinkStream7Stream7_1;
