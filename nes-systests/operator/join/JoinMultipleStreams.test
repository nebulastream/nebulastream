# Query 5 - Join three streams with a sliding stream
SELECT e.start1, e.end1, e.start2, e.end2, e.window_start AS "START", e.window_end AS "END", e.id, e."VALUE", e.timestamp1, e.id2, e.value2, e.timestamp2, e.id4, e.value4, e.timestamp4, f.id4_1, f.value4_1, f.timestamp4_1
FROM TABLE(HOP((SELECT c.window_start AS start2, c.window_end AS end2, c.start1, c.end1, c.id, c."VALUE", c.timestamp1, c.id2, c.value2, c.timestamp2, d.id4, d.value4, d.timestamp4
  FROM TABLE(HOP((SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1, b.id2, b.value2, b.timestamp2
    FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS a
    JOIN TABLE(HOP(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS b
    ON a.window_start = b.window_start AND a.id = b.id2), DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS c
  JOIN TABLE(HOP(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS d
  ON c.window_start = d.window_start AND c.id = d.id4), DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS e
JOIN TABLE(HOP(TABLE stream4_1, DESCRIPTOR(timestamp4_1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS f
ON e.window_start = f.window_start AND e.id = f.id4_1
INTO sinkStreamStream2Stream4Stream4_1;
