# name: join/RightOuterJoin.test
# description: Test RIGHT OUTER JOIN — all right tuples emitted; unmatched right tuples have NULL-filled left fields
# groups: [WindowOperators, Join, OuterJoin, NestedLoopIntensive]
# Expected output generated by: https://gist.github.com/ls-1801/0bd0883cf3154d4f78037521221bb7eb

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH FILE small/outer_join_left.csv

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH FILE small/outer_join_right.csv

CREATE SINK sink(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64, value UINT64, timestamp UINT64, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE Checksum;

# Query 1 — Large tumbling window (10 sec)
SELECT s2.window_start AS "START", s2.window_end AS "END",
       s.id, s."VALUE", s."TIMESTAMP", s2.id2, s2.value2, s2.timestamp2
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '10' SECOND)) AS s
RIGHT OUTER JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '10' SECOND)) AS s2
ON s.window_start = s2.window_start AND s.id = s2.id2
INTO sink;
----
21860 46038141

# Query 2 — Small tumbling window (1 sec)
SELECT s2.window_start AS "START", s2.window_end AS "END",
       s.id, s."VALUE", s."TIMESTAMP", s2.id2, s2.value2, s2.timestamp2
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '1' SECOND)) AS s
RIGHT OUTER JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '1' SECOND)) AS s2
ON s.window_start = s2.window_start AND s.id = s2.id2
INTO sink;
----
10241 23737614
