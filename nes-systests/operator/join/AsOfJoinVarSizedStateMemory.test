# name: join/AsOfJoinVarSizedStateMemory.test
# description: ASOF releases obsolete large VARSIZED right-side state
# groups: [Join, StreamTableJoin]

# Each ASOF memory test generates 2 MiB of right-side payloads. Systest may execute both tests concurrently on the
# same worker, so reserve 4 MiB for their bounded state, allocator chunking, and transient network buffers.
GlobalConfiguration worker.total_memory_in_bytes: [134217728]
GlobalConfiguration worker.unpooled_memory_fraction: [0.03125]
GlobalConfiguration worker.default_max_inflight_buffers: [2]

CREATE LOGICAL SOURCE events(event_id UINT64 NOT NULL, event_ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR events TYPE Generator SET(
    'ONE' AS "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    1 AS "SOURCE".SEED,
    'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
    'emit_rate 1000000' AS "SOURCE".GENERATOR_RATE_CONFIG,
    'SEQUENCE UINT64 0 32 1, SEQUENCE UINT64 0 32 1' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE LOGICAL SOURCE thermal_frames(
    thermal_id UINT64 NOT NULL,
    thermal_image VARSIZED NOT NULL,
    thermal_ts UINT64 NOT NULL
);
CREATE PHYSICAL SOURCE FOR thermal_frames TYPE Generator SET(
    'ONE' AS "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    2 AS "SOURCE".SEED,
    'SEQUENCE UINT64 0 32 1, RANDOMSTR 65536 65536, SEQUENCE UINT64 0 32 1' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE SINK result(
    event_id UINT64 NOT NULL,
    thermal_id UINT64 NOT NULL,
    thermal_size UINT64 NOT NULL
) TYPE File;

SELECT event_id, thermal_id, OCTET_LENGTH(thermal_image) AS thermal_size
FROM (
    SELECT *
    FROM (SELECT * FROM events)
    ASOF JOIN (SELECT * FROM thermal_frames)
    TIME(event_ts, thermal_ts)
)
WHERE event_id = 31
INTO result;
----
31 31 65536
