# name: join/SlidingWindowChainedOuterJoin.test
# description: Two-level chained LEFT OUTER JOIN with sliding windows — exercises combine-first trigger path twice
# groups: [WindowOperators, Join, OuterJoin, SlidingWindow, CompilationIntensive]

# Source definitions
# stream: id=1 in slice 1 (t=500), id=2 in slice 1 (t=1500), id=3 in slice 2 (t=2500)
# stream2: id2=1 in slice 2 (t=2500) — cross-slice match with stream id=1 in Join A
# stream3: id3=1 at t=500 — matches Join A output where id=1 survived on the preserved (left) side
# Join A (stream LEFT OUTER JOIN stream2 ON id=id2): id=1 matches cross-slice, id=2 and id=3 unmatched
# Join B (Join_A_output LEFT OUTER JOIN stream3 ON id=id3): id=1 matches id3=1, rest unmatched
# Without Plan 01 fix: N-squared probe calls would produce duplicate rows in both joins
CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,10,500
2,20,1500
3,30,2500

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH INLINE
1,100,2500
4,400,3500

CREATE LOGICAL SOURCE stream3(id3 UINT64 NOT NULL, value3 UINT64 NOT NULL, timestamp3 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream3 TYPE File;
ATTACH INLINE
1,1000,500

CREATE SINK sink(start UINT64 NOT NULL, end UINT64 NOT NULL, start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL, id2 UINT64, value2 UINT64, timestamp2 UINT64, id3 UINT64, value3 UINT64, timestamp3 UINT64) TYPE File;

# The inner join's window bounds are renamed to start1/end1 (via projection) so they do not collide with the outer join's start/end.
SELECT a.window_start AS "START", a.window_end AS "END",
       a.start1, a.end1, a.id, a."VALUE", a."TIMESTAMP", a.id2, a.value2, a.timestamp2, s3.id3, s3.value3, s3.timestamp3
FROM TABLE(HOP((SELECT s.window_start AS start1, s.window_end AS end1,
          s.id, s."VALUE", s."TIMESTAMP", s2.id2, s2.value2, s2.timestamp2
   FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '2' SECOND, INTERVAL '4' SECOND)) AS s
   LEFT OUTER JOIN TABLE(HOP(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '2' SECOND, INTERVAL '4' SECOND)) AS s2
   ON s.window_start = s2.window_start AND s.id = s2.id2), DESCRIPTOR("TIMESTAMP"), INTERVAL '2' SECOND, INTERVAL '4' SECOND)) AS a
LEFT OUTER JOIN TABLE(HOP(TABLE stream3, DESCRIPTOR(timestamp3), INTERVAL '2' SECOND, INTERVAL '4' SECOND)) AS s3
ON a.window_start = s3.window_start AND a.id = s3.id3
INTO sink;
----
0,4000,0,4000,1,10,500,1,100,2500,1,1000,500
0,4000,0,4000,2,20,1500,NULL,NULL,NULL,NULL,NULL,NULL
0,4000,0,4000,3,30,2500,NULL,NULL,NULL,NULL,NULL,NULL
0,4000,2000,6000,3,30,2500,NULL,NULL,NULL,NULL,NULL,NULL
2000,6000,0,4000,3,30,2500,NULL,NULL,NULL,NULL,NULL,NULL
2000,6000,2000,6000,3,30,2500,NULL,NULL,NULL,NULL,NULL,NULL
