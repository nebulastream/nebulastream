# Non-equi joins. thetaLeft and thetaRight span 60 slices of the default size, share timestamps within and across the inputs, and
# their first left and last right record match each other. A range predicate between two numeric fields is joined by the index
# nested-loop join; adding zero to a field forces the nested-loop join for the same predicate, since the index nested-loop join
# requires a plain field on both sides. Running the whole file with join_strategy=NESTED_LOOP_JOIN joins all queries with the
# nested-loop join. The expected results come from a Python oracle.
CREATE LOGICAL SOURCE thetaLeft(a UINT64 NOT NULL, x INT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR thetaLeft TYPE File;
ATTACH INLINE
