# An empty input yields no results, for the index nested-loop and the nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft WHERE a > 1000) INNER JOIN (SELECT * FROM thetaRight) ON x < y WINDOW UNBOUNDED (ts, ts2)
INTO sinkTheta;
----

SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight WHERE b > 1000) ON x + 0 < y WINDOW UNBOUNDED (ts, ts2)
INTO sinkTheta;
----

SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft WHERE a > 1000) INNER JOIN (SELECT * FROM thetaRight WHERE b > 1000) ON x >= y WINDOW UNBOUNDED (ts, ts2)
INTO sinkTheta;
----

# A range predicate over the 40 slices of leftStream and rightStream: index nested-loop join
SELECT id, value, timestamp, id2, value2, timestamp2
FROM (SELECT * FROM leftStream) INNER JOIN (SELECT * FROM rightStream) ON id < id2 WINDOW UNBOUNDED (timestamp, timestamp2)
INTO checksumJoin;
----
2017,2156288

# An unbounded window is only supported for inner joins, whatever the join predicate
SELECT * FROM (SELECT * FROM leftStream) LEFT JOIN (SELECT * FROM rightStream) ON id = id2 WINDOW UNBOUNDED (timestamp, timestamp2)
INTO sinkLeftOuter;
----
ERROR 2008

SELECT * FROM (SELECT * FROM leftStream) LEFT JOIN (SELECT * FROM rightStream) ON id < id2 WINDOW UNBOUNDED (timestamp, timestamp2)
INTO sinkLeftOuter;
----
ERROR 2008

SELECT * FROM (SELECT * FROM leftStream) RIGHT JOIN (SELECT * FROM rightStream) ON id + 0 < id2 WINDOW UNBOUNDED (timestamp, timestamp2)
INTO sinkRightOuter;
----
ERROR 2008

SELECT * FROM (SELECT * FROM leftStream) FULL JOIN (SELECT * FROM rightStream) ON id != id2 WINDOW UNBOUNDED (timestamp, timestamp2)
INTO sinkFullOuter;
----
ERROR 2008

# An unbounded window is only supported for joins
SELECT id, COUNT(value) AS cnt FROM leftStream GROUP BY id WINDOW UNBOUNDED (timestamp) INTO sinkJoin;
