CREATE SINK sinkJoin(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkFull(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkLeftOuter(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL, id2 UINT64, value2 UINT64, timestamp2 UINT64) TYPE File;

# The records span 40 slices of the default size, so the join state is compacted many times
SELECT id, value, timestamp, id2, value2, timestamp2
FROM (SELECT * FROM leftStream) INNER JOIN (SELECT * FROM rightStream) ON id = id2 WINDOW UNBOUNDED (timestamp, timestamp2)
INTO sinkJoin;
