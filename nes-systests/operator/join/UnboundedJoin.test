# x > y: index nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON x > y WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
835,875294

# x > y: nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON x + 0 > y WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
835,875294

# x >= y: index nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON x >= y WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
838,878467

# x >= y: nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON x + 0 >= y WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
838,878467

# A non-equi expression over both inputs: nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON x * 2 < y + 10 WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
61,64444

# Inequality: nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON a != b WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
794,831478

# Equality: hash join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON a = b WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
106,111932

# Equality: nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON a + 0 = b WINDOW UNBOUNDED (ts, ts2)
INTO checksumTheta;
----
106,111932

# Equality and a range residual: nested-loop join
SELECT a, x, ts, b, y, ts2 FROM (SELECT * FROM thetaLeft) INNER JOIN (SELECT * FROM thetaRight) ON a = b AND x <= y WINDOW UNBOUNDED (ts, ts2)
INTO sinkTheta;
