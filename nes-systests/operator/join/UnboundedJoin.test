# name: join/UnboundedJoin.test
# description: An inner join with an UNBOUNDED window joins every record with every matching record of the other input exactly once,
# however far apart their timestamps are
# groups: [WindowOperators, Join]

CREATE LOGICAL SOURCE leftStream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR leftStream TYPE File;
ATTACH INLINE
