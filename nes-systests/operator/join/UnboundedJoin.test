CREATE SINK sinkTheta(a UINT64 NOT NULL, x INT64 NOT NULL, ts UINT64 NOT NULL, b UINT64 NOT NULL, y INT64 NOT NULL, ts2 UINT64 NOT NULL) TYPE File;
CREATE SINK checksumTheta(a UINT64 NOT NULL, x INT64 NOT NULL, ts UINT64 NOT NULL, b UINT64 NOT NULL, y INT64 NOT NULL, ts2 UINT64 NOT NULL) TYPE Checksum;
CREATE SINK checksumJoin(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE Checksum;

