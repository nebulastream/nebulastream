# Query 2 - (id > id2) then (id > id4), tumbling 1 sec
# Tests: reversed direction: stream.id must exceed both joined stream ids — tests that the engine correctly handles the > operator and does not conflate it with <
SELECT c.start1, c.end1, c.window_start AS "START", c.window_end AS "END", c.id, c."VALUE", c.timestamp1, c.id2, c.value2, c.timestamp2, d.id4, d.value4, d.timestamp4
FROM TABLE(TUMBLE((SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1, b.id2, b.value2, b.timestamp2
  FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS a
  JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '1' SECOND)) AS b
  ON a.window_start = b.window_start AND a.id > b.id2), DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS c
JOIN TABLE(TUMBLE(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '1' SECOND)) AS d
ON c.window_start = d.window_start AND c.id > d.id4
INTO sinkGt;
----
1000 2000 1000 2000 12 1 1001 4 3 1102 4 4 1001
1000 2000 1000 2000 12 1 1001 4 3 1112 4 4 1001

# Query 3 - (id <= id2) then (id <= id4), tumbling 1 sec
# Tests: <= includes equal-value id pairs that < would exclude — verifies the boundary case at equality
SELECT c.start1, c.end1, c.window_start AS "START", c.window_end AS "END", c.id, c."VALUE", c.timestamp1, c.id2, c.value2, c.timestamp2, d.id4, d.value4, d.timestamp4
FROM TABLE(TUMBLE((SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1, b.id2, b.value2, b.timestamp2
  FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS a
  JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '1' SECOND)) AS b
  ON a.window_start = b.window_start AND a.id <= b.id2), DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS c
JOIN TABLE(TUMBLE(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '1' SECOND)) AS d
ON c.window_start = d.window_start AND c.id <= d.id4
INTO sinkLe;
----
