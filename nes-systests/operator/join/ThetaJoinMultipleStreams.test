# name: theta_join/ThetaJoinMultipleStreams.test
# description: Join chained across three streams with all five comparison operators, tumbling and sliding windows
# groups: [WindowOperators, Join, CompilationIntensive]

# Source definitions
CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH FILE small/stream.csv

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH FILE small/stream2.csv

CREATE LOGICAL SOURCE stream4(id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream4 TYPE File;
ATTACH FILE small/stream4.csv

CREATE SINK sinkLt(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkGt(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkLe(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkGe(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkLtSliding(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL) TYPE File;
CREATE SINK sinkLtTumbling2s(start1 UINT64 NOT NULL, end1 UINT64 NOT NULL, start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp1 UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, id4 UINT64 NOT NULL, value4 UINT64 NOT NULL, timestamp4 UINT64 NOT NULL) TYPE File;

# Query 1 - (id < id2) then (id < id4), tumbling 1 sec
# Tests: stream.id must be strictly smaller than both joined stream ids — the most selective of the ordered operators
SELECT c.start1, c.end1, c.window_start AS "START", c.window_end AS "END", c.id, c."VALUE", c.timestamp1, c.id2, c.value2, c.timestamp2, d.id4, d.value4, d.timestamp4
FROM TABLE(TUMBLE((SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1, b.id2, b.value2, b.timestamp2
  FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS a
  JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '1' SECOND)) AS b
  ON a.window_start = b.window_start AND a.id < b.id2), DESCRIPTOR(timestamp1), INTERVAL '1' SECOND)) AS c
JOIN TABLE(TUMBLE(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '1' SECOND)) AS d
ON c.window_start = d.window_start AND c.id < d.id4
INTO sinkLt;
----
1000 2000 1000 2000 1 1 1000 21 1 1003 4 4 1001
1000 2000 1000 2000 1 1 1000 21 1 1003 12 1 1300
1000 2000 1000 2000 1 1 1000 12 5 1011 4 4 1001
1000 2000 1000 2000 1 1 1000 12 5 1011 12 1 1300
1000 2000 1000 2000 1 1 1000 4 3 1102 4 4 1001
