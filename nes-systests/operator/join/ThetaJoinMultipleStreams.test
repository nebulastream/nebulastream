# Query 5 - (id < id2) then (id < id4), sliding 1 sec advance 500 ms
# Tests: three-stream chained join with a sliding window — the same triple appears once per overlapping window
SELECT c.start1, c.end1, c.window_start AS "START", c.window_end AS "END", c.id, c."VALUE", c.timestamp1, c.id2, c.value2, c.timestamp2, d.id4, d.value4, d.timestamp4
FROM TABLE(HOP((SELECT a.window_start AS start1, a.window_end AS end1, a.id, a."VALUE", a.timestamp1, b.id2, b.value2, b.timestamp2
  FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS a
  JOIN TABLE(HOP(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS b
  ON a.window_start = b.window_start AND a.id < b.id2), DESCRIPTOR(timestamp1), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS c
JOIN TABLE(HOP(TABLE stream4, DESCRIPTOR(timestamp4), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND)) AS d
ON c.window_start = d.window_start AND c.id < d.id4
INTO sinkLtSliding;
