0,1000,1,2,3,4,5,6,7,8,9.0,10.0,100,10,10,10,10,10,10,10,10,10.0,10.0,509

# Calcite compares a VARSIZED with an INT64 as CAST(strKey AS BIGINT) = intKey: the strings here are no numbers, so the cast fails.
SELECT l.window_start AS "START", l.window_end AS "END",
       l.intKey, l.ts1, r.strKey, r.ts2
FROM TABLE(TUMBLE(TABLE stream3, DESCRIPTOR(ts1), INTERVAL '1' SECOND)) AS l
JOIN TABLE(TUMBLE(TABLE stream4, DESCRIPTOR(ts2), INTERVAL '1' SECOND)) AS r
ON l.window_start = r.window_start AND intKey = strKey
INTO sinkStream3Stream4;
----
ERROR 4003
