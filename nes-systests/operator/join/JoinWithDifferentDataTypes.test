SELECT l.window_start AS "START", l.window_end AS "END",
       l.i8_s1, l.i16_s1, l.i32_s1, l.i64_s1, l.u8_s1, l.u16_s1, l.u32_s1, l.u64_s1, l.f32_s1, l.f64_s1, l.ts1, r.i8_s2, r.i16_s2, r.i32_s2, r.i64_s2, r.u8_s2, r.u16_s2, r.u32_s2, r.u64_s2, r.f32_s2, r.f64_s2, r.ts2
