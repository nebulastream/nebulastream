# name: operator/window/SessionWindow.test
# description: GROUP BY ... WINDOW SESSION(ts, GAP g) groups the records of each key into sessions. A session continues while
#              its records are at most the gap apart (as in Flink, a record exactly at the session end continues it) and ends at
#              its last record plus the gap; it emits one row with start = first record and end = last record + gap. Sessions
#              still open at the end of the stream are emitted then.
# groups: [Aggregation, Windowing]

CREATE LOGICAL SOURCE stream(k UINT64 NOT NULL, v UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,100
2,10,200
1,2,500
1,3,1400
1,4,2400
1,5,3401
2,20,5000
3,1,6000
3,1,6500
1,6,7000
3,1,7000
3,1,7500
3,1,8000
3,1,8500
3,1,9000

CREATE SINK keyedSink(start UINT64 NOT NULL, end UINT64 NOT NULL, k UINT64 NOT NULL, cnt UINT64 NOT NULL, total UINT64 NOT NULL) TYPE File;
CREATE SINK multiSink(start UINT64 NOT NULL, end UINT64 NOT NULL, k UINT64 NOT NULL, cnt UINT64 NOT NULL, total UINT64 NOT NULL, minV UINT64 NOT NULL, maxV UINT64 NOT NULL) TYPE File;
CREATE SINK unkeyedSink(start UINT64 NOT NULL, end UINT64 NOT NULL, cnt UINT64 NOT NULL, total UINT64 NOT NULL) TYPE File;

# Key 1: 1400 -> 2400 is exactly the gap apart, which continues the session; 2400 -> 3401 is 1 ms more and starts a new one.
# Key 3 bids every 500 ms from 6 s to 9 s: one session over several slices, closed by the end of the stream.
SELECT start, end, k, COUNT(v) AS cnt, SUM(v) AS total FROM stream GROUP BY k WINDOW SESSION(ts, GAP 1 SEC) INTO keyedSink;
----
100,3400,1,4,10
3401,4401,1,1,5
7000,8000,1,1,6
200,1200,2,1,10
5000,6000,2,1,20
6000,10000,3,7,7

# The gap in another unit.
SELECT start, end, k, COUNT(v) AS cnt, SUM(v) AS total FROM stream GROUP BY k WINDOW SESSION(ts, GAP 1000 MS) INTO keyedSink;
----
100,3400,1,4,10
3401,4401,1,1,5
7000,8000,1,1,6
200,1200,2,1,10
5000,6000,2,1,20
6000,10000,3,7,7

# Several aggregates per session.
SELECT start, end, k, COUNT(*) AS cnt, SUM(v) AS total, MIN(v) AS minV, MAX(v) AS maxV
FROM stream GROUP BY k WINDOW SESSION(ts, GAP 1 SEC) INTO multiSink;
----
100,3400,1,4,10,1,4
3401,4401,1,1,5,5,5
7000,8000,1,1,6,6,6
200,1200,2,1,10,10,10
5000,6000,2,1,20,20,20
6000,10000,3,7,7,1,1

# Without a key, all records form the sessions. 5000 -> 6000 is exactly the gap apart and joins the records of keys 2 and 3.
SELECT start, end, COUNT(v) AS cnt, SUM(v) AS total FROM stream WINDOW SESSION(ts, GAP 1 SEC) INTO unkeyedSink;
----
100,3400,5,20
3401,4401,1,5
5000,10000,9,33

# With a gap of 2 s, every record continues the session of the one before.
SELECT start, end, COUNT(v) AS cnt, SUM(v) AS total FROM stream WINDOW SESSION(ts, GAP 2 SEC) INTO unkeyedSink;
----
100,11000,15,58

# The session bounds can be renamed in an enclosing query, like the bounds of any window.
SELECT k, cnt, start AS sessionStart, end AS sessionEnd
FROM (SELECT start, end, k, COUNT(v) AS cnt FROM stream GROUP BY k WINDOW SESSION(ts, GAP 1 SEC))
WHERE cnt > 1 INTO FILE ();
----
1,4,100,3400
3,7,6000,10000

# Records that arrive out of order, but not behind the watermark, still merge: 0 and 1500 are more than the gap apart, and 700,
# which arrives after 1500, bridges them into one session.
CREATE LOGICAL SOURCE bridge(k UINT64 NOT NULL, v UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR bridge TYPE File;
ATTACH INLINE
1,1,0
1,2,1500
1,4,700
2,8,1600

SELECT start, end, k, COUNT(v) AS cnt, SUM(v) AS total FROM bridge GROUP BY k WINDOW SESSION(ts, GAP 1 SEC) INTO keyedSink;
----
0,2500,1,3,7
1600,2600,2,1,8

# Records on the slice boundaries, which are multiples of the gap: the session of 1000 ends at 2000, exactly when the next slice
# starts, and the record at 2000 continues it, as does the one at 3000. Key 2 shows the same for two records a slice apart.
CREATE LOGICAL SOURCE edges(k UINT64 NOT NULL, v UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR edges TYPE File;
ATTACH INLINE
1,1,1000
1,1,2000
2,1,2000
1,1,3000
2,1,3000
2,1,4001

SELECT start, end, k, COUNT(v) AS cnt, SUM(v) AS total FROM edges GROUP BY k WINDOW SESSION(ts, GAP 1 SEC) INTO keyedSink;
----
1000,4000,1,3,3
2000,4000,2,2,2
4001,5001,2,1,1

# A session window needs a positive gap.
SELECT start, end, k, COUNT(v) AS cnt, SUM(v) AS total FROM stream GROUP BY k WINDOW SESSION(ts, GAP 0 SEC) INTO keyedSink;
----
ERROR 2000

# Session windows are only supported for aggregations.
SELECT * FROM (SELECT k AS k1, ts AS ts1 FROM stream) INNER JOIN (SELECT k AS k2, ts AS ts2 FROM bridge) ON k1 = k2
WINDOW SESSION(ts1, ts2, GAP 1 SEC) INTO FILE ();
----
ERROR 2008

SELECT k, v, ts FROM stream ORDER BY v DESC LIMIT 1 BY k WINDOW SESSION(ts, GAP 1 SEC) INTO FILE ();
----
ERROR 2008
