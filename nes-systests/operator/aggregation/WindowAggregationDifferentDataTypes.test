       SUM(i64) AS i64_out, SUM(CAST(u8 AS BIGINT UNSIGNED)) AS u8_out, SUM(CAST(u16 AS BIGINT UNSIGNED)) AS u16_out, SUM(CAST(u32 AS BIGINT UNSIGNED)) AS u32_out, SUM(u64) AS u64_out,
