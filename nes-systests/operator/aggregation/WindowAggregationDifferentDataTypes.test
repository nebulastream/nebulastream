       AVG(CAST(u64 AS DOUBLE)) AS u64_out, AVG(CAST(f32 AS DOUBLE)) AS f32_out,
       AVG(CAST(f64 AS DOUBLE)) AS f64_out
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.05' SECOND, INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkStreamAllF64;
