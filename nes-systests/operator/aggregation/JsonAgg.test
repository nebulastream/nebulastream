# name: aggregation/JsonAgg.test
# description: JSON_AGG(field) over a VARSIZED field in a window: one VARSIZED JSON array of the strings, escaped,
#              in the order the window holds them. One worker thread, so the order is the input order.
# groups: [Aggregation, WindowOperators]
GlobalConfiguration worker.query_engine.number_of_worker_threads: [1]

CREATE LOGICAL SOURCE words(id UINT64 NOT NULL, grp VARSIZED NOT NULL, word VARSIZED NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR words TYPE File;
ATTACH INLINE
1,a,apple,100
2,b,banana,200
3,a,cherry,300
4,a,,400
5,b,date,1100
6,a,say "hi",1200
7,b,C:\dir\file,1300
8,a,Grüße 😀,1400

CREATE LOGICAL SOURCE many(id UINT64 NOT NULL, word VARSIZED NOT NULL, ts UINT64 NOT NULL);
