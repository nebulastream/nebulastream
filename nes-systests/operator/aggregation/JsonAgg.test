CREATE LOGICAL SOURCE maybe(id UINT64 NOT NULL, word VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR maybe TYPE File;
ATTACH INLINE
1,a,100

CREATE LOGICAL SOURCE numbers(id UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR numbers TYPE File;
ATTACH INLINE
1,100

# Query 1: a tumbling window without GROUP BY; an empty string is an empty JSON string.
SELECT start, end, JSON_AGG(word) AS words FROM words WINDOW TUMBLING(ts, size 1 sec) INTO FILE ();
----
0,1000,["apple","banana","cherry",""]
1000,2000,["date","say \"hi\"","C:\\dir\\file","Grüße 😀"]

# Query 2: per group, next to other aggregations.
SELECT start, end, grp, JSON_AGG(word) AS words, COUNT(id) AS n FROM words GROUP BY grp WINDOW TUMBLING(ts, size 1 sec) INTO FILE ();
----
0,1000,a,["apple","cherry",""],3
0,1000,b,["banana"],1
1000,2000,a,["say \"hi\"","Grüße 😀"],2
1000,2000,b,["date","C:\\dir\\file"],2

# Query 3: a large window, 3000 values across many buffers and pages.
SELECT start, end, JSON_AGG(word) AS words, COUNT(id) AS n FROM many WINDOW TUMBLING(ts, size 1 sec) INTO FILE ();
