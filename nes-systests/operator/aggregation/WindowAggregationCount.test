# name: window/WindowAggregationCount.test
# description: Test COUNT(*) vs COUNT(column_name) with null value handling
# groups: [Aggregation, WindowOperators, NullHandling]


CREATE LOGICAL SOURCE stream(value INT32, ts UINT64 NOT NULL, id INT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
10,10,1
30,20,2
,60,1
40,110,2
50,160,1
,210,2


CREATE SINK sinkCountStar(start UINT64 NOT NULL, end UINT64 NOT NULL, rowCount INT64 NOT NULL) TYPE File;
CREATE SINK sinkCountBoth(start UINT64 NOT NULL, end UINT64 NOT NULL, rowCount INT64 NOT NULL, valueCount INT64 NOT NULL) TYPE File;
CREATE SINK sinkCountStarKeyed(start UINT64 NOT NULL, end UINT64 NOT NULL, id INT32 NOT NULL, rowCount INT64 NOT NULL) TYPE File;
CREATE SINK sinkCountBothKeyed(start UINT64 NOT NULL, end UINT64 NOT NULL, id INT32 NOT NULL, rowCount INT64 NOT NULL, valueCount INT64 NOT NULL) TYPE File;


# COUNT(*) counts all rows including those with null values - tumbling window
SELECT window_start AS "START", window_end AS "END", COUNT(*) AS rowCount
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkCountStar;
----
0,100,3
100,200,2
200,300,1


# COUNT(*) vs COUNT(column_name) - tumbling window
# COUNT(*) includes rows with null value, COUNT(value) does not
SELECT window_start AS "START", window_end AS "END", COUNT(*) AS rowCount, COUNT("VALUE") AS valueCount
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkCountBoth;
----
0,100,3,2
100,200,2,2
200,300,1,0


# COUNT(*) with keyed tumbling window
SELECT window_start AS "START", window_end AS "END", id, COUNT(*) AS rowCount
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end, id
INTO sinkCountStarKeyed;
----
0,100,1,2
0,100,2,1
100,200,2,1
100,200,1,1
200,300,2,1


# COUNT(*) vs COUNT(column_name) with keyed tumbling window
SELECT window_start AS "START", window_end AS "END", id, COUNT(*) AS rowCount, COUNT("VALUE") AS valueCount
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end, id
INTO sinkCountBothKeyed;
----
0,100,1,2,1
0,100,2,1,1
100,200,2,1,1
100,200,1,1,1
200,300,2,1,0


# COUNT(*) vs COUNT(column_name) - sliding window
SELECT window_start AS "START", window_end AS "END", COUNT(*) AS rowCount, COUNT("VALUE") AS valueCount
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.05' SECOND, INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkCountBoth;
----
0,100,3,2
50,150,2,1
100,200,2,2
150,250,2,1
200,300,1,0


# COUNT(*) vs COUNT(column_name) with keyed sliding window
SELECT window_start AS "START", window_end AS "END", id, COUNT(*) AS rowCount, COUNT("VALUE") AS valueCount
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.05' SECOND, INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end, id
INTO sinkCountBothKeyed;
----
0,100,1,2,1
0,100,2,1,1
50,150,1,1,0
50,150,2,1,1
100,200,2,1,1
100,200,1,1,1
150,250,1,1,1
150,250,2,1,0
200,300,2,1,0


# COUNT(1) should be accepted and should count rows like COUNT(*).
SELECT window_start AS "START", window_end AS "END", COUNT(1) AS rowCount
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkCountStar;
----
0,100,3
100,200,2
200,300,1
