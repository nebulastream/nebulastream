# name: window/WindowAggregationDifferentDataTypes.test
# description: Test window aggregations over different data types
# groups: [Aggregation, WindowOperators, CompilationIntensive] TODO #1272
GlobalConfiguration worker.query_engine.number_of_worker_threads: [1]

CREATE LOGICAL SOURCE stream1(i8 INT8 NOT NULL,  ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream1 TYPE File;
ATTACH INLINE
1,100
2,150
0,250

CREATE LOGICAL SOURCE stream2(i8 INT8,  ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH INLINE
,100
2,150
0,250

SELECT window_start AS "START", window_end AS "END", MEDIAN(i8) AS i8_out
FROM TABLE(HOP(TABLE stream1, DESCRIPTOR(ts), INTERVAL '0.1' SECOND, INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO FILE ();
----
100,200,1.5
200,300,0

SELECT window_start AS "START", window_end AS "END", MEDIAN(i8) AS i8_med_out, COUNT(i8) AS i8_out, COUNT(*) AS i8_star_out
FROM TABLE(HOP(TABLE stream2, DESCRIPTOR(ts), INTERVAL '0.1' SECOND, INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO FILE ();
----
100,200,2,1,2
200,300,0,1,1
