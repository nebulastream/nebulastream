# name: operator/aggregation/ColumnName.test
# description: Tests automatic name creation of aggregation function
# groups: [Aggregation]


CREATE LOGICAL SOURCE input(i UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR input TYPE File;
ATTACH INLINE
1,100
2,125
1,200
2,225
1,300
2,325


CREATE SINK out(start UINT64 NOT NULL, end UINT64 NOT NULL, i_count INT64 NOT NULL, i_min UINT64, i_max UINT64, i_sum UINT64, i_avg FLOAT64, i_median FLOAT64 NOT NULL) TYPE File;
CREATE SINK sinkAggResult(result FLOAT64) TYPE File;
CREATE SINK sinkMedianResult(result FLOAT64 NOT NULL) TYPE File;
CREATE SINK sinkMedian(i_median FLOAT64 NOT NULL) TYPE File;
CREATE SINK sinkDupAlias(ID UINT64 NOT NULL) TYPE File;
CREATE SINK sinkExprAgg(start UINT64 NOT NULL, end UINT64 NOT NULL, out FLOAT64 NOT NULL) TYPE File;
CREATE SINK sinkExprAggFloat(out FLOAT64) TYPE File;
CREATE SINK sinkExprAggUint(out UINT64) TYPE File;

# All aggregation functions. Calcite names unaliased aggregates EXPR$n, so the sink's column names are given as aliases.
SELECT window_start AS "START", window_end AS "END", COUNT(i) AS i_count, MIN(i) AS i_min, MAX(i) AS i_max, SUM(i) AS i_sum,
       AVG(CAST(i AS DOUBLE)) AS i_avg, MEDIAN(i) AS i_median
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO out;
----
100, 200, 2,1,2,3,1.5,1.5
200, 300, 2,1,2,3,1.5,1.5
300, 400, 2,1,2,3,1.5,1.5

# Post-aggregation arithmetic: MEDIAN(i) + 1.
# MEDIAN({1,2}) = 1.5, plus 1 = 2.5.
SELECT MEDIAN(i) + 1 AS "RESULT"
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkMedianResult;
----
2.5
2.5
2.5

# Post-aggregation arithmetic: SUM(i) + 10.0.
# SUM({1,2}) = 3, plus 10 = 13.
SELECT SUM(i) + 10.0E0 AS "RESULT"
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkAggResult;
----
13
13
13

# Single MEDIAN aggregation with explicit alias.
# MEDIAN({1,2}) per window = 1.5.
SELECT MEDIAN(i) AS i_median
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkMedian;
----
1.5
1.5
1.5

# Expression inside aggregation: MEDIAN(i + 1).
# i + 1 yields {2, 3} per window, MEDIAN = 2.5.
SELECT window_start AS "START", window_end AS "END", MEDIAN(i + 1) AS "OUT"
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkExprAgg;
----
100, 200, 2.5
200, 300, 2.5
300, 400, 2.5

# Expression inside aggregation: AVG(i + 1).
# i + 1 yields {2, 3} per window, AVG = 2.5.
SELECT AVG(CAST(i + 1 AS DOUBLE)) AS "OUT"
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkExprAggFloat;
----
2.5
2.5
2.5

# Expression inside aggregation: SUM(i * 2).
# i * 2 yields {2, 4} per window, SUM = 6.
SELECT SUM(i * 2) AS "OUT"
FROM TABLE(TUMBLE(TABLE input, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sinkExprAggUint;
----
6
6
6

# Duplicate explicit aliases (SELECT i AS ID, timestamp AS ID) must give a clear error.
SELECT i AS ID, "TIMESTAMP" AS ID FROM input INTO sinkDupAlias;
----
ERROR 2003

# Duplicate explicit aliases with arithmetic (SELECT i + 1 AS ID, timestamp AS ID) must give a clear error.
SELECT i + 1 AS ID, "TIMESTAMP" AS ID FROM input INTO sinkDupAlias;
----
ERROR 2003
