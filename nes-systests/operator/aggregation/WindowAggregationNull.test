# name: window/WindowAggregationNull.test
# description: Test window aggregation with null values
# groups: [Aggregation, WindowOperators, NullHandling]

# Source definitions
CREATE LOGICAL SOURCE stream(ts UINT64 NOT NULL, id INT32 NOT NULL, value INT32);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
0,0,0
20,1,3
50,0,1
100,0,2
150,1,
200,0,10
350,2,4
350,0,2
350,1,1
350,0,2
500,2,-1
520,0,11
530,0,

CREATE LOGICAL SOURCE stream2(ts UINT64 NOT NULL, id INT32, value INT32);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH INLINE
0,,
10,,1
20,1,2
30,1,3
40,3,
50,3,
1100,,
1110,,4
1120,1,5
1130,1,
1140,3,

CREATE LOGICAL SOURCE stream3(id UINT64 NOT NULL, value UINT64, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream3 TYPE File;
ATTACH INLINE
1,,2004
1,,3000

CREATE LOGICAL SOURCE stream4(ts UINT64 NOT NULL, value INT32);
CREATE PHYSICAL SOURCE FOR stream4 TYPE File;
ATTACH INLINE
0,
250,
500,
750,
1000,23
1250,24
1500,1
1750,

CREATE SINK sink0(start UINT64 NOT NULL, end UINT64 NOT NULL, valueSum INT64) TYPE File;
CREATE SINK sink1(start UINT64 NOT NULL, end UINT64 NOT NULL, valueSum INT64, valueMax INT32, valueMin INT32, valueAvg FLOAT64, valueMedian FLOAT64) TYPE File;
CREATE SINK sink2(start UINT64 NOT NULL, end UINT64 NOT NULL, id INT32, valueSum INT64, valueMin INT32, valueMax INT32, valueAvg FLOAT64, valueCount INT64 NOT NULL, rowCount INT64 NOT NULL) TYPE File;


# Checking if a sum over a tumbling window works with null values in the value field
# We expect NULLs to be ignored in value fields for SUM aggregation (SQL standard: NULL only when every input is NULL)
SELECT window_start AS "START", window_end AS "END", SUM("VALUE") AS valueSum
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sink0;
----
0,100,4
100,200,2
200,300,10
300,400,9
500,600,10


# Checking if all aggregation function over a sliding window works with null values in the value field
SELECT window_start AS "START", window_end AS "END", SUM("VALUE") AS valueSum, MAX("VALUE") AS valueMax,
       MIN("VALUE") AS valueMin, AVG(CAST("VALUE" AS DOUBLE)) AS valueAvg, MEDIAN("VALUE") AS valueMedian
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR(ts), INTERVAL '0.05' SECOND, INTERVAL '0.1' SECOND))
GROUP BY window_start, window_end
INTO sink1;
----
0,100,4,3,0,1.333333,1
50,150,3,2,1,1.5,1.5
100,200,2,2,2,2.0,2.0
150,250,10,10,10,10.0,10.0
200,300,10,10,10,10.0,10.0
300,400,9,4,1,2.25,2.0
350,450,9,4,1,2.25,2.0
450,550,10,11,-1,5.0,5.0
500,600,10,11,-1,5.0,5.0


# Keyed aggregation with only null values in the key
SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS valueSum, MIN("VALUE") AS valueMin,
       MAX("VALUE") AS valueMax, AVG(CAST("VALUE" AS DOUBLE)) AS valueAvg, COUNT("VALUE") AS valueCount,
       COUNT(ts) AS rowCount
FROM TABLE(TUMBLE((SELECT * FROM stream2 WHERE id IS NULL), DESCRIPTOR(ts), INTERVAL '1' SECOND))
GROUP BY window_start, window_end, id
INTO sink2;
----
0,1000,NULL,1,1,1,1.0,1,2
1000,2000,NULL,4,4,4,4.0,1,2

# Keyed aggregation with and w/o null values in the key
SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS valueSum, MIN("VALUE") AS valueMin,
       MAX("VALUE") AS valueMax, AVG(CAST("VALUE" AS DOUBLE)) AS valueAvg, COUNT("VALUE") AS valueCount,
       COUNT(ts) AS rowCount
FROM TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(ts), INTERVAL '1' SECOND))
GROUP BY window_start, window_end, id
INTO sink2;
----
0,1000,NULL,1,1,1,1.0,1,2
0,1000,1,5,2,3,2.5,2,2
0,1000,3,NULL,NULL,NULL,NULL,0,2
1000,2000,NULL,4,4,4,4.0,1,2
1000,2000,1,5,5,5,5.0,1,2
1000,2000,3,NULL,NULL,NULL,NULL,0,1

SELECT window_start AS "START", window_end AS "END", MAX("VALUE"), MIN("VALUE"), AVG(CAST("VALUE" AS DOUBLE)),
       MEDIAN("VALUE")
FROM TABLE(TUMBLE(TABLE stream3, DESCRIPTOR("TIMESTAMP"), INTERVAL '1' SECOND))
GROUP BY window_start, window_end
INTO File();
----
2000,3000,NULL,NULL,NULL,NULL
3000,4000,NULL,NULL,NULL,NULL


SELECT window_start AS "START", window_end AS "END", SUM("VALUE") AS valueSum, MIN("VALUE") AS valueMin,
       MAX("VALUE") AS valueMax, AVG(CAST("VALUE" AS DOUBLE)) AS valueAvg, MEDIAN("VALUE") AS valueMedian,
       COUNT("VALUE") AS valueCount, COUNT(*) AS countStarCount
FROM TABLE(TUMBLE(TABLE stream4, DESCRIPTOR(ts), INTERVAL '1' SECOND))
GROUP BY window_start, window_end
INTO File();
----
0,1000,NULL,NULL,NULL,NULL,NULL,0,4
1000,2000,48,1,24,16,23,3,4
