# name: operator/aggregation/ArrayAggGeneratedOrdering.test
# description: Exact byte ordering of 10,000 UINT8 values per window across many generated event-time windows
# groups: [Aggregation, WindowOperators, Generator]
# Expected payloads encode bytes(eventId % 256) for each event in the half-open window [start, end).
# 250000 events, one every 5 ms; value is eventId % 256 (0..255, repeated).
# Native UINT8 SEQUENCE fields saturate, so derive a cycling UINT8 column from a UINT64 counter.
# Each full window contains 10000 bytes and spans many input buffers and aggregate pages.
# Sliding advances by 2500 events to exercise overlapping slices and varying byte prefixes.
# Compare entire Base64 payloads and window boundaries, including partial windows at end of input.
# Output-row arrival order is irrelevant; byte order inside every vector is checked exactly.

GlobalConfiguration worker.query_engine.number_of_worker_threads: [1, 4]
GlobalConfiguration worker.default_query_execution.operator_buffer_size: [1024]

CREATE LOGICAL SOURCE generatedEvents(eventId UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR generatedEvents TYPE Generator SET(
    'ALL' AS "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    'FIXED' AS "SOURCE".GENERATOR_RATE_TYPE,
    'emit_rate 100000000' AS "SOURCE".GENERATOR_RATE_CONFIG,
    1 AS "SOURCE".SEED,
    'SEQUENCE UINT64 0 250000 1, SEQUENCE UINT64 0 1250000 5' AS "SOURCE".GENERATOR_SCHEMA
);

CREATE SINK vectors(
    start UINT64 NOT NULL,
    end UINT64 NOT NULL,
    vector VARSIZED NOT NULL
) TYPE File;

# 25 tumbling windows, each containing exactly 10000 bytes.
SELECT start, end, TO_BASE64(ARRAY_AGG(value)) AS vector
FROM (
    SELECT ts, CASTTOTYPE(eventId % UINT64(256) AS UINT8) AS value
    FROM generatedEvents
)
WINDOW TUMBLING(ts, SIZE 50000 MS)
INTO vectors;
----
0,50000,
50000,100000,
100000,150000,
150000,200000,
200000,250000,
250000,300000,
300000,350000,
350000,400000,
400000,450000,
450000,500000,
500000,550000,
550000,600000,
600000,650000,
650000,700000,
700000,750000,
750000,800000,
800000,850000,
850000,900000,
900000,950000,
950000,1000000,
1000000,1050000,
1050000,1100000,
1100000,1150000,
1150000,1200000,
1200000,1250000,

# 100 sliding windows, including partial tail windows at end of input.
SELECT start, end, TO_BASE64(ARRAY_AGG(value)) AS vector
FROM (
    SELECT ts, CASTTOTYPE(eventId % UINT64(256) AS UINT8) AS value
    FROM generatedEvents
)
WINDOW SLIDING(ts, SIZE 50000 MS, ADVANCE BY 12500 MS)
INTO vectors;
