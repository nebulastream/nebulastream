# name: sinks/AnonymousSink.test
# description: Creating anonymous sinks within queries
# groups: [Sinks]

SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO FileSink();
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56

SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO FileSink(SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SINK"."SCHEMA");
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56


SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO ChecksumSink();
----
5 1505

CREATE SINK output_file(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE FileSink;

SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO output_file;
====
SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO FileSink();



CREATE SINK output_checksum(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE ChecksumSink;

SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO output_checksum;
====
SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO ChecksumSink();


# The sink type is looked up as written, so "File" does not resolve to the registered "FileSink" sink and the
# query must be rejected with an error instead of being silently accepted.
SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS FILE_SOURCE.FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO File();
----
ERROR 2016
