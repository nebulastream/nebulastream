# name: sinks/VoidSink.test
# description: Void sink discards all tuples; no result file is produced and the systest harness must skip the output check.
# groups: [Sinks]

SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS "FILE_SOURCE".FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO VoidSink();
----

CREATE SINK discard(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE VoidSink;

SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS "FILE_SOURCE".FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO discard;
----

# The output format is configurable, so that a query can run the formatting step without any I/O.
SELECT ID, VALUE, TIMESTAMP
FROM FileSource(
	'small/stream8.csv' AS "FILE_SOURCE".FILE_PATH,
	'CSV' AS INPUT_FORMATTER."TYPE",
	SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS "SOURCE"."SCHEMA")
INTO VoidSink('CSV' AS "OUTPUT_FORMATTER"."TYPE");
----
