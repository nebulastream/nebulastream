# name: sinks/MultiSinkLinearTopology.test
# description: A forking plan laid over a line of nodes. The sinks sit on the second and third worker of
# source-node -> sink-node-1 -> sink-node-2, so the plan forks on the source node while the branch of the far sink
# has to run through the node holding the near one.
#
# MultiSinkDistinctSinkNodes.test reaches both sinks in one hop, so neither the relay nor the two-hop path shows
# up there. The first query below asserts the decomposition, so that a routing change collapsing the relay fails
# here rather than leaving the result checks to pass over coverage that is no longer there.
# groups: [Distributed]

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56

CREATE SINK sinkOnNode1(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File SET ('sink-node-1:8080' AS "SINK"."HOST");
CREATE SINK sinkOnNode2(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File SET ('sink-node-2:8080' AS "SINK"."HOST");
CREATE SINK reorderedOnNode2(value UINT64 NOT NULL, id UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File SET ('sink-node-2:8080' AS "SINK"."HOST");

# The middle worker carries two plans at once, one ending in a sink of the query and one relaying the other branch
# onward, so the far sink is two hops from the operator it shares.
EXPLAIN (DISTRIBUTED) FORMAT TEXT SELECT id, value, timestamp FROM stream WHERE value > 3 INTO sinkOnNode1, sinkOnNode2;
----
== Decomposed Plans ==
-- 2 plan(s) on sink-node-1:8080 --
0:
SINK(SINKONNODE1)
  SOURCE(NETWORK)
1:
SINK(NETWORK)
  SOURCE(NETWORK)
-- 1 plan(s) on sink-node-2:8080 --
0:
SINK(SINKONNODE2)
  SOURCE(NETWORK)
-- 1 plan(s) on source-node:8080 --
0:
SINK(NETWORK)
  PROJECTION(fields: [*])
    SELECTION(VALUE > 3)
      SOURCE(STREAM)
SINK(NETWORK)
  PROJECTION(fields: [*])
    SELECTION(VALUE > 3) [shared]
==END==

# The near sink consumes its branch where the far sink's branch is only passing through.
SELECT id, value, timestamp FROM stream WHERE value > 3 INTO sinkOnNode1, sinkOnNode2;
----
1,4,45
1,5,56
----
1,4,45
1,5,56

# The same, with the relayed branch carrying a different field order than the one consumed on the way.
SELECT id, value, timestamp FROM stream WHERE value > 3 INTO sinkOnNode1, reorderedOnNode2;
----
1,4,45
1,5,56
----
4,1,45
5,1,56
