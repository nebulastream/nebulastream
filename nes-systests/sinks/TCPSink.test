# name: sinks/TCPSink.test
# description: TCP sink writes query output to a harness-owned TCP receiver
# groups: [Sinks, TCP]

SELECT ID, VALUE, TIMESTAMP
FROM File(
    'small/stream8.csv' AS `SOURCE`.FILE_PATH,
    'CSV' AS PARSER.`TYPE`,
    SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS `SOURCE`.`SCHEMA`)
INTO TCP();
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56

CREATE SINK tcp_output(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE TCP;

SELECT ID, VALUE, TIMESTAMP
FROM File(
    'small/stream8.csv' AS `SOURCE`.FILE_PATH,
    'CSV' AS PARSER.`TYPE`,
    SCHEMA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) AS `SOURCE`.`SCHEMA`)
INTO tcp_output;
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56
