# name: sinks/MultiSinkDistinctSinkNodes.test
# description: Multi-sink queries whose sinks sit on two different workers, both across the node boundary from the
# sub-plan they share. The shared operator then crosses that boundary once per sink, so the node holding it runs
# two network sinks relaying the same upstream origins. Unless those channels are given origin ids of their own,
# the receiving side keys several running sources on one origin, keeps a single one of them, and a sink is starved.
#
# Needs three nodes: with two, the sink node is the only one downstream of the source, so a second sink either
# joins it there or stays on the source node — neither of which puts two sinks on two different remote workers.
# remote-test/distributed.bats runs this against three-node.yaml, whose worker names the sinks below refer to.
#
# The first query asserts the decomposition, so that a placement change collapsing the two channels into one fails
# here rather than leaving the result checks to pass over coverage that is no longer there.
# groups: [Distributed]

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56

CREATE SINK sinkOnNode1(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File SET ('sink-node-1:8080' AS "SINK"."HOST");
CREATE SINK sinkOnNode2(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File SET ('sink-node-2:8080' AS "SINK"."HOST");
CREATE SINK reorderedOnNode2(value UINT64 NOT NULL, id UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File SET ('sink-node-2:8080' AS "SINK"."HOST");

# One plan on the source node driving two network sinks off the operator they share, one per sink node. Those two
# channels relay the same upstream origins, which is the case that needs them remapped to origins of their own.
EXPLAIN (DISTRIBUTED) FORMAT TEXT SELECT id, value, timestamp FROM stream WHERE value > 3 INTO sinkOnNode1, sinkOnNode2;
----
== Decomposed Plans ==
-- 1 plan(s) on sink-node-1:8080 --
0:
SINK(SINKONNODE1)
  SOURCE(NETWORK)
-- 1 plan(s) on sink-node-2:8080 --
0:
SINK(SINKONNODE2)
  SOURCE(NETWORK)
-- 1 plan(s) on source-node:8080 --
0:
SINK(NETWORK)
  PROJECTION(fields: [*])
    SELECTION(VALUE > 3)
      SOURCE(STREAM)
SINK(NETWORK)
  PROJECTION(fields: [*])
    SELECTION(VALUE > 3) [shared]
==END==

# One selection, two sinks, two workers: the shared operator feeds a network channel per sink.
SELECT id, value, timestamp FROM stream WHERE value > 3 INTO sinkOnNode1, sinkOnNode2;
----
1,4,45
1,5,56
----
1,4,45
1,5,56

# The same, with the sinks wanting different field orders, so the per-sink projections above the shared selection
# are what the two channels relay.
SELECT id, value, timestamp FROM stream WHERE value > 3 INTO sinkOnNode1, reorderedOnNode2;
----
1,4,45
1,5,56
----
4,1,45
5,1,56
