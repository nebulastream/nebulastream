# name: sinks/MultiSink.test
# description: Queries writing into more than one sink. The sinks share one sub-plan and each has its own result block.
# groups: [Sinks]

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56

CREATE SINK fileSinkA(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File;
CREATE SINK fileSinkB(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File;
CREATE SINK discardSink(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE Void;
CREATE SINK reorderedSink(value UINT64 NOT NULL, id UINT64 NOT NULL, timestamp UINT64 NOT NULL) TYPE File;

# Both sinks receive the full result of the query.
SELECT id, value, timestamp FROM stream INTO fileSinkA, fileSinkB;
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56

# Operators between the source and the fork are shared by both sinks.
SELECT id, value, timestamp FROM stream WHERE value > 3 INTO fileSinkA, fileSinkB;
----
1,4,45
1,5,56
----
1,4,45
1,5,56

# Anonymous sinks work the same way.
SELECT id, value, timestamp FROM stream WHERE value < 2 INTO File(), File();
----
1,1,12
----
1,1,12

# Sinks may have different types. A Void sink discards its tuples, so its result block stays empty.
SELECT id, value, timestamp FROM stream WHERE value = 3 INTO fileSinkA, discardSink;
----
1,3,34
----

# A sink must not be listed twice: both instances would write into the same sink.
SELECT id, value, timestamp FROM stream INTO fileSinkA, fileSinkA;
----
ERROR 2000

# Sinks may want different field orders. A shared operator carries a single one, so each sink gets its own projection above the
# shared sub-plan and receives its columns in the order it declared.
SELECT id, value, timestamp FROM stream INTO fileSinkA, reorderedSink;
----
1,1,12
1,2,23
1,3,34
1,4,45
1,5,56
----
1,1,12
2,1,23
3,1,34
4,1,45
5,1,56
