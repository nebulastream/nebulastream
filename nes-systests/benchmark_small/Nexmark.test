# name: milestone/Nexmark.test
# description: Nexmark benchmark taken from https://github.com/nexmark/nexmark/tree/master/nexmark-flink/src/main/resources/queries
# groups: [milestone, benchmark, benchmark_small, Aggregation, Join]

# Source definitions
CREATE LOGICAL SOURCE bid(timestamp UINT64, auctionId INT32, bidder INT32, datetime INT64, price FLOAT64);
CREATE PHYSICAL SOURCE FOR bid TYPE File;
ATTACH FILE small/nexmark/bid_modified_100K.csv
CREATE LOGICAL SOURCE auction(timestamp UINT64, id INT32, initialbid INT32, reserve INT32, expires INT64, seller INT32, category INT32);
CREATE PHYSICAL SOURCE FOR auction TYPE File;
ATTACH FILE small/nexmark/auction_modified_100K.csv

CREATE SINK q1CheckSum(price FLOAT64)  TYPE Checksum;
CREATE SINK q2CheckSum(timestamp UINT64, auctionId INT32, bidder INT32, datetime INT64, price FLOAT64)  TYPE Checksum;
CREATE SINK q5Checksum(start UINT64 NOT NULL, end UINT64 NOT NULL, auctionId INT32, num INT64 NOT NULL, max_tmp INT64)  TYPE Checksum;
CREATE SINK q8VariantChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, bid_timestamp UINT64, auctionId INT32, bidder INT32, datetime INT64, price FLOAT64, auction_timestamp UINT64, id INT32, initialbid INT32, reserve INT32, expires INT64, seller INT32, category INT32)  TYPE Checksum;

# Query 0
SELECT * FROM bid INTO q2CheckSum;
----
4445 4706576

# Query 1
SELECT price * 89 / 100 AS price FROM bid INTO q1CheckSum;
----
4445 1336553

# Query 2
SELECT * FROM bid WHERE auctionId % 123 = 0 INTO q2CheckSum;
----
47 47464

# Query 5
SELECT a.window_start AS "START", a.window_end AS "END", a.auctionId, a.num, b.max_tmp
FROM (SELECT * FROM TABLE(TUMBLE(
        (SELECT auctionId, COUNT(auctionId) AS num, window_start AS auction_start, window_end AS auction_end
         FROM TABLE(HOP(TABLE bid, DESCRIPTOR("TIMESTAMP"), INTERVAL '2' SECOND, INTERVAL '10' SECOND))
         GROUP BY window_start, window_end, auctionId),
        DESCRIPTOR(auction_start), INTERVAL '2' SECOND))) AS a
INNER JOIN (SELECT * FROM TABLE(TUMBLE(
        (SELECT MAX(num_ids) AS max_tmp, window_start AS bid_start, window_end AS bid_end
         FROM TABLE(TUMBLE(
                (SELECT auctionId, COUNT(auctionId) AS num_ids, window_start AS "START"
                 FROM TABLE(HOP(TABLE bid, DESCRIPTOR("TIMESTAMP"), INTERVAL '2' SECOND, INTERVAL '10' SECOND))
                 GROUP BY window_start, window_end, auctionId),
                DESCRIPTOR("START"), INTERVAL '2' SECOND))
         GROUP BY window_start, window_end),
        DESCRIPTOR(bid_start), INTERVAL '2' SECOND))) AS b
ON a.window_start = b.window_start AND a.num = b.max_tmp
INTO q5Checksum;
----
69 69347


# Query 8 Variant (We are not using the actual Q8 but a variant, as we have swapped the Person stream with the Bid stream)
SELECT b.window_start AS "START", b.window_end AS "END", b."TIMESTAMP" AS bid_timestamp, b.auctionId, b.bidder, b."DATETIME", b.price,
       a."TIMESTAMP" AS auction_timestamp, a.id, a.initialbid, a.reserve, a.expires, a.seller, a.category
FROM TABLE(TUMBLE(TABLE bid, DESCRIPTOR("TIMESTAMP"), INTERVAL '10' SECOND)) AS b
INNER JOIN TABLE(TUMBLE(TABLE auction, DESCRIPTOR("TIMESTAMP"), INTERVAL '10' SECOND)) AS a
ON b.window_start = a.window_start AND b.auctionId = a.id
INTO q8VariantChecksum;
----
2160 6293051
