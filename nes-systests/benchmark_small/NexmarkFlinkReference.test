# reference: q17 --string-columns 1
SELECT auction, bidDay, totalBids, rank1Bids, rank2Bids, rank3Bids, minPrice, maxPrice, sumPrice / totalBids AS avgPrice, sumPrice
FROM (SELECT auction, bidDay,
             COUNT(price) AS totalBids,
             COUNT(CASE WHEN price < 10000 THEN 1 END) AS rank1Bids,
             COUNT(CASE WHEN price >= 10000 AND price < 1000000 THEN 1 END) AS rank2Bids,
             COUNT(CASE WHEN price >= 1000000 THEN 1 END) AS rank3Bids,
             MIN(price) AS minPrice, MAX(price) AS maxPrice, SUM(price) AS sumPrice
      FROM (SELECT auction, price, dateTime, DATE_FORMAT(dateTime, 'yyyy-MM-dd') AS bidDay FROM bid)
      GROUP BY auction, bidDay
      WINDOW UNBOUNDED(dateTime))
INTO q17Sink;
