# name: benchmark_small/NexmarkFlinkReference.test
# description: Nexmark queries over the full Flink Nexmark schema. Expected results come from running the upstream
#   nexmark-flink queries on Flink 1.20 over the same input files (scripts/benchmarking/nexmark/flink). Each query names
#   its reference in a `# reference:` line; regenerate the expected results with
#   `scripts/benchmarking/nexmark/flink/update_expected.py <this file> <reference dir>`.
#   Input: 10k events (200 persons, 600 auctions, 9200 bids), 100 events/s of event time, generated with
#   `nexmark-datagen --events 10000 --rate 100`.
#   Outputs with free-text VARSIZED columns are compared by checksum: the row comparison splits fields on spaces.
# groups: [benchmark, benchmark_small, Nexmark, Aggregation, Join]

CREATE LOGICAL SOURCE person(id INT64 NOT NULL, name VARSIZED NOT NULL, emailAddress VARSIZED NOT NULL, creditCard VARSIZED NOT NULL, city VARSIZED NOT NULL, state VARSIZED NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR person TYPE File;
ATTACH FILE small/nexmark/flink_10k/person.csv

CREATE LOGICAL SOURCE auction(id INT64 NOT NULL, itemName VARSIZED NOT NULL, description VARSIZED NOT NULL, initialBid INT64 NOT NULL, reserve INT64 NOT NULL, dateTime UINT64 NOT NULL, expires UINT64 NOT NULL, seller INT64 NOT NULL, category INT64 NOT NULL, extra VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR auction TYPE File;
ATTACH FILE small/nexmark/flink_10k/auction.csv

CREATE LOGICAL SOURCE bid(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR bid TYPE File;
ATTACH FILE small/nexmark/flink_10k/bid.csv

# The q13 side input (upstream SideInputGenerator: key,value = i,i).
CREATE LOGICAL SOURCE side_input(sikey INT64 NOT NULL, sivalue VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR side_input TYPE File;
ATTACH FILE small/nexmark/flink_10k/side_input.csv

CREATE SINK q0Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q1Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price FLOAT64 NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q2Sink(auction INT64 NOT NULL, price INT64 NOT NULL) TYPE File;
CREATE SINK q3Sink(name VARSIZED NOT NULL, city VARSIZED NOT NULL, state VARSIZED NOT NULL, id INT64 NOT NULL) TYPE Checksum;
CREATE SINK q4Sink(category INT64 NOT NULL, avgFinal UINT64 NOT NULL) TYPE File;
CREATE SINK q5Sink(auction INT64 NOT NULL, num UINT64 NOT NULL) TYPE File;
CREATE SINK q7Sink(auction INT64 NOT NULL, price INT64 NOT NULL, bidder INT64 NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q8Sink(id INT64 NOT NULL, name VARSIZED NOT NULL, stime UINT64 NOT NULL) TYPE Checksum;
CREATE SINK q9Sink(id INT64 NOT NULL, itemName VARSIZED NOT NULL, description VARSIZED NOT NULL, initialBid INT64 NOT NULL, reserve INT64 NOT NULL, aTime UINT64 NOT NULL, expires UINT64 NOT NULL, seller INT64 NOT NULL, category INT64 NOT NULL, aExtra VARSIZED NOT NULL, auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, bTime UINT64 NOT NULL, bExtra VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q10Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL, dt VARSIZED NOT NULL, hm VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q14Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price FLOAT64 NOT NULL, bidTimeType VARSIZED NOT NULL, dateTime UINT64 NOT NULL, extra VARSIZED NOT NULL, cCounts UINT64 NOT NULL) TYPE Checksum;
CREATE SINK q21Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, channel VARSIZED NOT NULL, channelId VARSIZED) TYPE Checksum;
CREATE SINK q22Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, channel VARSIZED NOT NULL, dir1 VARSIZED, dir2 VARSIZED, dir3 VARSIZED) TYPE Checksum;
CREATE SINK q13Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, dateTime UINT64 NOT NULL, sivalue VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q20Sink(auction INT64 NOT NULL, bidder INT64 NOT NULL, price INT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL, bDateTime UINT64 NOT NULL, bExtra VARSIZED NOT NULL, itemName VARSIZED NOT NULL, description VARSIZED NOT NULL, initialBid INT64 NOT NULL, reserve INT64 NOT NULL, aDateTime UINT64 NOT NULL, expires UINT64 NOT NULL, seller INT64 NOT NULL, category INT64 NOT NULL, aExtra VARSIZED NOT NULL) TYPE Checksum;
CREATE SINK q23Sink(bidder INT64 NOT NULL, price INT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL, bidExtra VARSIZED NOT NULL, personId INT64 NOT NULL, name VARSIZED NOT NULL, emailAddress VARSIZED NOT NULL, creditCard VARSIZED NOT NULL, city VARSIZED NOT NULL, state VARSIZED NOT NULL, personExtra VARSIZED NOT NULL, itemName VARSIZED NOT NULL, description VARSIZED NOT NULL, initialBid INT64 NOT NULL, reserve INT64 NOT NULL, auctionDateTime UINT64 NOT NULL, expires UINT64 NOT NULL, seller INT64 NOT NULL, category INT64 NOT NULL, auctionExtra VARSIZED NOT NULL) TYPE Checksum;

# Query 0: pass-through
# reference: q0 --checksum
SELECT auction, bidder, price, dateTime, extra FROM bid INTO q0Sink;
----
9200 82646636

# Query 1: currency conversion
# reference: q1 --float-columns 2 --checksum
SELECT auction, bidder, price * 0.908 AS price, dateTime, extra FROM bid INTO q1Sink;
