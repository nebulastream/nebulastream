# Query 20: expand bid with auction (category 10).
# reference: q20 --checksum
SELECT auction, bidder, price, channel, url, bDateTime, bExtra, itemName, description, initialBid, reserve, aDateTime, expires, seller, category, aExtra
FROM (SELECT auction, bidder, price, channel, url, dateTime AS bDateTime, extra AS bExtra FROM bid)
INNER JOIN (SELECT id, itemName, description, initialBid, reserve, dateTime AS aDateTime, expires, seller, category, extra AS aExtra
            FROM auction WHERE category = 10)
ON auction = id
WINDOW UNBOUNDED (bDateTime, aDateTime)
INTO q20Sink;
----
2603 184644721

# Query 21: add channel id.
# reference: q21 --checksum --string-columns 4
SELECT auction, bidder, price, channel,
       CASE WHEN LOWER(channel) = 'apple' THEN '0'
            WHEN LOWER(channel) = 'google' THEN '1'
            WHEN LOWER(channel) = 'facebook' THEN '2'
            WHEN LOWER(channel) = 'baidu' THEN '3'
            ELSE REGEXP_EXTRACT(url, '(&|^)channel_id=([^&]*)', 2) END AS channelId
FROM bid
WHERE REGEXP_EXTRACT(url, '(&|^)channel_id=([^&]*)', 2) IS NOT NULL
   OR LOWER(channel) IN ('apple', 'google', 'facebook', 'baidu')
INTO q21Sink;
----
8754 17860652

# Query 22: get URL directories.
# reference: q22 --checksum
SELECT auction, bidder, price, channel,
       SPLIT_INDEX(url, '/', 3) AS dir1, SPLIT_INDEX(url, '/', 4) AS dir2, SPLIT_INDEX(url, '/', 5) AS dir3
FROM bid
INTO q22Sink;
----
9200 29058608

# Query 23: bid x person x auction (two regular joins in Flink). A row of the first unbounded join is emitted when
# the later of its two inputs arrives, so the second join uses the later timestamp as its event time; bidTime alone
# would lie behind the first join's watermark.
# reference: q23 --checksum
SELECT bidder, price, channel, url, bidExtra, personId, name, emailAddress, creditCard, city, state, personExtra,
       itemName, description, initialBid, reserve, auctionDateTime, expires, seller, category, auctionExtra
FROM (SELECT bidder, price, channel, url, bidExtra, personId, name, emailAddress, creditCard, city, state, personExtra,
             CASE WHEN bidTime > personTime THEN bidTime ELSE personTime END AS joinTime
      FROM (SELECT bidder, price, channel, url, extra AS bidExtra, dateTime AS bidTime FROM bid)
      INNER JOIN (SELECT id AS personId, name, emailAddress, creditCard, city, state, extra AS personExtra, dateTime AS personTime FROM person)
      ON bidder = personId
      WINDOW UNBOUNDED (bidTime, personTime))
INNER JOIN (SELECT itemName, description, initialBid, reserve, dateTime AS auctionDateTime, expires, seller, category, extra AS auctionExtra
            FROM auction)
ON seller = bidder
WINDOW UNBOUNDED (joinTime, auctionDateTime)
INTO q23Sink;
----
33564 2888672196
