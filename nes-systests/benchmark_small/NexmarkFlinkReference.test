# Query 7: highest bid, as in Flink: an interval join `B.dateTime BETWEEN window_end - 10 s AND window_end`,
# i.e. maxEnd in [dateTime, dateTime + 10 s].
# reference: q7 --checksum
SELECT auction, price, bidder, dateTime, extra
FROM (SELECT * FROM bid)
INNER JOIN (SELECT maxprice, end AS maxEnd
            FROM (SELECT MAX(price) AS maxprice, start, end FROM bid WINDOW TUMBLING(dateTime, SIZE 10 SEC)))
ON price = maxprice
INTERVAL (dateTime, maxEnd, 0 ms, 10000 ms)
INTO q7Sink;
----
10 89017

# Query 8: monitor new users. Both sides are deduplicated per 10 s tumbling window before the window join.
# reference: q8 --checksum
SELECT id, name, personStart AS stime
FROM (SELECT id, name, start AS personStart
      FROM (SELECT id, name, start, end FROM person GROUP BY id, name WINDOW TUMBLING(dateTime, SIZE 10 SEC)))
INNER JOIN (SELECT seller, start AS sellerStart
            FROM (SELECT seller, start, end FROM auction GROUP BY seller WINDOW TUMBLING(dateTime, SIZE 10 SEC)))
ON id = seller
WINDOW TUMBLING(personStart, sellerStart, SIZE 10 SEC)
INTO q8Sink;
----
39 83539

# Query 9: winning bid per auction (ROW_NUMBER Top-1 by price DESC, dateTime ASC in Flink). NES has no Top-N, so
# the query takes the maximum price per auction, joins back to the bids with that price, takes their earliest time
# and joins back once more. Aggregations use one window that spans all data, as in q4; each join after an
# aggregation uses the window end as the aggregate's time, which never lies behind a watermark.
# reference: q9 --checksum
SELECT id, itemName, description, initialBid, reserve, aTime, expires, seller, category, aExtra, auction, bidder, price, bTime, bExtra
FROM (SELECT id, itemName, description, initialBid, reserve, aTime, expires, seller, category, aExtra, auction, bidder, price, bTime, bExtra, mTime
      FROM (SELECT id, itemName, description, initialBid, reserve, aTime, expires, seller, category, aExtra, auction, bidder, price, bTime, bExtra
      FROM (SELECT id, itemName, description, initialBid, reserve, dateTime AS aTime, expires, seller, category, extra AS aExtra FROM auction)
      INNER JOIN (SELECT auction, bidder, price, dateTime AS bTime, extra AS bExtra FROM bid)
      ON id = auction AND bTime >= aTime AND bTime <= expires
      WINDOW UNBOUNDED (aTime, bTime))
      INNER JOIN (SELECT id AS mid, maxPrice, end AS mTime
      FROM (SELECT id, MAX(price) AS maxPrice, end FROM (SELECT id, auction, price, bTime
      FROM (SELECT id, dateTime AS aTime, expires FROM auction)
      INNER JOIN (SELECT auction, price, dateTime AS bTime FROM bid)
      ON id = auction AND bTime >= aTime AND bTime <= expires
      WINDOW UNBOUNDED (aTime, bTime)) GROUP BY id WINDOW TUMBLING(bTime, SIZE 1000000 HOURS)))
      ON id = mid AND price = maxPrice
      WINDOW UNBOUNDED (bTime, mTime))
INNER JOIN (SELECT id AS tid, winTime, end AS tTime
      FROM (SELECT id, MIN(bTime) AS winTime, end FROM (SELECT id, itemName, description, initialBid, reserve, aTime, expires, seller, category, aExtra, auction, bidder, price, bTime, bExtra, mTime
      FROM (SELECT id, itemName, description, initialBid, reserve, aTime, expires, seller, category, aExtra, auction, bidder, price, bTime, bExtra
      FROM (SELECT id, itemName, description, initialBid, reserve, dateTime AS aTime, expires, seller, category, extra AS aExtra FROM auction)
      INNER JOIN (SELECT auction, bidder, price, dateTime AS bTime, extra AS bExtra FROM bid)
      ON id = auction AND bTime >= aTime AND bTime <= expires
      WINDOW UNBOUNDED (aTime, bTime))
      INNER JOIN (SELECT id AS mid, maxPrice, end AS mTime
      FROM (SELECT id, MAX(price) AS maxPrice, end FROM (SELECT id, auction, price, bTime
      FROM (SELECT id, dateTime AS aTime, expires FROM auction)
      INNER JOIN (SELECT auction, price, dateTime AS bTime FROM bid)
      ON id = auction AND bTime >= aTime AND bTime <= expires
      WINDOW UNBOUNDED (aTime, bTime)) GROUP BY id WINDOW TUMBLING(bTime, SIZE 1000000 HOURS)))
      ON id = mid AND price = maxPrice
      WINDOW UNBOUNDED (bTime, mTime)) GROUP BY id WINDOW TUMBLING(mTime, SIZE 1000000 HOURS)))
ON id = tid AND bTime = winTime
WINDOW UNBOUNDED (mTime, tTime)
INTO q9Sink;
----
553 34119481

# Query 10: log to filesystem (the reference uses an unpartitioned sink, see flink/queries/q10.sql).
# reference: q10 --checksum
SELECT auction, bidder, price, dateTime, extra, DATE_FORMAT(dateTime, 'yyyy-MM-dd') AS dt, DATE_FORMAT(dateTime, 'HH:mm') AS hm
FROM bid
INTO q10Sink;
----
9200 91576156

# Query 13: bounded side input join. Upstream joins FOR SYSTEM_TIME AS OF PROCTIME() against a static file, which is
# a regular join for a static table (see scripts/benchmarking/nexmark/flink/queries/q13.sql).
# reference: q13 --checksum --string-columns 4
SELECT auction, bidder, price, dateTime, sivalue
FROM (SELECT auction, bidder, price, dateTime, auction % 10000 AS sideKey FROM bid)
INNER JOIN TABLE (SELECT * FROM side_input)
ON sideKey = sikey
INTO q13Sink;
----
9200 16445617

# Query 14: calculation. Upstream counts 'c' with a Java UDF; CHAR_LENGTH - CHAR_LENGTH(REPLACE(...)) is the same count.
# reference: q14 --float-columns 2 --checksum
SELECT auction, bidder, price * 0.908 AS price,
       CASE WHEN HOUR(dateTime) >= 8 AND HOUR(dateTime) <= 18 THEN 'dayTime'
            WHEN HOUR(dateTime) <= 6 OR HOUR(dateTime) >= 20 THEN 'nightTime'
            ELSE 'otherTime' END AS bidTimeType,
       dateTime, extra,
       CHAR_LENGTH(extra) - CHAR_LENGTH(REPLACE(extra, 'c', '')) AS cCounts
FROM bid
WHERE price * 0.908 > 1000000 AND price * 0.908 < 50000000
INTO q14Sink;
----
2655 27636284

# Queries 15-17: bidding statistics per day (q15), per channel and day (q16) and per auction and day (q17). Like Flink,
# they are unbounded GROUP BYs (WINDOW UNBOUNDED) that emit a changelog of every key; the check folds it into the final
# table, which is what Flink's batch reference contains. `count(*) FILTER (WHERE c)` becomes COUNT(CASE WHEN c THEN 1 END) and
# `count(DISTINCT x) FILTER (WHERE c)` becomes COUNT(DISTINCT CASE WHEN c THEN x END): a CASE without ELSE is NULL when
# c does not hold, and both counts skip NULLs. q16's max(DATE_FORMAT(dateTime, 'HH:mm')) is the format of the latest
# dateTime, since the format is monotonic within a day. AVG over BIGINT truncates in Flink, hence SUM / COUNT in q17.
# reference: q15 --string-columns 0
SELECT bidDay, totalBids, rank1Bids, rank2Bids, rank3Bids, totalBidders, rank1Bidders, rank2Bidders, rank3Bidders, totalAuctions, rank1Auctions, rank2Auctions, rank3Auctions
FROM (SELECT bidDay,
             COUNT(price) AS totalBids,
             COUNT(CASE WHEN price < 10000 THEN 1 END) AS rank1Bids,
             COUNT(CASE WHEN price >= 10000 AND price < 1000000 THEN 1 END) AS rank2Bids,
             COUNT(CASE WHEN price >= 1000000 THEN 1 END) AS rank3Bids,
             COUNT(DISTINCT bidder) AS totalBidders,
             COUNT(DISTINCT CASE WHEN price < 10000 THEN bidder END) AS rank1Bidders,
             COUNT(DISTINCT CASE WHEN price >= 10000 AND price < 1000000 THEN bidder END) AS rank2Bidders,
             COUNT(DISTINCT CASE WHEN price >= 1000000 THEN bidder END) AS rank3Bidders,
             COUNT(DISTINCT auction) AS totalAuctions,
             COUNT(DISTINCT CASE WHEN price < 10000 THEN auction END) AS rank1Auctions,
             COUNT(DISTINCT CASE WHEN price >= 10000 AND price < 1000000 THEN auction END) AS rank2Auctions,
             COUNT(DISTINCT CASE WHEN price >= 1000000 THEN auction END) AS rank3Auctions
      FROM (SELECT auction, bidder, price, dateTime, DATE_FORMAT(dateTime, 'yyyy-MM-dd') AS bidDay FROM bid)
      GROUP BY bidDay
      WINDOW UNBOUNDED(dateTime))
INTO q15Sink;
----
2023-11-14,9200,3053,3019,3128,194,171,165,171,598,527,530,528

# reference: q16 --string-columns 0,1,2
SELECT channel, bidDay, DATE_FORMAT(maxTime, 'HH:mm') AS bidMinute, totalBids, rank1Bids, rank2Bids, rank3Bids, totalBidders, rank1Bidders, rank2Bidders, rank3Bidders, totalAuctions, rank1Auctions, rank2Auctions, rank3Auctions
FROM (SELECT channel, bidDay, MAX(dateTime) AS maxTime,
             COUNT(price) AS totalBids,
             COUNT(CASE WHEN price < 10000 THEN 1 END) AS rank1Bids,
             COUNT(CASE WHEN price >= 10000 AND price < 1000000 THEN 1 END) AS rank2Bids,
             COUNT(CASE WHEN price >= 1000000 THEN 1 END) AS rank3Bids,
             COUNT(DISTINCT bidder) AS totalBidders,
             COUNT(DISTINCT CASE WHEN price < 10000 THEN bidder END) AS rank1Bidders,
             COUNT(DISTINCT CASE WHEN price >= 10000 AND price < 1000000 THEN bidder END) AS rank2Bidders,
             COUNT(DISTINCT CASE WHEN price >= 1000000 THEN bidder END) AS rank3Bidders,
             COUNT(DISTINCT auction) AS totalAuctions,
             COUNT(DISTINCT CASE WHEN price < 10000 THEN auction END) AS rank1Auctions,
             COUNT(DISTINCT CASE WHEN price >= 10000 AND price < 1000000 THEN auction END) AS rank2Auctions,
             COUNT(DISTINCT CASE WHEN price >= 1000000 THEN auction END) AS rank3Auctions
      FROM (SELECT channel, auction, bidder, price, dateTime, DATE_FORMAT(dateTime, 'yyyy-MM-dd') AS bidDay FROM bid)
      GROUP BY channel, bidDay
      WINDOW UNBOUNDED(dateTime))
INTO q16Sink;
