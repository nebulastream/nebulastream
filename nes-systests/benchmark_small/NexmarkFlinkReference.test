# Query 3: local item suggestion. Flink runs a regular join, which is WINDOW UNBOUNDED in NES: every pair over the
# whole history of both inputs.
# reference: q3 --checksum
SELECT name, city, state, aid AS id
FROM (SELECT id AS aid, seller, dateTime AS aTime FROM auction WHERE category = 10)
INNER JOIN (SELECT id AS pid, name, city, state, dateTime AS pTime FROM person WHERE state = 'OR' OR state = 'ID' OR state = 'CA')
ON seller = pid
WINDOW UNBOUNDED (aTime, pTime)
INTO q3Sink;
----
62 153461

# Query 4: average closing price per category. Flink keeps an unbounded join and two unbounded GROUP BYs that
# update their results. On bounded input the final result equals a GROUP BY over one tumbling window that spans
# all data (1,000,000 hours), so both aggregations use one. AVG over BIGINT truncates in Flink, hence SUM / COUNT.
# reference: q4
SELECT category, total / cnt AS avgFinal
FROM (SELECT category, SUM(final) AS total, COUNT(final) AS cnt
FROM (SELECT id, category, MAX(price) AS final, start AS aggStart
      FROM (SELECT id, category, price, bTime
            FROM (SELECT id, category, dateTime AS aTime, expires FROM auction)
            INNER JOIN (SELECT auction, price, dateTime AS bTime FROM bid)
            ON id = auction AND bTime >= aTime AND bTime <= expires
            WINDOW UNBOUNDED (aTime, bTime))
      GROUP BY id, category
      WINDOW TUMBLING(bTime, SIZE 1000000 HOURS))
GROUP BY category
WINDOW TUMBLING(aggStart, SIZE 1000000 HOURS))
INTO q4Sink;
----
10,28812731
11,31985955
12,28623495
13,29399749
14,30865469

# Query 5: hot items. Flink joins on window_start/window_end and `num >= maxn`; NES expresses the
# "same hop window" condition as a 2 s tumbling join over the window starts (slide = 2 s).
# reference: q5
SELECT auction, num
FROM (SELECT auction, num, start AS auctionStart
      FROM (SELECT auction, COUNT(auction) AS num, start, end
            FROM bid
            GROUP BY auction
            WINDOW SLIDING(dateTime, SIZE 10 SEC, ADVANCE BY 2 SEC)))
INNER JOIN (SELECT maxn, start AS maxStart
            FROM (SELECT MAX(countPerAuction) AS maxn, start, end
                  FROM (SELECT auction, COUNT(auction) AS countPerAuction, start
                        FROM bid
                        GROUP BY auction
                        WINDOW SLIDING(dateTime, SIZE 10 SEC, ADVANCE BY 2 SEC))
                  WINDOW TUMBLING(start, SIZE 2 SEC)))
ON num >= maxn
WINDOW TUMBLING(auctionStart, maxStart, SIZE 2 SEC)
INTO q5Sink;
----
