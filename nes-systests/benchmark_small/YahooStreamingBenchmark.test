# name: milestone/YahooStreamingBenchmark.test
# description: YahooStreamingBenchmark queries (https://github.com/yahoo/streaming-benchmarks) with changed data types
# groups: [milestone, benchmark, benchmark_small, Aggregation]

# Source definitions
CREATE LOGICAL SOURCE ysb1k(user_id UINT64, page_id UINT64, campaign_id UINT64, ad_type UINT64, event_type UINT64, current_ms UINT64, ip UINT64, d1 UINT64, d2 UINT64, d3 UINT32, d4 UINT16);
CREATE PHYSICAL SOURCE FOR ysb1k TYPE File;
ATTACH FILE small/ysb/ysb1k_100K.csv

CREATE LOGICAL SOURCE ysb10k(user_id UINT64, page_id UINT64, campaign_id UINT64, ad_type UINT64, event_type UINT64, current_ms UINT64, ip UINT64, d1 UINT64, d2 UINT64, d3 UINT32, d4 UINT16);
CREATE PHYSICAL SOURCE FOR ysb10k TYPE File;
ATTACH FILE small/ysb/ysb10k_100K.csv

CREATE SINK ysb1kChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, campaign_id UINT64, sum_user_id UINT64)  TYPE Checksum;
CREATE SINK ysb10kChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, campaign_id UINT64, sum_user_id UINT64)  TYPE Checksum;

# Query 1 YSB with 1k campaign_ids
SELECT
    window_start AS "START",
    window_end AS "END",
    campaign_id,
    SUM(user_id) AS sum_user_id
FROM TABLE(TUMBLE((SELECT * FROM ysb1k WHERE event_type < 1), DESCRIPTOR(current_ms), INTERVAL '30' SECOND))
GROUP BY window_start, window_end, campaign_id
INTO ysb1kChecksum;
----
583 440557


# Query 2 YSB with 10k campaign_ids
SELECT
    window_start AS "START",
    window_end AS "END",
    campaign_id,
    SUM(user_id) AS sum_user_id
FROM TABLE(TUMBLE((SELECT * FROM ysb10k WHERE event_type < 1), DESCRIPTOR(current_ms), INTERVAL '30' SECOND))
GROUP BY window_start, window_end, campaign_id
INTO ysb10kChecksum;
----
852 678338
