CREATE SINK sinkWindow(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL)  TYPE File;

# Filter equal
SELECT *
FROM (
    SELECT *
    FROM stream
    WHERE timestamp < 10000
)
WHERE value > 5 INTO sinkWindow;
