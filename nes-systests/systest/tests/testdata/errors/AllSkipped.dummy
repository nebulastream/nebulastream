# name: AllSkipped
# description: every query asks for worker settings, which a run against workers started elsewhere cannot apply

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [4096]

CREATE LOGICAL SOURCE s(id UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR s TYPE File;
ATTACH INLINE
1

CREATE SINK sinkA(id UINT64 NOT NULL) TYPE File;

SELECT id FROM s INTO sinkA;
----
1
