CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE FileSource;
ATTACH INLINE
1

CREATE SINK CORRECT_SINK(id UINT64 NOT NULL)  TYPE FileSink;
SELECT id FROM stream INTO CORRECT_SINK;
----
1

CREATE SINK INCORRECT_SINK(id INT64 NOT NULL)  TYPE FileSink;
SELECT id FROM stream INTO INCORRECT_SINK;
----
1
