CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE FileSource;
ATTACH INLINE
1,1
2,2

CREATE SINK CORRECT_SINK(id UINT64 NOT NULL, value UINT64 NOT NULL)  TYPE FileSink;
SELECT id, value FROM stream INTO CORRECT_SINK;
----
1 1
2 2

CREATE SINK INCORRECT_SINK(id UINT64 NOT NULL, value UINT64 NOT NULL)  TYPE FileSink;
SELECT id FROM stream INTO INCORRECT_SINK;
----
1 1
2 2
