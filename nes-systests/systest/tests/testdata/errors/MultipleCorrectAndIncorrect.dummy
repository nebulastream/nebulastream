CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE FileSource;
ATTACH INLINE
1,2

CREATE SINK ID_VALUE_SINK(id UINT64 NOT NULL, value UINT64 NOT NULL)  TYPE FileSink;
CREATE SINK ID_SINK(id UINT64 NOT NULL)  TYPE FileSink;
CREATE SINK VALUE_SINK(value UINT64 NOT NULL)  TYPE FileSink;

# Correct
SELECT id, value FROM stream INTO ID_VALUE_SINK;
----
1 2

# Incorrect
SELECT id, value FROM stream INTO ID_VALUE_SINK;
----

# Incorrect
SELECT id, value FROM stream INTO ID_VALUE_SINK;
----
2 1

# Incorrect
SELECT id FROM stream INTO ID_VALUE_SINK;
----
1

# Correct
SELECT id FROM stream INTO ID_SINK;
----
1

# Correct
SELECT value FROM stream INTO VALUE_SINK;
----
2

# Incorrect
SELECT value FROM stream INTO ID_VALUE_SINK;
----
1 2

# Correct
SELECT id, value FROM stream WHERE id > 3 INTO ID_VALUE_SINK;
----

