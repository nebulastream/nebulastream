CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,2

CREATE SINK ID_VALUE_SINK(id UINT64 NOT NULL, value UINT64 NOT NULL)  TYPE File;
CREATE SINK ID_SINK(id UINT64 NOT NULL)  TYPE File;
CREATE SINK VALUE_SINK(value UINT64 NOT NULL)  TYPE File;

# Correct
SELECT id, "VALUE" FROM "STREAM" INTO ID_VALUE_SINK;
----
1 2

# Incorrect
SELECT id, "VALUE" FROM "STREAM" INTO ID_VALUE_SINK;
----

# Incorrect
SELECT id, "VALUE" FROM "STREAM" INTO ID_VALUE_SINK;
----
2 1

# Incorrect
SELECT id FROM "STREAM" INTO ID_VALUE_SINK;
----
1

# Correct
SELECT id FROM "STREAM" INTO ID_SINK;
----
1

# Correct
SELECT "VALUE" FROM "STREAM" INTO VALUE_SINK;
----
2

# Incorrect
SELECT "VALUE" FROM "STREAM" INTO ID_VALUE_SINK;
----
1 2

# Correct
SELECT id, "VALUE" FROM "STREAM" WHERE id > 3 INTO ID_VALUE_SINK;
----

