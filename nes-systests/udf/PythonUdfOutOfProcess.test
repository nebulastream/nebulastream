# name: udf/PythonUdfOutOfProcess.test
# description: UDFs with EXECUTION OUT_OF_PROCESS run in a separate Python process, which exchanges Arrow IPC streams with the worker
# groups: [PythonUdf, PythonUdfProcess]

CREATE LOGICAL SOURCE nums(a INT64 NOT NULL, b INT64 NOT NULL, s VARSIZED NOT NULL, unused INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR nums TYPE File;
ATTACH INLINE
1,2,x,0
10,20,yy,0
100,200,zzz,0

CREATE FUNCTION inc (x INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS AS $python$
    return x + 1
$python$;
CREATE FUNCTION add_two (x INT64, y INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS AS $python$
    return x + y
$python$;
CREATE FUNCTION shout (w VARSIZED) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS AS $python$
    return w.upper() + "!"
$python$;
CREATE FUNCTION positive (x INT64) RETURNS BOOLEAN EXECUTION OUT_OF_PROCESS AS $python$
    return x > 5
$python$;
CREATE FUNCTION inc_inline (x INT64) RETURNS INT64 EXECUTION INLINE AS $python$
    return x + 1
$python$;

# Several calls in one projection, of different result types, next to built-in functions
SELECT a, inc(a) AS i, add_two(a, b) + 1 AS total, shout(s) AS loud FROM nums INTO FILE();
----
1,2,4,X!
10,11,31,YY!
100,101,301,ZZZ!

# A call reading another call
SELECT inc(inc(a)) AS i FROM nums INTO FILE();
----
3
12
102

# An argument that has to be computed, with a built-in function between two calls
SELECT inc(inc(a) + 1) AS i FROM nums INTO FILE();
----
4
13
103

# The same call twice, and a constant argument
SELECT inc(a) AS x, inc(a) AS y, add_two(a, INT64(5)) AS z FROM nums INTO FILE();
----
2,2,6
11,11,15
101,101,105

# Only constants as arguments
SELECT inc(INT64(1)) AS i FROM nums INTO FILE();
----
2
2
2

# Inline UDFs stay in their expressions, on either side of a lifted call
SELECT inc_inline(inc(a)) AS x, inc(inc_inline(a)) AS y FROM nums INTO FILE();
----
3,3
12,12
102,102

# A selection does not output the helper fields
SELECT * FROM nums WHERE positive(a) INTO FILE();
----
10,20,yy,0
100,200,zzz,0

# A selection combined with other predicates, and an asterisk next to a call
SELECT *, inc(a) AS i FROM (SELECT a, b FROM nums) WHERE positive(a) AND b < INT64(100) INTO FILE();
----
10,20,11

# A call on the result of a subquery with a call
SELECT inc(i) AS j FROM (SELECT inc(a) AS i FROM nums) INTO FILE();
----
3
12
102

# A join predicate needs both sides of the join
CREATE LOGICAL SOURCE others(c INT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR others TYPE File;
ATTACH INLINE
1,1

SELECT * FROM (SELECT * FROM others) INNER JOIN (SELECT c AS d, ts AS ts2 FROM others) ON positive(c) WINDOW TUMBLING(ts, ts2, SIZE 1 SEC) INTO FILE();
----
ERROR 2026

# A failing UDF fails the query with the UDF error code
CREATE FUNCTION boom (x INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS AS $python$
    raise ValueError("boom")
$python$;

SELECT boom(a) AS y FROM nums INTO FILE();
----
ERROR 3007

# A module that cannot be imported fails the query when it starts
CREATE FUNCTION missing (x INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'no_such_module.f';

SELECT missing(a) AS y FROM nums INTO FILE();
----
ERROR 2047

# An entry point from a module on the worker's search path
CREATE FUNCTION add_module (a INT64, b INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'currency.add';

SELECT add_module(a, b) AS c FROM nums INTO FILE();
----
3
30
300

# NULL reaches the UDF as None, and None is NULL in the result
CREATE LOGICAL SOURCE nullable(v INT64, w VARSIZED, f BOOLEAN);
CREATE PHYSICAL SOURCE FOR nullable TYPE File;
ATTACH INLINE
1,a,true
,,

CREATE FUNCTION describe (v INT64, w VARSIZED, f BOOLEAN) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS AS $python$
    return None if v is None else repr([v, w, f]).replace(', ', '/').encode()
$python$;
CREATE FUNCTION is_null (v INT64) RETURNS BOOLEAN EXECUTION OUT_OF_PROCESS AS $python$
    return v is None
$python$;

SELECT describe(v, w, f) AS d, is_null(v) AS n FROM nullable INTO FILE();
----
[1/'a'/True],false
NULL,true

# Values larger than a buffer: their column gets an unpooled buffer, and the answer of the process, which then does not fit behind
# the header of a buffer, is read into a child buffer
CREATE FUNCTION widen (w VARSIZED) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS AS $python$
    return w * 20000
$python$;
CREATE FUNCTION measure (w VARSIZED) RETURNS INT64 EXECUTION OUT_OF_PROCESS AS $python$
    return len(w)
$python$;

SELECT a, measure(widen(s)) AS m FROM nums INTO FILE();
----
1,20000
10,40000
100,60000

# A VARSIZED value that is not UTF-8 fails the query
CREATE LOGICAL SOURCE encoded(b VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR encoded TYPE File;
ATTACH INLINE
/w==

SELECT shout(FROM_BASE64(b)) AS u FROM encoded INTO FILE();
----
ERROR 3007

# Mixed with in-process UDFs, on either side
CREATE FUNCTION inc_in_process (x INT64) RETURNS INT64 AS $python$
    return x + 1
$python$;

SELECT inc(inc_in_process(a)) AS x, inc_in_process(inc(a)) AS y FROM nums INTO FILE();
----
3,3
12,12
102,102
