# name: udf/PythonUdf.test
# description: scalar UDFs authored in Python (nes-systests/udf/pyudfs/currency.py), executed via the CPython bridge .so
# groups: [PythonUdf]

# --- Python UDF: integer add (currency.add) ---
CREATE LOGICAL SOURCE nums(a INT64 NOT NULL, b INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR nums TYPE File;
ATTACH INLINE
1,2
10,20
100,200

CREATE FUNCTION add_py (a INT64, b INT64) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'currency.add';

SELECT a, b, add_py(a, b) AS c FROM nums INTO FILE();
----
1,2,3
10,20,30
100,200,300

# --- Python UDF: currency conversion (currency.to_euro), VARSIZED argument arrives as Python str ---
CREATE LOGICAL SOURCE bids(amount FLOAT64 NOT NULL, ccy VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR bids TYPE File;
ATTACH INLINE
100.0,EUR
100.0,USD
50.0,GBP

CREATE FUNCTION to_euro_py (amount FLOAT64, ccy VARSIZED) RETURNS FLOAT64 EXECUTION IN_PROCESS ENTRYPOINT 'currency.to_euro';

SELECT to_euro_py(amount, ccy) AS eur FROM bids INTO FILE();
----
100
80
100

# --- Python UDF: VARSIZED in and out (currency.shout) ---
CREATE LOGICAL SOURCE words(w VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR words TYPE File;
ATTACH INLINE
hello
World

CREATE FUNCTION shout_py (w VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'currency.shout';

SELECT shout_py(w) AS u FROM words INTO FILE();
----
HELLO
WORLD

# A VARSIZED value that is not UTF-8 fails the query
CREATE LOGICAL SOURCE encoded(b VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR encoded TYPE File;
ATTACH INLINE
/w==

SELECT shout_py(FROM_BASE64(b)) AS u FROM encoded INTO FILE();
----
ERROR 3007

# --- Python UDF that raises: the query fails with the UDF error code; the worker survives ---
CREATE LOGICAL SOURCE ints(x INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR ints TYPE File;
ATTACH INLINE
1
2

CREATE FUNCTION boom_py (x INT64) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'currency.boom';

SELECT boom_py(x) AS y FROM ints INTO FILE();
----
ERROR 3007

# --- NULL input (scalar): the UDF is called with None; always_42 ignores its argument, so 42 (not NULL) proves it ran ---
CREATE LOGICAL SOURCE probe(id INT64 NOT NULL, x INT64);
CREATE PHYSICAL SOURCE FOR probe TYPE File;
ATTACH INLINE
1,10
2,

CREATE FUNCTION always_42_py (x INT64) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'currency.always_42';

SELECT id, always_42_py(x) AS y FROM probe INTO FILE();
----
1,42
2,42

# --- NULL input (VARSIZED): the UDF is called with None; shout does not guard against it, so the query fails with the UDF error code ---
CREATE LOGICAL SOURCE greets(id INT64 NOT NULL, w VARSIZED);
CREATE PHYSICAL SOURCE FOR greets TYPE File;
ATTACH INLINE
1,hi
2,

CREATE FUNCTION shout_nullable_py (w VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'currency.shout';

SELECT id, shout_nullable_py(w) AS u FROM greets INTO FILE();
----
ERROR 3007

# --- UDF-produced NULL: all inputs non-NULL; half_if_even returns None for odd n, exercising the result-null path ---
CREATE LOGICAL SOURCE evens(n INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR evens TYPE File;
ATTACH INLINE
4
5
8

CREATE FUNCTION half_even_py (n INT64) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'currency.half_if_even';

SELECT half_even_py(n) AS h FROM evens INTO FILE();
----
2
NULL
4
