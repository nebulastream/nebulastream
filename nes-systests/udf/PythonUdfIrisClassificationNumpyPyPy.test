# name: udf/PythonUdfIrisClassificationNumpyPyPy.test
# description: PyPy variant of PythonUdfIrisClassificationNumpy.test (iris.onnx re-implemented in plain numpy).
# Uses nes-toolchain/python-venvs/udf-pypy; kept separate because one process holds one venv.
# groups: [PyPyUdf, PythonUDF, CompilerOnly, PythonUdfNumpy]

GLOBALCONFIGURATION worker.python_udf.venv: /home/thanasis/Documents/nes-toolchain/python-venvs/udf-pypy

CREATE LOGICAL SOURCE stream(p1 FLOAT32 NOT NULL, p2 FLOAT32 NOT NULL, p3 FLOAT32 NOT NULL, p4 FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
6.1,3.5,1.4,0.2
4.9,3.0,1.4,0.2
4.7,3.2,1.3,0.2

CREATE FUNCTION setosa_pypy (p1 FLOAT32, p2 FLOAT32, p3 FLOAT32, p4 FLOAT32) RETURNS FLOAT32 BRIDGE 'pypy' ENTRYPOINT 'iris_udf_numpy.setosa';
CREATE FUNCTION versicolor_pypy (p1 FLOAT32, p2 FLOAT32, p3 FLOAT32, p4 FLOAT32) RETURNS FLOAT32 BRIDGE 'pypy' ENTRYPOINT 'iris_udf_numpy.versicolor';
CREATE FUNCTION virginica_pypy (p1 FLOAT32, p2 FLOAT32, p3 FLOAT32, p4 FLOAT32) RETURNS FLOAT32 BRIDGE 'pypy' ENTRYPOINT 'iris_udf_numpy.virginica';

# PyPy bridge: all three class probabilities
SELECT p1, p2, p3, p4, setosa_pypy(p1, p2, p3, p4) AS setosa, versicolor_pypy(p1, p2, p3, p4) AS versicolor, virginica_pypy(p1, p2, p3, p4) AS virginica
FROM stream
INTO FILE();
----
6.1,3.5,1.4,0.2,0.946717,0.051443,0.00184
4.9,3.0,1.4,0.2,0.888224,0.103913,0.007863
4.7,3.2,1.3,0.2,0.898816,0.094172,0.007012

# PyPy bridge: same filter as InferModel.test, keep rows classified as setosa with probability > 0.9
SELECT * FROM (
    SELECT p1, p2, p3, p4, setosa_pypy(p1, p2, p3, p4) AS setosa, versicolor_pypy(p1, p2, p3, p4) AS versicolor, virginica_pypy(p1, p2, p3, p4) AS virginica
    FROM stream
) WHERE setosa > 0.9
INTO FILE();
----
6.1,3.5,1.4,0.2,0.946717,0.051443,0.00184
