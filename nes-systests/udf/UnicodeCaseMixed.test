# name: udf/UnicodeCaseMixed.test
# description: The case mappings of the unicode plugin give CPython's results for strings that mix ASCII and non-ASCII
# characters. Codon's lower(), upper() and casefold() map the ASCII bytes in one pass and only the non-ASCII characters
# with nes_unicode_map, so the strings mix ASCII letters, case-ignorable ASCII ('.', ':', "'") and capital sigmas (final
# sigma), special casings (ß, İ, ﬁ, ŉ, ΐ), combining marks and emoji. Rows 0-299 are random (Python random.seed(75),
# 1-24 characters from a fixed pool), rows 300-305 are final sigma edge cases. The expected results are CPython's
# (nes-systests/udf/pyudfs/unicode_str.py, case()).
# groups: [PythonUDF]

CREATE LOGICAL SOURCE texts(id UINT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR texts TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
