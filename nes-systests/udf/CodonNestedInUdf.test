# name: udf/CodonNestedInUdf.test
# description: a Codon UDF nested as the argument of a CPython catalog UDF;
# the outer UDF must forward setup to its children so the nested Codon function gets compiled.
# groups: [PythonUdf, PythonUDF, CompilerOnly]

CREATE LOGICAL SOURCE prices(price FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR prices TYPE File;
ATTACH INLINE
100.0
40.0

CREATE FUNCTION discount_cpython (price FLOAT64) RETURNS FLOAT64 EXECUTION IN_PROCESS ENTRYPOINT 'portable_udfs.apply_discount';

CREATE FUNCTION udf_1 (price FLOAT64) RETURNS FLOAT64 EXECUTION INLINE AS $python$
        return price * 2.0
    $python$;

SELECT discount_cpython(udf_1(price)) AS discounted FROM prices
INTO file();
----
180.0
72.0

