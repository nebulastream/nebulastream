# name: udf/UdfsDisabled.test
# description: In a build configured with NES_ENABLE_UDFS=OFF, UDF statements still parse and bind, but every query that calls a UDF fails
# groups: [UdfsDisabled]

CREATE LOGICAL SOURCE numbers(a INT64 NOT NULL, b INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR numbers TYPE File;
ATTACH INLINE
1,2

# Inline Python, compiled by Codon (the default bridge)
SELECT PYTHON((a, b): $python$
    return a + b
$python$) AS INT64 AS result
FROM numbers
INTO file();
----
ERROR UdfsNotEnabled "this build has no support for Python UDFs"

# Inline Python, run by the CPython bridge
SELECT PYTHON((a, b): $python$
    return a + b
$python$) AS INT64 BRIDGE 'cpython' AS result
FROM numbers
INTO file();
----
ERROR UdfsNotEnabled "this build has no support for Python UDFs"

# Catalog UDF: registering it succeeds, calling it does not
CREATE FUNCTION add_codon (a INT64, b INT64) RETURNS INT64 BRIDGE 'codon' ENTRYPOINT 'portable_udfs.add';

SELECT add_codon(a, b) AS result FROM numbers INTO file();
----
ERROR UdfsNotEnabled "this build has no support for user-defined functions"
