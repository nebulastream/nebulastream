# name: udf/PythonUdfVenv.test
# description: a Python UDF importing `inflection`, installed only in the in-tree venv at
# nes-systests/udf/small_venv, never system-wide, through the CPython bridge (its interpreter is process-wide, so two
# DIFFERENT venvs would collide, see PythonUdfOnnx/PythonUdfIree).
# GLOBALCONFIGURATION sets worker.python_udf.venv, so this needs no external flag. Bridge scans for
# small_venv's pythonX.Y dir instead of assuming a version match, so this is portable across
# CPython versions (inflection is pure Python).
# groups: [PythonUdfVenv]

GLOBALCONFIGURATION worker.python_udf.venv: PY_UDF_VENV_DIR

CREATE LOGICAL SOURCE names(id INT64 NOT NULL, name VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR names TYPE File;
ATTACH INLINE
1,device_type
2,active_record
3,order_item

CREATE FUNCTION camelize_cpython (name VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'venv_probe.camelize';

SELECT id, camelize_cpython(name) AS camel FROM names INTO FILE();
----
1,DeviceType
2,ActiveRecord
3,OrderItem
