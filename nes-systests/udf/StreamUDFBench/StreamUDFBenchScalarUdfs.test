# --- EXECUTION INLINE ---
# Rejected: addnoise imports random inside the function, which NES rejects for INLINE.
CREATE FUNCTION addnoise_inline (val INT32 NOT NULL) RETURNS FLOAT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.addnoise';
----
ERROR QueryCompilerError

CREATE FUNCTION clean_inline (val VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.clean';
CREATE FUNCTION cleandate_inline (pubdate VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.cleandate';
CREATE FUNCTION converttoeuro_inline (x FLOAT64 NOT NULL, y VARSIZED NOT NULL) RETURNS FLOAT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.converttoeuro';
CREATE FUNCTION extractclass_inline (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractclass';
CREATE FUNCTION extractcode_inline (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractcode';
CREATE FUNCTION extractday_inline (arg VARSIZED NOT NULL) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractday';
CREATE FUNCTION extractfunder_inline (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractfunder';
CREATE FUNCTION extractid_inline (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractid';
CREATE FUNCTION extractmonth_inline (arg VARSIZED NOT NULL) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractmonth';
CREATE FUNCTION extractprojectid_inline (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractprojectid';
CREATE FUNCTION extractyear_inline (arg VARSIZED NOT NULL) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.extractyear';
CREATE FUNCTION filterstopwords_inline (words VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.filterstopwords';
CREATE FUNCTION frequentterms_inline (input VARSIZED NOT NULL, N INT64 NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.frequentterms';
# Does not compile: type(x) == list
CREATE FUNCTION jaccard_inline (arg1 VARSIZED NOT NULL, arg2 VARSIZED NOT NULL) RETURNS FLOAT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.jaccard';
----
ERROR QueryCompilerError

CREATE FUNCTION jpack_inline (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.jpack';
CREATE FUNCTION jsoncount_inline (jval VARSIZED NOT NULL) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.jsoncount';
# Does not compile: isinstance checks the json.Value at run time, so jsonparse returns a json.Value, and Codon enforces the
# annotation -> str (udfbench_scalar_inline_adapted.py has a version that compiles)
CREATE FUNCTION jsonparse_inline (json_content VARSIZED NOT NULL, key1 VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.jsonparse';
----
ERROR QueryCompilerError

CREATE FUNCTION jsort_inline (jval VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.jsort';
CREATE FUNCTION jsortvalues_inline (jval VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.jsortvalues';
CREATE FUNCTION keywords_inline (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.keywords';
CREATE FUNCTION log_10_inline (x FLOAT64 NOT NULL) RETURNS FLOAT64 EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.log_10';
CREATE FUNCTION lowerize_inline (val VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.lowerize';
CREATE FUNCTION removeshortterms_inline (jval VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.removeshortterms';
# Does not compile: name 'ccy_exp' cannot be captured
CREATE FUNCTION stem_inline (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.stem';
----
ERROR QueryCompilerError

