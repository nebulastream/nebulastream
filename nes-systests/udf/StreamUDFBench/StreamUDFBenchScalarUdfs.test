# name: udf/StreamUDFBench/StreamUDFBenchScalarUdfs.test
# description: Each UDFBench scalar UDF in one simple query on the StreamUDFBench tiny dataset, with the UDFs in each execution:
# OUT_OF_PROCESS, IN_PROCESS and INLINE. The queries only exercise the UDFs. They are not StreamUDFBench queries.
# UDFs: nes-systests/udf/pyudfs/StreamUDFBench/scalar/<name>.py (UDFBench files, unchanged) via udfbench_scalar.py, and for INLINE
# via udfbench_scalar_inline.py, which Codon can compile. Data: nes-systests/testdata/large/streamudfbench/tiny (ExternalData).
# The arguments are NOT NULL, so a NULL argument gives a NULL result without a call, as in UDFBench, which runs the functions in
# DuckDB. The expected results are those of the UDFBench functions under CPython, applied to each row without a NULL argument.
# groups: [StreamUDFBench, PythonUdf, large]

CREATE LOGICAL SOURCE artifacts(id VARSIZED, title VARSIZED, publisher VARSIZED, journal VARSIZED, date VARSIZED, year INT32,
    access_mode VARSIZED, embargo_end_date VARSIZED, delayed BOOLEAN, authors INT32, source VARSIZED, abstract BOOLEAN,
    type VARSIZED, peer_reviewed BOOLEAN, green BOOLEAN, gold BOOLEAN, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifacts TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE large/streamudfbench/tiny/artifacts_15M.csv

CREATE LOGICAL SOURCE artifact_abstracts(id VARSIZED, abstract VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifact_abstracts TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE large/streamudfbench/tiny/artifact_abstracts_13M.csv

CREATE LOGICAL SOURCE artifact_authorlists(id VARSIZED, authorlist VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifact_authorlists TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE large/streamudfbench/tiny/artifact_authorlists_4M.csv

CREATE LOGICAL SOURCE artifact_charges(id VARSIZED, amount FLOAT64, currency VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifact_charges TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE large/streamudfbench/tiny/artifact_charges_32K.csv

CREATE LOGICAL SOURCE projects_artifacts(id VARSIZED, artifactid VARSIZED, provenance VARSIZED, funder VARSIZED, fundinginfo VARSIZED,
    startdate VARSIZED, enddate VARSIZED, amount VARSIZED, currency VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR projects_artifacts TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE large/streamudfbench/tiny/projects_artifacts_16M.csv

CREATE LOGICAL SOURCE query2json(id VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR query2json TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE large/streamudfbench/tiny/query2json_3M.csv


# --- EXECUTION OUT_OF_PROCESS ---
CREATE FUNCTION addnoise_oop (val INT32 NOT NULL) RETURNS FLOAT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.addnoise';
CREATE FUNCTION clean_oop (val VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.clean';
CREATE FUNCTION cleandate_oop (pubdate VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.cleandate';
CREATE FUNCTION converttoeuro_oop (x FLOAT64 NOT NULL, y VARSIZED NOT NULL) RETURNS FLOAT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.converttoeuro';
CREATE FUNCTION extractclass_oop (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractclass';
CREATE FUNCTION extractcode_oop (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractcode';
CREATE FUNCTION extractday_oop (arg VARSIZED NOT NULL) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractday';
CREATE FUNCTION extractfunder_oop (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractfunder';
CREATE FUNCTION extractid_oop (project VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractid';
CREATE FUNCTION extractmonth_oop (arg VARSIZED NOT NULL) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractmonth';
CREATE FUNCTION extractprojectid_oop (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractprojectid';
CREATE FUNCTION extractyear_oop (arg VARSIZED NOT NULL) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.extractyear';
CREATE FUNCTION filterstopwords_oop (words VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.filterstopwords';
CREATE FUNCTION frequentterms_oop (input VARSIZED NOT NULL, N INT64 NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.frequentterms';
CREATE FUNCTION jaccard_oop (arg1 VARSIZED NOT NULL, arg2 VARSIZED NOT NULL) RETURNS FLOAT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.jaccard';
CREATE FUNCTION jpack_oop (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.jpack';
CREATE FUNCTION jsoncount_oop (jval VARSIZED NOT NULL) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.jsoncount';
CREATE FUNCTION jsonparse_oop (json_content VARSIZED NOT NULL, key1 VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.jsonparse';
CREATE FUNCTION jsort_oop (jval VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.jsort';
CREATE FUNCTION jsortvalues_oop (jval VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.jsortvalues';
CREATE FUNCTION keywords_oop (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.keywords';
CREATE FUNCTION log_10_oop (x FLOAT64 NOT NULL) RETURNS FLOAT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.log_10';
CREATE FUNCTION lowerize_oop (val VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.lowerize';
CREATE FUNCTION removeshortterms_oop (jval VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.removeshortterms';
CREATE FUNCTION stem_oop (input VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'StreamUDFBench.udfbench_scalar.stem';

