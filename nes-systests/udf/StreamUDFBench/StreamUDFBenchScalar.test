# Q20: clean the artifact dates; the batch UPDATE becomes a map that emits the updated artifacts (per row, no window)
SELECT id, title, publisher, journal, cleandate(date) AS date, year, access_mode, embargo_end_date, delayed, authors,
       source, abstract, type, peer_reviewed, green, gold, ts
FROM artifacts
INTO Checksum();
