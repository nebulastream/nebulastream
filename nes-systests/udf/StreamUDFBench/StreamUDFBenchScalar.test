# name: udf/StreamUDFBench/StreamUDFBenchScalar.test
# description: StreamUDFBench queries that use only scalar Python UDFs (Q1, Q20, Q8), on the tiny dataset.
# UDFs: nes-systests/udf/pyudfs/StreamUDFBench/streamudfbench_scalar.py, data: nes-systests/testdata/streamudfbench/tiny.
# Data files are tab-separated and unquoted, with an event-time column ts (epoch ms) last and rows sorted by ts.
# Expected results were computed independently in Python with the same UDF code.
# groups: [StreamUDFBench, PythonUdf]

CREATE LOGICAL SOURCE artifacts(id VARSIZED, title VARSIZED, publisher VARSIZED, journal VARSIZED, date VARSIZED, year INT32,
    access_mode VARSIZED, embargo_end_date VARSIZED, delayed BOOLEAN, authors INT32, source VARSIZED, abstract BOOLEAN,
    type VARSIZED, peer_reviewed BOOLEAN, green BOOLEAN, gold BOOLEAN, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifacts TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE streamudfbench/tiny/artifacts.csv

CREATE LOGICAL SOURCE artifact_citations(artifactid VARSIZED, target VARSIZED, citcount INT64, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifact_citations TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE streamudfbench/tiny/artifact_citations.csv

CREATE LOGICAL SOURCE artifact_authorlists(artifactid VARSIZED, authorlist VARSIZED, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR artifact_authorlists TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH FILE streamudfbench/tiny/artifact_authorlists.csv

CREATE FUNCTION extractyear (arg VARSIZED) RETURNS INT64 BRIDGE 'pypy' ENTRYPOINT 'StreamUDFBench.streamudfbench_scalar.extractyear';
CREATE FUNCTION extractmonth (arg VARSIZED) RETURNS INT64 BRIDGE 'pypy' ENTRYPOINT 'StreamUDFBench.streamudfbench_scalar.extractmonth';
CREATE FUNCTION extractday (arg VARSIZED) RETURNS INT64 BRIDGE 'pypy' ENTRYPOINT 'StreamUDFBench.streamudfbench_scalar.extractday';
CREATE FUNCTION cleandate (pubdate VARSIZED) RETURNS VARSIZED BRIDGE 'pypy' ENTRYPOINT 'StreamUDFBench.streamudfbench_scalar.cleandate';
CREATE FUNCTION jsoncount (jval VARSIZED) RETURNS INT64 BRIDGE 'pypy' ENTRYPOINT 'StreamUDFBench.streamudfbench_scalar.jsoncount';

# Q1: extract year, month and day from the artifact date with three scalar UDFs (per row, no window)
SELECT id, extractyear(date) AS year, extractmonth(date) AS month, extractday(date) AS "DAY"
FROM artifacts
INTO Checksum();
----
48448 198867517

# Q8 (interim, native AVG until aggregate UDFs exist): average citation and author count of artifacts that have both,
# per 30-day tumbling window. Both streams carry the parent artifact's ts, so the join on artifactid matches in-window.
SELECT start, end, AVG(n_citations) AS avg_citations, AVG(n_authors) AS avg_authors
FROM (SELECT jsoncount(target) AS n_citations, jsoncount(authorlist) AS n_authors, start AS join_start
      FROM (SELECT artifactid AS c_artifactid, target, ts AS c_ts FROM artifact_citations)
      INNER JOIN (SELECT artifactid AS a_artifactid, authorlist, ts AS a_ts FROM artifact_authorlists)
      ON c_artifactid = a_artifactid
      WINDOW TUMBLING(c_ts, a_ts, SIZE 30 DAYS))
WINDOW TUMBLING(join_start, SIZE 30 DAYS)
INTO FILE();
