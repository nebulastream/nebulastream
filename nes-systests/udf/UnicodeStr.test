# Each code point of Unicode: a digest of its character classes, case mappings and repr, per block of 256 code points.
# The expected digests are CPython's. Only INLINE runs this query: CPython needs about 15 s for all code points.
CREATE LOGICAL SOURCE blocks(first INT64 NOT NULL, last INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR blocks TYPE File;
ATTACH INLINE
