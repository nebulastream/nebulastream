# name: udf/UnicodeStr.test
# description: str operations on non-ASCII text give CPython's results in EXECUTION INLINE too. Codon's str holds UTF-8 bytes;
# the str methods of the unicode plugin (nes-python-udf/codon-plugins/unicode) work on code points, as CPython's do.
# Each UDF applies a group of operations to its argument (nes-systests/udf/pyudfs/unicode_str.py). The expected results
# are CPython's, so the IN_PROCESS queries check them and the INLINE queries check Codon.
# groups: [PythonUDF]

# A UDF call allocates its temporary strings in the arena of its input buffer, and the code point digests below allocate
# about 40 MB per buffer. One worker thread keeps one such arena at a time within the default memory.
GlobalConfiguration worker.query_engine.number_of_worker_threads: [1]

CREATE LOGICAL SOURCE texts(id UINT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR texts TYPE File SET('\t' AS INPUT_FORMATTER.FIELD_DELIMITER, false AS INPUT_FORMATTER.ALLOW_COMMAS_IN_STRINGS);
ATTACH INLINE
0	Hello World 123
1	ὈΔΥΣΣΕΎΣ ΣΑΣ ΟΔΟΣ.
2	straße ﬁx ǅemal
3	İstanbul ıi İİ
4	naïve café  résumé
5	été combining
6	日本語テキスト 漢字
7	emoji 😀👍🏽 ok
8	١٢٣ ²³ ½ Ⅻ 42
9	thin space　ideo nbspnel
10	ŉ ΐ ǰ ﬃ
11	line sep parafs

CREATE FUNCTION indexing_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.indexing';
CREATE FUNCTION case_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.case';
CREATE FUNCTION classes_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.classes';
CREATE FUNCTION search_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.search';
CREATE FUNCTION splitting_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.splitting';
CREATE FUNCTION padding_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.padding';
CREATE FUNCTION characters_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.characters';
CREATE FUNCTION regex_cpython (s VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'unicode_str.regex';

