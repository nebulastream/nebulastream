CREATE FUNCTION indexing_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.indexing';
CREATE FUNCTION case_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.case';
CREATE FUNCTION classes_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.classes';
CREATE FUNCTION search_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.search';
CREATE FUNCTION splitting_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.splitting';
CREATE FUNCTION padding_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.padding';
CREATE FUNCTION characters_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.characters';
CREATE FUNCTION regex_codon (s VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'unicode_str.regex';

