# name: udf/PythonUdfVarsizedTypes.test
# description: BYTES in CREATE FUNCTION chooses if a VARSIZED or CHAR argument arrives as str (UTF-8, the default) or bytes (raw)
# groups: [PythonUdf, PythonUdfProcess]

# 0xC3 0xA4 is the UTF-8 encoding of a single character
CREATE LOGICAL SOURCE text(b VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR text TYPE File;
ATTACH INLINE
w6Q=

# 0xFF is not valid UTF-8
CREATE LOGICAL SOURCE binary(b VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR binary TYPE File;
ATTACH INLINE
/w==

CREATE LOGICAL SOURCE nullable(d INT64, b VARSIZED);
CREATE PHYSICAL SOURCE FOR nullable TYPE File;
ATTACH INLINE
1,

# --- EXECUTION IN_PROCESS ---
CREATE FUNCTION text_length_ip (x VARSIZED) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.text_length';
CREATE FUNCTION byte_length_ip (x VARSIZED BYTES) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.byte_length';
CREATE FUNCTION optional_byte_length_ip (x VARSIZED BYTES) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.optional_byte_length';
CREATE FUNCTION unmarked_byte_length_ip (x VARSIZED) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.byte_length';
CREATE FUNCTION type_name_bytes_ip (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.type_name';
CREATE FUNCTION type_name_ip (x VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.type_name';
CREATE FUNCTION echo_bytes_ip (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.echo_bytes';
CREATE FUNCTION describe_ip (x VARSIZED BYTES, y VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.describe';
CREATE FUNCTION body_type_name_ip (x VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS AS $python$
    return type(x).__name__
$python$;
CREATE FUNCTION body_type_name_bytes_ip (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION IN_PROCESS AS $python$
    return type(x).__name__
$python$;

SELECT text_length_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
1

SELECT byte_length_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
2

SELECT optional_byte_length_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
2

# Only the declaration decides: without BYTES, a function annotated with bytes gets a str
SELECT unmarked_byte_length_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
1

# BYTES also applies to a function without annotations and to a body
SELECT type_name_bytes_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
bytes

SELECT body_type_name_bytes_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
bytes

SELECT optional_byte_length_ip(b) AS r FROM nullable INTO FILE();
----
NULL

SELECT type_name_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
str

SELECT body_type_name_ip(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
str

SELECT byte_length_ip(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
1

SELECT TO_BASE64(echo_bytes_ip(FROM_BASE64(b))) AS r FROM binary INTO FILE();
----
/w==

SELECT text_length_ip(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
ERROR 3007

SELECT type_name_ip(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
ERROR 3007

# BYTES applies to each argument on its own, also to a constant
SELECT describe_ip(FROM_BASE64(b), 'abc') AS r FROM binary INTO FILE();
----
1/abc

SELECT describe_ip('abc', 'def') AS r FROM binary INTO FILE();
----
3/def

SELECT type_name_ip('abc') AS r FROM binary INTO FILE();
----
str

# --- EXECUTION OUT_OF_PROCESS ---
CREATE FUNCTION text_length_oop (x VARSIZED) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.text_length';
CREATE FUNCTION byte_length_oop (x VARSIZED BYTES) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.byte_length';
CREATE FUNCTION optional_byte_length_oop (x VARSIZED BYTES) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.optional_byte_length';
CREATE FUNCTION unmarked_byte_length_oop (x VARSIZED) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.byte_length';
CREATE FUNCTION type_name_bytes_oop (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.type_name';
CREATE FUNCTION type_name_oop (x VARSIZED) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.type_name';
CREATE FUNCTION echo_bytes_oop (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.echo_bytes';
CREATE FUNCTION describe_oop (x VARSIZED BYTES, y VARSIZED) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.describe';
CREATE FUNCTION body_type_name_oop (x VARSIZED) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS AS $python$
    return type(x).__name__
$python$;
CREATE FUNCTION body_type_name_bytes_oop (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION OUT_OF_PROCESS AS $python$
    return type(x).__name__
$python$;

SELECT text_length_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
1

SELECT byte_length_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
2

SELECT optional_byte_length_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
2

# Only the declaration decides: without BYTES, a function annotated with bytes gets a str
SELECT unmarked_byte_length_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
1

# BYTES also applies to a function without annotations and to a body
SELECT type_name_bytes_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
bytes

SELECT body_type_name_bytes_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
bytes

SELECT optional_byte_length_oop(b) AS r FROM nullable INTO FILE();
----
NULL

SELECT type_name_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
str

SELECT body_type_name_oop(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
str

SELECT byte_length_oop(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
1

SELECT TO_BASE64(echo_bytes_oop(FROM_BASE64(b))) AS r FROM binary INTO FILE();
----
/w==

SELECT text_length_oop(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
ERROR 3007

SELECT type_name_oop(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
ERROR 3007

# BYTES applies to each argument on its own, also to a constant
SELECT describe_oop(FROM_BASE64(b), 'abc') AS r FROM binary INTO FILE();
----
1/abc

SELECT describe_oop('abc', 'def') AS r FROM binary INTO FILE();
----
3/def

SELECT type_name_oop('abc') AS r FROM binary INTO FILE();
----
str

# --- EXECUTION INLINE ---
# An INLINE body receives an argument as declared: Optional unless NOT NULL. The type names below are those of NOT NULL
# arguments.
# A str counts code points and must hold valid UTF-8, as in the Python modes (unicode plugin, nes_compat.codon).
# Only the declaration decides, as in the Python modes: an argument declared with BYTES arrives as bytes, any other as a str.
CREATE FUNCTION text_length_inline (x VARSIZED) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'varsized_types.text_length';
CREATE FUNCTION byte_length_inline (x VARSIZED BYTES) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'varsized_types.byte_length';
CREATE FUNCTION optional_byte_length_inline (x VARSIZED BYTES) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'varsized_types.optional_byte_length';
CREATE FUNCTION echo_bytes_inline (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'varsized_types.echo_bytes';
CREATE FUNCTION describe_inline (x VARSIZED BYTES, y VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'varsized_types.describe';
CREATE FUNCTION type_name_bytes_inline (x VARSIZED NOT NULL BYTES) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'varsized_types.type_name';
CREATE FUNCTION type_name_inline (x VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'varsized_types.type_name';
CREATE FUNCTION body_type_name_inline (x VARSIZED NOT NULL) RETURNS VARSIZED EXECUTION INLINE AS $python$
    return type(x).__name__
$python$;
CREATE FUNCTION body_type_name_bytes_inline (x VARSIZED NOT NULL BYTES) RETURNS VARSIZED EXECUTION INLINE AS $python$
    return type(x).__name__
$python$;

SELECT text_length_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
1

SELECT text_length_inline(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
ERROR 3007

SELECT byte_length_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
2

SELECT optional_byte_length_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
2

SELECT optional_byte_length_inline(b) AS r FROM nullable INTO FILE();
----
NULL

SELECT TO_BASE64(echo_bytes_inline(FROM_BASE64(b))) AS r FROM binary INTO FILE();
----
/w==

SELECT describe_inline(FROM_BASE64(b), 'abc') AS r FROM binary INTO FILE();
----
1/abc

SELECT describe_inline('abc', 'def') AS r FROM binary INTO FILE();
----
3/def

SELECT byte_length_inline(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
1

# BYTES also applies to a function without annotations and to a body
SELECT type_name_bytes_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
bytes

SELECT body_type_name_bytes_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
bytes

SELECT type_name_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
str

SELECT body_type_name_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
str

# Without BYTES, a value that is not valid UTF-8 is an error, also for a body
SELECT body_type_name_inline(FROM_BASE64(b)) AS r FROM binary INTO FILE();
----
ERROR 3007

# A body returns str or bytes for a VARSIZED result, as in the Python modes
CREATE FUNCTION body_echo_bytes_inline (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION INLINE AS $python$
    return x
$python$;
CREATE FUNCTION body_bytes_or_none_inline (x VARSIZED BYTES) RETURNS VARSIZED EXECUTION INLINE AS $python$
    if len(x) > 1:
        return None
    return x + x
$python$;
CREATE FUNCTION body_encode_inline (x VARSIZED) RETURNS VARSIZED EXECUTION INLINE AS $python$
    return (x + "!").encode()
$python$;
CREATE FUNCTION body_text_or_none_inline (x VARSIZED) RETURNS VARSIZED EXECUTION INLINE AS $python$
    if len(x) > 1:
        return None
    return x + "?"
$python$;

SELECT TO_BASE64(body_echo_bytes_inline(FROM_BASE64(b))) AS r FROM binary INTO FILE();
----
/w==

SELECT TO_BASE64(body_bytes_or_none_inline(FROM_BASE64(b))) AS r FROM binary INTO FILE();
----
//8=

SELECT body_bytes_or_none_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
NULL

SELECT body_encode_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
ä!

SELECT body_text_or_none_inline(FROM_BASE64(b)) AS r FROM text INTO FILE();
----
ä?


# --- CHAR ---
# A CHAR is one byte. It arrives like a one-byte VARSIZED value, as a one-character str or with BYTES as bytes, and a CHAR result is a
# str or bytes of exactly one byte.
CREATE LOGICAL SOURCE chars(c CHAR NOT NULL, n CHAR);
CREATE PHYSICAL SOURCE FOR chars TYPE File;
ATTACH INLINE
a,b
Z,

# CHAR, EXECUTION IN_PROCESS
CREATE FUNCTION char_code_ip (x CHAR) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.char_code';
CREATE FUNCTION optional_char_code_ip (x CHAR) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.optional_char_code';
CREATE FUNCTION char_byte_ip (x CHAR BYTES) RETURNS INT64 EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.char_byte';
CREATE FUNCTION next_char_ip (x CHAR) RETURNS CHAR EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.next_char';
CREATE FUNCTION char_from_bytes_ip (x CHAR BYTES) RETURNS CHAR EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.char_from_bytes';
CREATE FUNCTION too_long_ip (x CHAR) RETURNS CHAR EXECUTION IN_PROCESS ENTRYPOINT 'varsized_types.too_long';
CREATE FUNCTION body_upper_ip (x CHAR) RETURNS CHAR EXECUTION IN_PROCESS AS $python$
    return x.upper()
$python$;

SELECT char_code_ip(c) AS r FROM chars INTO FILE();
----
97
90

SELECT optional_char_code_ip(n) AS r FROM chars INTO FILE();
----
98
NULL

SELECT char_byte_ip(c) AS r FROM chars INTO FILE();
----
97
90

SELECT next_char_ip(c) AS r, char_from_bytes_ip(c) AS s, body_upper_ip(c) AS t FROM chars INTO FILE();
----
b,a,A
[,Z,Z

SELECT too_long_ip(c) AS r FROM chars INTO FILE();
----
ERROR 3007

# CHAR, EXECUTION OUT_OF_PROCESS
CREATE FUNCTION char_code_oop (x CHAR) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.char_code';
CREATE FUNCTION optional_char_code_oop (x CHAR) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.optional_char_code';
CREATE FUNCTION char_byte_oop (x CHAR BYTES) RETURNS INT64 EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.char_byte';
CREATE FUNCTION next_char_oop (x CHAR) RETURNS CHAR EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.next_char';
CREATE FUNCTION char_from_bytes_oop (x CHAR BYTES) RETURNS CHAR EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.char_from_bytes';
CREATE FUNCTION too_long_oop (x CHAR) RETURNS CHAR EXECUTION OUT_OF_PROCESS ENTRYPOINT 'varsized_types.too_long';
CREATE FUNCTION body_upper_oop (x CHAR) RETURNS CHAR EXECUTION OUT_OF_PROCESS AS $python$
    return x.upper()
$python$;

SELECT char_code_oop(c) AS r FROM chars INTO FILE();
----
97
90

SELECT optional_char_code_oop(n) AS r FROM chars INTO FILE();
----
98
NULL

SELECT char_byte_oop(c) AS r FROM chars INTO FILE();
----
97
90

SELECT next_char_oop(c) AS r, char_from_bytes_oop(c) AS s, body_upper_oop(c) AS t FROM chars INTO FILE();
----
b,a,A
[,Z,Z

SELECT too_long_oop(c) AS r FROM chars INTO FILE();
----
ERROR 3007

# CHAR, EXECUTION INLINE
CREATE FUNCTION char_code_inline (x CHAR) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'varsized_types.char_code';
CREATE FUNCTION optional_char_code_inline (x CHAR) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'varsized_types.optional_char_code';
CREATE FUNCTION char_byte_inline (x CHAR BYTES) RETURNS INT64 EXECUTION INLINE ENTRYPOINT 'varsized_types.char_byte';
CREATE FUNCTION next_char_inline (x CHAR) RETURNS CHAR EXECUTION INLINE ENTRYPOINT 'varsized_types.next_char';
CREATE FUNCTION char_from_bytes_inline (x CHAR BYTES) RETURNS CHAR EXECUTION INLINE ENTRYPOINT 'varsized_types.char_from_bytes';
CREATE FUNCTION too_long_inline (x CHAR) RETURNS CHAR EXECUTION INLINE ENTRYPOINT 'varsized_types.too_long';
CREATE FUNCTION body_upper_inline (x CHAR) RETURNS CHAR EXECUTION INLINE AS $python$
    return x.upper()
$python$;
CREATE FUNCTION body_char_bytes_inline (x CHAR BYTES) RETURNS CHAR EXECUTION INLINE AS $python$
    return x.upper()
$python$;

SELECT char_code_inline(c) AS r FROM chars INTO FILE();
----
97
90

SELECT optional_char_code_inline(n) AS r FROM chars INTO FILE();
----
98
NULL

SELECT char_byte_inline(c) AS r FROM chars INTO FILE();
----
97
90

SELECT next_char_inline(c) AS r, char_from_bytes_inline(c) AS s, body_upper_inline(c) AS t FROM chars INTO FILE();
----
b,a,A
[,Z,Z

# A body returns str or bytes for a CHAR result
SELECT body_char_bytes_inline(c) AS r FROM chars INTO FILE();
----
A
Z

SELECT too_long_inline(c) AS r FROM chars INTO FILE();
----
ERROR 3007
