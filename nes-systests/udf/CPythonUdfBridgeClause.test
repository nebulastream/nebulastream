# name: udf/CPythonUdfBridgeClause.test
# description: scalar UDFs registered via BRIDGE 'cpython' (auto-resolved bridge path, no FROM clause)
# groups: [PythonUdf]

# --- CPython UDF via BRIDGE, no FROM: the bridge path is auto-resolved ---
CREATE LOGICAL SOURCE nums(a INT64 NOT NULL, b INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR nums TYPE File;
ATTACH INLINE
1,2
10,20
100,200

CREATE FUNCTION add_cpython_bridge (a INT64, b INT64) RETURNS INT64 BRIDGE 'cpython' ENTRYPOINT 'currency.add';

SELECT a, b, add_cpython_bridge(a, b) AS c FROM nums INTO FILE();
----
1,2,3
10,20,30
100,200,300

# --- A BRIDGE-resolved UDF that raises still fails with the UDF error code, same as FROM-resolved ---
CREATE LOGICAL SOURCE ints(x INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR ints TYPE File;
ATTACH INLINE
1
2

CREATE FUNCTION boom_cpython_bridge (x INT64) RETURNS INT64 BRIDGE 'cpython' ENTRYPOINT 'currency.boom';

SELECT boom_cpython_bridge(x) AS y FROM ints INTO FILE();
----
ERROR 3007
