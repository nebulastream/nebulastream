# name: udf/CodonOrder.test
# description: Results that depend on the order of a dict or on the order of equal elements in a sort are the same in
# EXECUTION INLINE (Codon) as in CPython. A dict keeps the insertion order (Python 3.7), popitem removes the last item,
# sorted and list.sort are stable also with reverse=True, and Counter.most_common and heapq.nlargest give equal counts in
# the order of first occurrence. Each UDF runs a sequence of operations chosen by the seed and returns the items in their
# order (nes-systests/udf/pyudfs/dict_order.py). The IN_PROCESS queries give CPython's checksum, the INLINE queries
# must give the same.
# groups: [PythonUdf]

CREATE LOGICAL SOURCE seeds(seed INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR seeds TYPE File;
ATTACH INLINE
