CREATE FUNCTION fuzz_cpython (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'dict_order.fuzz';
CREATE FUNCTION fuzz_inline (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'dict_order.fuzz';
CREATE FUNCTION strings_cpython (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'dict_order.strings';
CREATE FUNCTION strings_inline (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'dict_order.strings';
CREATE FUNCTION counter_cpython (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'dict_order.counter';
CREATE FUNCTION counter_inline (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'dict_order.counter';
CREATE FUNCTION sorting_cpython (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'dict_order.sorting';
CREATE FUNCTION sorting_inline (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'dict_order.sorting';
CREATE FUNCTION grow_cpython (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION IN_PROCESS ENTRYPOINT 'dict_order.grow';
CREATE FUNCTION grow_inline (seed INT64 NOT NULL) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'dict_order.grow';

SELECT seed, fuzz_cpython(seed) AS r FROM seeds INTO Checksum();
----
100 7480824

SELECT seed, fuzz_inline(seed) AS r FROM seeds INTO Checksum();
----
100 7480824

SELECT seed, strings_cpython(seed) AS r FROM seeds INTO Checksum();
----
100 6077049

SELECT seed, strings_inline(seed) AS r FROM seeds INTO Checksum();
----
100 6077049

SELECT seed, counter_cpython(seed) AS r FROM seeds INTO Checksum();
----
100 2845355

SELECT seed, counter_inline(seed) AS r FROM seeds INTO Checksum();
----
100 2845355

SELECT seed, sorting_cpython(seed) AS r FROM seeds INTO Checksum();
----
100 463698

SELECT seed, sorting_inline(seed) AS r FROM seeds INTO Checksum();
----
100 463698

SELECT seed, grow_cpython(seed) AS r FROM seeds INTO Checksum();
----
100 1056832

SELECT seed, grow_inline(seed) AS r FROM seeds INTO Checksum();
----
100 1056832
