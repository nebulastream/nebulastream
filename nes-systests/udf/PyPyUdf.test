# name: udf/PyPyUdf.test
# description: scalar UDFs registered via BRIDGE 'pypy', same contract as the PythonUdf group but resolved to the PyPy bridge
# groups: [PyPyUdf]

# --- PyPy UDF via BRIDGE, no FROM: the bridge path is auto-resolved ---
CREATE LOGICAL SOURCE nums(a INT64 NOT NULL, b INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR nums TYPE File;
ATTACH INLINE
1,2
10,20
100,200

CREATE FUNCTION add_pypy (a INT64, b INT64) RETURNS INT64 BRIDGE 'pypy' ENTRYPOINT 'currency.add';

SELECT a, b, add_pypy(a, b) AS c FROM nums INTO FILE();
----
1,2,3
10,20,30
100,200,300

# --- A BRIDGE-resolved UDF that raises still fails the query with the UDF error code; the worker
# survives -- proving containment is unaffected by which bridge/interpreter is behind the ABI ---
CREATE LOGICAL SOURCE ints(x INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR ints TYPE File;
ATTACH INLINE
1
2

CREATE FUNCTION boom_pypy (x INT64) RETURNS INT64 BRIDGE 'pypy' ENTRYPOINT 'currency.boom';

SELECT boom_pypy(x) AS y FROM ints INTO FILE();
----
ERROR 3007
