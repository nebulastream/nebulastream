# name: udf/PythonUdfLogisticScorePyPyLarge.test
# description: PyPy variant of PythonUdfLogisticScoreLarge.test (numpy logistic-regression score on Nexmark bids).
# Needs numpy in a PyPy venv (nes-toolchain/python-venvs/udf-pypy, set below); kept separate because one process
# holds one venv, and a CPython-built numpy cannot load into PyPy.
# groups: [PyPyUdf, PythonUDF, CompilerOnly, large]

GLOBALCONFIGURATION worker.python_udf.venv: /home/thanasis/Documents/nes-toolchain/python-venvs/udf-pypy

CREATE LOGICAL SOURCE bidLarge(timestamp UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, datetime INT64 NOT NULL, price FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR bidLarge TYPE File;
ATTACH FILE large/nexmark/bid_653M.csv

CREATE FUNCTION logistic_score_pypy (price FLOAT64, datetime INT64, auctionId INT32, bidder INT32) RETURNS FLOAT64 BRIDGE 'pypy' ENTRYPOINT 'expensive_udfs.logistic_score';

# PyPy bridge, filter on UDF OUTPUT
SELECT auctionId, bidder FROM (
    SELECT auctionId, bidder, logistic_score_pypy(price, datetime, auctionId, bidder) AS score FROM bidLarge
) WHERE (auctionId = 999994 AND bidder = 126934 AND ABS(score - 0.8903934199230211) < 0.000000001)
     OR (auctionId = 999994 AND bidder = 23774 AND ABS(score - 0.6268856016812011) < 0.000000001)
INTO FILE();
----
999994,126934
999994,23774
