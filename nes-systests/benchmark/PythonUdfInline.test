# name: benchmark/PythonUdfInline.test
# description: Throughput of INLINE (Codon) UDFs, from cheap ones to UDFs that allocate per row (strings, lists, numpy arrays),
# where Codon's own LLVM passes (AllocationRemover, AllocationHoister) can matter. Every row goes through the UDF and the
# result into a Void sink. Inputs as in benchmark/PythonUdf.test (nes-systests/benchmark/generate_udf_bench_input.py).
# groups: [benchmark, large, PythonUdf]

CREATE LOGICAL SOURCE rows30m(id INT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR rows30m TYPE File;
ATTACH FILE udf/udf_bench.csv

CREATE LOGICAL SOURCE rows3m(id INT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR rows3m TYPE File;
ATTACH FILE udf/udf_bench_3m.csv

CREATE LOGICAL SOURCE rows1m(id INT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR rows1m TYPE File;
ATTACH FILE udf/udf_bench_1m.csv

CREATE FUNCTION inc_inline (x INT64) RETURNS INT64 EXECUTION INLINE AS $python$
    return x + 1
$python$;

CREATE FUNCTION upper_inline (x VARSIZED) RETURNS VARSIZED EXECUTION INLINE AS $python$
    return x.upper()
$python$;

CREATE FUNCTION lcg_inline (x INT64) RETURNS INT64 EXECUTION INLINE AS $python$
    h = x
    for _ in range(100):
        h = (h * 1103515245 + 12345) % 2147483648
    return h
$python$;

# A list and four strings per row
CREATE FUNCTION chunks_inline (x VARSIZED) RETURNS VARSIZED EXECUTION INLINE AS $python$
    return "-".join(sorted([x[i:i + 4] for i in range(0, len(x), 4)]))
$python$;

# UDFBench clean: string splitting and joining
CREATE FUNCTION clean_inline (x VARSIZED) RETURNS VARSIZED EXECUTION INLINE ENTRYPOINT 'StreamUDFBench.udfbench_scalar_inline.clean';

# Two small numpy arrays per row
CREATE FUNCTION score_inline (a INT64, b INT64) RETURNS FLOAT64 EXECUTION INLINE ENTRYPOINT 'cb_numpy.score';

SELECT *, inc_inline(id) AS r FROM rows30m INTO Void();
----

SELECT *, upper_inline(s) AS r FROM rows30m INTO Void();
----

SELECT *, lcg_inline(id) AS r FROM rows30m INTO Void();
----

SELECT *, chunks_inline(s) AS r FROM rows30m INTO Void();
----

SELECT *, clean_inline(s) AS r FROM rows3m INTO Void();
----

SELECT *, score_inline(id, id) AS r FROM rows30m INTO Void();
----
