# name: benchmark/PythonUdfInterpreters.test
# description: IN_PROCESS Python UDFs that dominate the cost of each row, to compare the interpreters a worker thread can run them in
# (worker.default_query_execution.in_process_udf_interpreter: SHARED, SUBINTERPRETER, DLMOPEN, FREE_THREADED) at different numbers of
# worker threads, see nes-python-udf/benchmark/harness/interpreter_scaling.py. Uses the inputs of benchmark/PythonUdf.test.
# groups: [benchmark, large, PythonUdf]


CREATE LOGICAL SOURCE rows3m(id INT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR rows3m TYPE File;
ATTACH FILE udf/udf_bench_3m.csv

CREATE LOGICAL SOURCE rows1m(id INT64 NOT NULL, s VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR rows1m TYPE File;
ATTACH FILE udf/udf_bench_1m.csv

CREATE FUNCTION inc_ip (x INT64) RETURNS INT64 EXECUTION IN_PROCESS AS $python$
    return x + 1
$python$;

CREATE FUNCTION upper_ip (x VARSIZED) RETURNS VARSIZED EXECUTION IN_PROCESS AS $python$
    return x.upper()
$python$;

CREATE FUNCTION lcg_ip (x INT64) RETURNS INT64 EXECUTION IN_PROCESS AS $python$
    h = x
    for _ in range(20):
        h = (h * 1103515245 + 12345) % 2147483648
    return h
$python$;

# Builds a list and a dict per row, so that allocation and the garbage collector take part
CREATE FUNCTION words_ip (x VARSIZED) RETURNS INT64 EXECUTION IN_PROCESS AS $python$
    counts = {}
    for word in x.split("a"):
        counts[word] = counts.get(word, 0) + 1
    return len(counts)
$python$;

# Scanning the input without a UDF
SELECT *, id + INT64(1) AS r FROM rows3m INTO Void();
----

SELECT *, inc_ip(id) AS r FROM rows3m INTO Void();
----

SELECT *, upper_ip(s) AS r FROM rows3m INTO Void();
----

SELECT *, lcg_ip(id) AS r FROM rows1m INTO Void();
----

SELECT *, words_ip(s) AS r FROM rows1m INTO Void();
----
