# name: milestone/Nexmark_with_varsized.test
# description: Nexmark benchmark taken from https://github.com/nexmark/nexmark/tree/master/nexmark-flink/src/main/resources/queries
# We have used https://github.com/risingwavelabs/nexmark-rs to generate the source csv files
# groups: [milestone, benchmark, large, Aggregation, Join]

# Source definition. We have removed some columns that are not needed in our queries
CREATE LOGICAL SOURCE bid(timestamp_bid UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, price FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR bid TYPE File;
ATTACH FILE large/nexmark/bid_6GB.csv

CREATE LOGICAL SOURCE auction(timestamp_auction UINT64 NOT NULL, id INT32 NOT NULL, initialbid INT32 NOT NULL, reserve INT32 NOT NULL, expires UINT64 NOT NULL, seller INT32 NOT NULL, category INT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR auction TYPE File;
ATTACH FILE large/nexmark/auction_707MB.csv

CREATE LOGICAL SOURCE person(id INT32 NOT NULL, name VARSIZED NOT NULL, email_address VARSIZED NOT NULL, credit_card VARSIZED NOT NULL, city VARSIZED NOT NULL, state VARSIZED NOT NULL, timestamp_person UINT64 NOT NULL, extra VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR person TYPE File;
ATTACH FILE large/nexmark/person_840MB.csv

CREATE SINK bidCheckSum(timestamp_bid UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, price FLOAT64 NOT NULL)  TYPE Checksum;
CREATE SINK q1CheckSum(timestamp_bid UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, price FLOAT64 NOT NULL)  TYPE Checksum;
CREATE SINK q2CheckSum(auctionId INT32 NOT NULL, price FLOAT64 NOT NULL)  TYPE Checksum;
CREATE SINK q5Checksum(start UINT64 NOT NULL, end UINT64 NOT NULL, auctionId INT32 NOT NULL, num INT64 NOT NULL, max_tmp INT64)  TYPE Checksum;
CREATE SINK q8CheckSum(start UINT64 NOT NULL, end UINT64 NOT NULL, id INT32 NOT NULL, name VARSIZED NOT NULL)  TYPE Checksum;
CREATE SINK q8VariantCheckSum(start UINT64 NOT NULL, end UINT64 NOT NULL, timestamp_bid UINT64 NOT NULL, auctionId INT32 NOT NULL, bidder INT32 NOT NULL, price FLOAT64 NOT NULL, timestamp_auction UINT64 NOT NULL, id INT32 NOT NULL, initialbid INT32 NOT NULL, reserve INT32 NOT NULL, expires UINT64 NOT NULL, seller INT32 NOT NULL, category INT32 NOT NULL)  TYPE Checksum;


# Query 0
SELECT * FROM bid INTO bidCheckSum;
----
183991721 353216217968

# Query 1
SELECT timestamp_bid, auctionId, bidder, price * 908 / 1000 AS price FROM bid INTO q1CheckSum;
----
183991721 370730288260

# Query 2
SELECT auctionId, price FROM bid WHERE auctionId % 123 = 0 INTO q2CheckSum;
----
1511777 1211558031

# Query 5
SELECT a.window_start AS "START", a.window_end AS "END", a.auctionId, a.num, b.max_tmp
FROM (SELECT * FROM TABLE(TUMBLE(
        (SELECT auctionId, COUNT(auctionId) AS num, window_start AS auction_start, window_end AS auction_end
         FROM TABLE(HOP(TABLE bid, DESCRIPTOR(timestamp_bid), INTERVAL '2' SECOND, INTERVAL '10' SECOND))
         GROUP BY window_start, window_end, auctionId),
        DESCRIPTOR(auction_start), INTERVAL '2' SECOND))) AS a
INNER JOIN (SELECT * FROM TABLE(TUMBLE(
        (SELECT MAX(num_ids) AS max_tmp, window_start AS bid_start, window_end AS bid_end
         FROM TABLE(TUMBLE(
                (SELECT auctionId, COUNT(auctionId) AS num_ids, window_start AS "START"
                 FROM TABLE(HOP(TABLE bid, DESCRIPTOR(timestamp_bid), INTERVAL '2' SECOND, INTERVAL '10' SECOND))
                 GROUP BY window_start, window_end, auctionId),
                DESCRIPTOR("START"), INTERVAL '2' SECOND))
         GROUP BY window_start, window_end),
        DESCRIPTOR(bid_start), INTERVAL '2' SECOND))) AS b
ON a.window_start = b.window_start AND a.num = b.max_tmp
INTO q5Checksum;
----
10589 23372488


# Query 8
# Until PR #755 is not merged, we need to do another subquery to project the required fields
# auction.id is renamed to auction_id to avoid collision with person.id in the join schema
SELECT p.window_start AS "START", p.window_end AS "END", p.id, p.name
FROM TABLE(TUMBLE(TABLE person, DESCRIPTOR(timestamp_person), INTERVAL '10' SECOND)) AS p
INNER JOIN TABLE(TUMBLE(TABLE auction, DESCRIPTOR(timestamp_auction), INTERVAL '10' SECOND)) AS a
ON p.window_start = a.window_start AND p.id = a.seller
INTO q8CheckSum;
----
10999751 33652579169


# Query 8 Variant (We are not using the actual Q8 but a variant, as we have swapped the Person stream with the Bid stream)
SELECT b.window_start AS "START", b.window_end AS "END", b.timestamp_bid, b.auctionId, b.bidder, b.price,
       a.timestamp_auction, a.id, a.initialbid, a.reserve, a.expires, a.seller, a.category
FROM TABLE(TUMBLE(TABLE bid, DESCRIPTOR(timestamp_bid), INTERVAL '10' SECOND)) AS b
INNER JOIN TABLE(TUMBLE(TABLE auction, DESCRIPTOR(timestamp_auction), INTERVAL '10' SECOND)) AS a
ON b.window_start = a.window_start AND b.auctionId = a.id
INTO q8VariantCheckSum;
----
182197843 1176854299950
