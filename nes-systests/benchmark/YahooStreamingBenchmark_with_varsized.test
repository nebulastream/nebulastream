# name: milestone/YahooStreamingBenchmark_with_varsized.test
# description: YahooStreamingBenchmark queries (https://github.com/yahoo/streaming-benchmarks)
# groups: [milestone, benchmark, large, Aggregation]

# Source definitions
CREATE LOGICAL SOURCE ysb1k(user_id VARSIZED NOT NULL, page_id VARSIZED NOT NULL, campaign_id VARSIZED NOT NULL, ad_id VARSIZED NOT NULL, ad_type VARSIZED NOT NULL, event_type VARSIZED NOT NULL, event_time UINT64 NOT NULL, ip_address VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR ysb1k TYPE File;
ATTACH FILE large/ysb/ysb1k_with_varsized_3GB.csv

CREATE LOGICAL SOURCE ysb10k(user_id VARSIZED NOT NULL, page_id VARSIZED NOT NULL, campaign_id VARSIZED NOT NULL, ad_id VARSIZED NOT NULL, ad_type VARSIZED NOT NULL, event_type VARSIZED NOT NULL, event_time UINT64 NOT NULL, ip_address VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR ysb10k TYPE File;
ATTACH FILE large/ysb/ysb10k_with_varsized_3GB.csv

CREATE SINK printSink(campaign UINT64 NOT NULL)  TYPE File;
CREATE SINK ysb1kChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, campaign_id VARSIZED NOT NULL, count_user_id INT64 NOT NULL)  TYPE Checksum;
CREATE SINK ysb10kChecksum(start UINT64 NOT NULL, end UINT64 NOT NULL, campaign_id VARSIZED NOT NULL, count_user_id INT64 NOT NULL)  TYPE Checksum;

# Adapt the YSB Query to already have the campaign_id, as we currently do not support stream-batch joins
# YSB Query
SELECT
    window_start AS "START",
    window_end AS "END",
    campaign_id,
    COUNT(user_id) AS count_user_id
FROM TABLE(TUMBLE((SELECT * FROM ysb1k WHERE event_type = 'view'), DESCRIPTOR(event_time), INTERVAL '30' SECOND))
GROUP BY window_start, window_end, campaign_id
INTO ysb1kChecksum;
----
68000, 278998939

# Adapt the YSB Query to already have the campaign_id, as we currently do not support stream-batch joins
# YSB Query
SELECT
    window_start AS "START",
    window_end AS "END",
    campaign_id,
    COUNT(user_id) AS count_user_id
FROM TABLE(TUMBLE((SELECT * FROM ysb10k WHERE event_type = 'view'), DESCRIPTOR(event_time), INTERVAL '30' SECOND))
GROUP BY window_start, window_end, campaign_id
INTO ysb10kChecksum;
----
670000, 2725304985
