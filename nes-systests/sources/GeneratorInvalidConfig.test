# name: sources/GeneratorInvalidConfig.test
# description: Single-node-only validation that an invalid GeneratorSource config is a recoverable error, not an abort.
# groups: [Sources, Generator, SingleNodeOnly]

# An invalid GeneratorSource config must be a recoverable error, not an abort.
# NORMAL_DISTRIBUTION with an unsupported output type (BOOLEAN) passes the permissive validator
# but is rejected at field construction, which must throw InvalidConfigParameter (1000) instead of
# calling std::terminate() via INVARIANT(false, ...).
#
# This lives in its own file tagged "SingleNodeOnly" (excluded by the remote/distributed harness in
# nes-systests/systest/remote-test/distributed.bats) because the check is inherently single-node: the
# source field is only constructed when the physical source is instantiated. In single-node mode that
# happens in-process and surfaces the InvalidConfigParameter(1000) the test asserts. In distributed mode
# the same rejection happens on the remote worker and reaches the client as a generic gRPC "query start
# call failed; Status: INTERNAL" error (code != 1000), so the assertion cannot hold there. The config is
# rejected before any distributed execution, so nothing is lost by not running this case distributed.
CREATE LOGICAL SOURCE generatorInvalidNormalDist(value BOOLEAN NOT NULL);
CREATE PHYSICAL SOURCE FOR generatorInvalidNormalDist TYPE Generator SET(
    'ALL' as "SOURCE".STOP_GENERATOR_WHEN_SEQUENCE_FINISHES,
    1 AS "SOURCE".SEED,
    'NORMAL_DISTRIBUTION BOOLEAN 1 1' AS "SOURCE".GENERATOR_SCHEMA
);
CREATE SINK generator_invalid_sink(value BOOLEAN NOT NULL) TYPE File;
SELECT * FROM generatorInvalidNormalDist INTO generator_invalid_sink;
----
ERROR 1000
