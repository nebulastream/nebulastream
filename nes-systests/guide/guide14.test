# name: guide/guide14.test
# description: Squared error using arithmetic expression
# groups: [Projection, Expression, Arithmetic]

CREATE LOGICAL SOURCE s(
    x INT32 NOT NULL,
    y INT32 NOT NULL
);

CREATE PHYSICAL SOURCE FOR s TYPE FileSource;
ATTACH INLINE
5,3
2,7
10,10

CREATE SINK sink(
    squared_error INT32 NOT NULL
) TYPE FileSink;

SELECT
    (x - y) * (x - y) AS squared_error
FROM s
INTO sink;
----
4
25
0
