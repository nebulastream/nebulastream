# name: guide/guide7.test
# description: Max price per ticker in a sliding window
# groups: [Window, Aggregation, Sliding, Max]

CREATE LOGICAL SOURCE bid(
    ticker VARSIZED NOT NULL,
    price  FLOAT64 NOT NULL,
    ts     INT64 NOT NULL
);
CREATE PHYSICAL SOURCE FOR bid TYPE File;
ATTACH INLINE
AAPL,150.0,1
AAPL,152.0,2
AAPL,149.5,3
GOOG,1000.0,4
AAPL,153.0,5
GOOG,1010.0,6
GOOG,1005.0,7
AAPL,151.0,8

CREATE SINK sink(price_max FLOAT64) TYPE File;

SELECT
    MAX(price) AS price_max
FROM TABLE(HOP(TABLE bid, DESCRIPTOR(ts), INTERVAL '1' SECOND, INTERVAL '10' SECOND))
GROUP BY window_start, window_end, ticker
INTO sink;
----
153.0
1010.0
