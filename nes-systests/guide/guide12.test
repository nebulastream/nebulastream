# name: guide/guide12.test
# description: Sliding window inner join between orders and payments
# groups: [Window, Join, InnerJoin, Sliding]

CREATE LOGICAL SOURCE orders(
    order_id    INT64 NOT NULL,
    customer_id INT64 NOT NULL,
    ts_orders   INT64 NOT NULL
);

CREATE LOGICAL SOURCE payments(
    payments_order_id INT64 NOT NULL,
    amount            FLOAT64 NOT NULL,
    ts_payments       INT64 NOT NULL
);

CREATE PHYSICAL SOURCE FOR orders TYPE File;
ATTACH INLINE
1,42,10000

CREATE PHYSICAL SOURCE FOR payments TYPE File;
ATTACH INLINE
1,99.99,12000

CREATE SINK sink(
    order_id    INT64 NOT NULL,
    customer_id INT64 NOT NULL,
    amount    FLOAT64 NOT NULL
) TYPE File;

SELECT
    order_id,
    customer_id,
    amount
FROM TABLE(HOP(TABLE orders, DESCRIPTOR(ts_orders), INTERVAL '5' SECOND, INTERVAL '30' SECOND)) AS o
JOIN TABLE(HOP(TABLE payments, DESCRIPTOR(ts_payments), INTERVAL '5' SECOND, INTERVAL '30' SECOND)) AS p
ON o.window_start = p.window_start AND o.order_id = p.payments_order_id
INTO sink;
----
1,42,99.99
1,42,99.99
1,42,99.99
