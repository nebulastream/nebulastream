# Query 6: an ordinary query with no model in it at all. Run concurrently with query 1 or 5 on a
# worker configured with a single thread, it answers the question the framework exists for: does a
# waiting operator hold up unrelated work?
SELECT id FROM reviews WHERE id > UINT64(28) INTO ids;
----
29
30
