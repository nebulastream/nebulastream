# name: semantic/SemanticImageBase64.test
# description: Image inputs carried in the stream as base64 ('BASE64' AS LLM.IMAGE_ENCODING), end to end under a real
#              worker against the mock backend. The image field holds the image bytes as padded standard base64; SEM_CALL
#              reads no file, takes the MIME type from the first bytes and puts the text into the data URL as it is. The
#              mock's 'imageinfo' decodes the request and answers "<mime>:<bytes>:<fnv1a64>": rows 1-3 are the files of
#              SemanticImage.test (same answers as there, where they are read from disk), row 4 a 100,000-byte JPEG-signed
#              blob (a 133,336-character field). A path (row 5) is not base64, and row 6 is base64 of something that is
#              not an image: both get the default without a request, and a filter drops them.
# groups: [Semantic]

CREATE LOGICAL SOURCE encoded(id UINT64 NOT NULL, image VARSIZED NOT NULL, note VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR encoded TYPE File;
ATTACH FILE small/semantic/images_base64.csv

CREATE SEM_MODEL describe
INPUT (image VARSIZED)
OUTPUT (seen VARSIZED)
SET ('Describe the image' AS LLM.PROMPT, 'imageinfo' AS LLM.ENDPOINT, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND,
     'image' AS LLM.IMAGE_FIELDS, 'BASE64' AS LLM.IMAGE_ENCODING, 'NO_IMAGE' AS LLM.DEFAULT_VALUE);

CREATE SEM_MODEL echoText
INPUT (image VARSIZED, note VARSIZED)
OUTPUT (seen VARSIZED)
SET ('Echo the row' AS LLM.PROMPT, 'echo' AS LLM.ENDPOINT, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND,
     'ASYNC' AS LLM.EXECUTION, 'image' AS LLM.IMAGE_FIELDS, 'BASE64' AS LLM.IMAGE_ENCODING, 'NO_IMAGE' AS LLM.DEFAULT_VALUE);

CREATE SEM_MODEL small
INPUT (image VARSIZED)
OUTPUT (seen VARSIZED)
SET ('Describe the image' AS LLM.PROMPT, 'imageinfo' AS LLM.ENDPOINT, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND,
     'image' AS LLM.IMAGE_FIELDS, 'BASE64' AS LLM.IMAGE_ENCODING, '100' AS LLM.IMAGE_MAX_BYTES, 'TOO_LARGE' AS LLM.DEFAULT_VALUE);

CREATE SEM_MODEL keepAll
INPUT (image VARSIZED)
SET ('Does the image show a pet?' AS LLM.PROMPT, 'label:true' AS LLM.ENDPOINT, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND,
     'ASYNC' AS LLM.EXECUTION, 'image' AS LLM.IMAGE_FIELDS, 'BASE64' AS LLM.IMAGE_ENCODING);

CREATE SINK seen(id UINT64 NOT NULL, note VARSIZED NOT NULL, seen VARSIZED NOT NULL) TYPE File;
CREATE SINK ids(id UINT64 NOT NULL) TYPE File;

# Query 1: what the model receives is the image itself: the same answers as SemanticImage.test gives for the files.
SELECT id, note, seen FROM SEM_MAP(describe, encoded) INTO seen;
----
1,images/red.jpg,image/jpeg:633:195b1145063529fb
2,images/blue.png,image/png:77:dbe30a86b1f18f42
3,images/grey.webp,image/webp:44:0e96e19d39dca88f
4,big,image/jpeg:100000:598f1bcb3e4ec7b5
5,path,NO_IMAGE
6,bmp,NO_IMAGE

# Query 2: the prompt text carries the placeholder, never the base64 text.
SELECT id, note, seen FROM SEM_MAP(echoText, encoded) WHERE id <= 2 INTO seen;
----
1,images/red.jpg,[IMAGE 1] IMAGES/RED.JPG
2,images/blue.png,[IMAGE 1] IMAGES/BLUE.PNG

# Query 3: LLM.IMAGE_MAX_BYTES counts the decoded bytes.
SELECT id, note, seen FROM SEM_MAP(small, encoded) WHERE id <= 3 INTO seen;
----
1,images/red.jpg,TOO_LARGE
2,images/blue.png,image/png:77:dbe30a86b1f18f42
3,images/grey.webp,image/webp:44:0e96e19d39dca88f

# Query 4: SEM_FILTER drops the rows without a usable image.
SELECT id FROM SEM_FILTER(keepAll, encoded) INTO ids;
----
1
2
3
4
