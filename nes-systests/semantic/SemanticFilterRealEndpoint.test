# name: semantic/SemanticFilterRealEndpoint.test
# description: SEM_FILTER against a real, locally running OpenAI-compatible endpoint. Not hermetic: the
#              Semantic-Nightly group is excluded from every ctest systest run (SYSTEST_EXCLUDE_GROUPS
#              in nes-systests/systest/CMakeLists.txt). Needs Ollama on localhost:11434 with
#              llama3.1:latest (8B) pulled, and a container started with --network host.
#
#              The reviews are chosen so that an 8B model has no room for doubt: two are plainly
#              positive, two plainly negative. The query asserts exactly the positive ones, once
#              synchronously, once asynchronously and batched, and once fused with a second, trivially
#              true condition -- so a malformed verdict envelope shows up as a missing id.
# groups: [Semantic-Nightly]

CREATE LOGICAL SOURCE reviews(id UINT64 NOT NULL, description VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR reviews TYPE File;
ATTACH INLINE
1,This movie was a delight from start to finish and I loved every minute
2,Two hours I will never get back. Awful and boring
3,A wonderful, moving film with brilliant performances. Highly recommended
4,The worst film I have seen this year. Terrible acting and a dull plot

CREATE SEM_MODEL positive
INPUT (description VARSIZED)
SET ('The review expresses a positive opinion of the movie' AS LLM.PROMPT,
     'http://localhost:11434/v1' AS LLM.ENDPOINT,
     'llama3.1:latest' AS LLM.MODEL_NAME);

CREATE SEM_MODEL positiveAsync
INPUT (description VARSIZED)
SET ('The review expresses a positive opinion of the movie' AS LLM.PROMPT,
     'http://localhost:11434/v1' AS LLM.ENDPOINT,
     'llama3.1:latest' AS LLM.MODEL_NAME,
     'ASYNC' AS LLM.EXECUTION, 4 AS LLM.BATCH_SIZE, 'TRUE' AS LLM.FUSION);

CREATE SEM_MODEL aboutMovie
INPUT (description VARSIZED)
SET ('The text is a review of a movie or film' AS LLM.PROMPT,
     'http://localhost:11434/v1' AS LLM.ENDPOINT,
     'llama3.1:latest' AS LLM.MODEL_NAME,
     'ASYNC' AS LLM.EXECUTION, 4 AS LLM.BATCH_SIZE, 'TRUE' AS LLM.FUSION);

CREATE SINK ids(id UINT64 NOT NULL) TYPE File;

SELECT id FROM SEM_FILTER(positive, reviews) INTO ids;
----
1
3

SELECT id FROM SEM_FILTER(positiveAsync, reviews) INTO ids;
----
1
3

SELECT id FROM SEM_FILTER(positiveAsync, SEM_FILTER(aboutMovie, reviews)) INTO ids;
----
1
3
