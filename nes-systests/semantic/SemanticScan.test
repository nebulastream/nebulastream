# Query 4: an answer that cannot be read gives the default and leaves the key's state as it was.
SELECT * FROM SEM_SCAN(unparseableDigest, reviews) INTO digests;
----
1,alien,scary,n/a,
2,heat,tense,n/a,
3,alien,dark,n/a,
4,alien,classic,n/a,
5,heat,long,n/a,
6,up,sweet,n/a,

# Query 5: a SEM_SCAN model in SEM_MAP, and a map model in SEM_SCAN, are mistakes in the query.
SELECT * FROM SEM_MAP(movieDigest, reviews) INTO digests;
----
ERROR 2048 "SEM_SCAN model"
