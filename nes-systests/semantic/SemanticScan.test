# name: semantic/SemanticScan.test
# description: SEM_SCAN, a running semantic state per key after llm_operator's sem_scan.py, on the async framework.
#              The mock's 'scan' behaviour makes a key's first row's state its text and appends '|' and the text of
#              every later row, so each state spells out exactly which rows of its key were folded, and in which order.
#              The framework runs one call per key at a time and in stream order (AsyncFunction::orderingKey).
# groups: [Semantic]

CREATE LOGICAL SOURCE reviews(id UINT64 NOT NULL, movie VARSIZED NOT NULL, review VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR reviews TYPE File;
ATTACH INLINE
1,alien,scary
2,heat,tense
3,alien,dark
4,alien,classic
5,heat,long
6,up,sweet

CREATE LOGICAL SOURCE many(id UINT64 NOT NULL, k VARSIZED NOT NULL, v VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR many TYPE File;
ATTACH FILE small/semantic/scan_ordered.csv

# INIT_PROMPT for a key's first row, PROMPT for the folds; OUTPUT is the state and its confidence.
CREATE SEM_MODEL movieDigest
INPUT (review VARSIZED)
OUTPUT (digest VARSIZED, confidence VARSIZED)
SET ('Fold the review into the digest' AS LLM.PROMPT, 'Start a digest from the review' AS LLM.INIT_PROMPT, 'SCAN' AS LLM.KIND,
     'movie' AS LLM.KEY_BY, 'scan' AS LLM.ENDPOINT, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND, 4 AS LLM.MAX_CONCURRENCY);

# Without INIT_PROMPT, a key's first row starts from INITIAL_STATE without a call and without a confidence.
CREATE SEM_MODEL movieTally
INPUT (review VARSIZED)
OUTPUT (digest VARSIZED, confidence VARSIZED)
SET ('Fold the review into the digest' AS LLM.PROMPT, 'start' AS LLM.INITIAL_STATE, 'SCAN' AS LLM.KIND, 'movie' AS LLM.KEY_BY,
     'scan' AS LLM.ENDPOINT, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND);

# Slow calls, eight in flight: three keys run side by side, the rows of one key one after the other.
CREATE SEM_MODEL manyDigest
INPUT (v VARSIZED)
OUTPUT (digest VARSIZED, confidence VARSIZED)
SET ('Fold' AS LLM.PROMPT, 'Start' AS LLM.INIT_PROMPT, 'SCAN' AS LLM.KIND, 'k' AS LLM.KEY_BY, 'scan@1' AS LLM.ENDPOINT,
     'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND, 8 AS LLM.MAX_CONCURRENCY);

CREATE SEM_MODEL unparseableDigest
INPUT (review VARSIZED)
OUTPUT (digest VARSIZED, confidence VARSIZED)
SET ('Fold' AS LLM.PROMPT, 'Start' AS LLM.INIT_PROMPT, 'SCAN' AS LLM.KIND, 'movie' AS LLM.KEY_BY, 'unparseable' AS LLM.ENDPOINT,
     'n/a' AS LLM.DEFAULT_VALUE, 'mock-model' AS LLM.MODEL_NAME, 'mock' AS LLM.BACKEND);

CREATE SINK digests(id UINT64 NOT NULL, movie VARSIZED NOT NULL, review VARSIZED NOT NULL, digest VARSIZED NOT NULL, confidence VARSIZED NOT NULL) TYPE File;
CREATE SINK lastDigests(id UINT64 NOT NULL, k VARSIZED NOT NULL, digest VARSIZED NOT NULL) TYPE File;

# Query 1: each state holds the earlier rows of its own key, in order.
SELECT * FROM SEM_SCAN(movieDigest, reviews) INTO digests;
----
1,alien,scary,scary,0.9
2,heat,tense,tense,0.9
3,alien,dark,scary|dark,0.9
4,alien,classic,scary|dark|classic,0.9
5,heat,long,tense|long,0.9
6,up,sweet,sweet,0.9

# Query 2: the initial state instead of an INIT_PROMPT.
SELECT * FROM SEM_SCAN(movieTally, reviews) INTO digests;
----
1,alien,scary,start,
2,heat,tense,start,
3,alien,dark,start|dark,0.9
4,alien,classic,start|dark|classic,0.9
5,heat,long,start|long,0.9
6,up,sweet,start,

# Query 3: 1200 rows over several buffers and worker threads, three keys. The last row of each key carries its whole
# fold, which is only right if every row of the key was folded once and in stream order. The selection reads no output
# of the scan, but it must not be pushed below it: the scan would then see only the selected rows.
SELECT id, k, digest FROM SEM_SCAN(manyDigest, many) WHERE id > UINT64(1197) INTO lastDigests;
