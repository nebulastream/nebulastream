# calcite
# name: calcite/Unsigned.test
# description: UINT64 and UINT32 under the Calcite frontend: Calcite's unsigned types, Substrait's u64/u32. Values at and
#              above 2^63 tell unsigned from signed. Mixing signed and unsigned values, and lossy casts, fail (2008).
# groups: [Calcite]

CREATE LOGICAL SOURCE t(id UINT64 NOT NULL, u UINT64, v UINT32, i INT64);
CREATE PHYSICAL SOURCE FOR t TYPE File;
ATTACH INLINE
1,18446744073709551615,4294967295,-1
2,9223372036854775808,7,5
3,9223372036854775807,0,0
4,5,3,2
5,,,

CREATE LOGICAL SOURCE s(k UINT64, label INT64);
CREATE PHYSICAL SOURCE FOR s TYPE File;
ATTACH INLINE
18446744073709551615,100
9223372036854775808,200
7,300

# Above 2^63 - 1: as signed values these would be negative.
SELECT id, u FROM t WHERE u > 9223372036854775807 INTO File();
----
1,18446744073709551615
2,9223372036854775808

SELECT id, u + 1 FROM t WHERE u < 9223372036854775807 INTO File();
----
4,6

SELECT id, u - 5 FROM t WHERE id = 2 INTO File();
----
2,9223372036854775803

SELECT id, u / 2, u % 10 FROM t WHERE id <= 2 INTO File();
----
1,9223372036854775807,5
2,4611686018427387904,8

# UINT32 widens to UINT64.
SELECT id, u + v FROM t WHERE id = 4 INTO File();
----
4,8

SELECT id FROM t WHERE u = CAST(5 AS BIGINT UNSIGNED) INTO File();
----
4

SELECT MAX(u), MIN(u) FROM t INTO File();
----
18446744073709551615,5

SELECT SUM(u) FROM t WHERE id >= 3 INTO File();
----
9223372036854775812

SELECT v, COUNT(*) FROM t GROUP BY v INTO File();
----
4294967295,1
7,1
0,1
3,1
NULL,1

SELECT t.id, s.label FROM t JOIN s ON t.u = s.k INTO File();
----
1,100
2,200

# A wider signed type holds every UINT32 value.
SELECT id, CAST(v AS BIGINT) + i FROM t WHERE id = 4 INTO File();
----
4,5

# What a mix of signed and unsigned values means is not defined (yet).
SELECT u + i FROM t INTO File();
----
ERROR 2008

SELECT id FROM t WHERE u < i INTO File();
----
ERROR 2008

SELECT id FROM t WHERE u < -1 INTO File();
----
ERROR 2008

# BIGINT does not hold every UINT64 value.
SELECT CAST(u AS BIGINT) FROM t INTO File();
----
ERROR 2008
