# name: calcite/PlannerExamples.test
# description: The example queries of the planner's documentation (nes-calcite-planner/docs/planner-steps.html) and
#   of the checks of physical plans: selections, projections, unions, windows, decorrelated subqueries
# groups: [Calcite]

CREATE LOGICAL SOURCE events(id UINT64 NOT NULL, val UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR events TYPE File;
ATTACH INLINE
1,10,1000
2,25,1100
3,40,1200
1,35,1500
2,5,2000
3,60,2100
4,15,2500

CREATE LOGICAL SOURCE events2(id UINT64 NOT NULL, val UINT64 NOT NULL, ts UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR events2 TYPE File;
ATTACH INLINE
1,20,1000
2,30,1300
1,50,1700
3,10,2000
2,45,2200
5,70,2600

