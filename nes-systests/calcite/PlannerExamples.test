SELECT id, val * 2 AS v2 FROM events2 WHERE val > 20 INTO File();
----
1,100
2,60
2,90
5,140

SELECT id + 1 AS a, CASE WHEN val > 30 THEN val ELSE NULL END AS b
FROM (SELECT * FROM events UNION ALL SELECT * FROM events2) WHERE id < 3 INTO File();
----
2,NULL
2,NULL
2,35
2,50
3,NULL
3,NULL
3,NULL
3,45

SELECT window_start, COUNT(*) AS n, SUM(val) AS s
FROM TABLE(TUMBLE(TABLE events2, DESCRIPTOR(ts), INTERVAL '1' SECOND)) WHERE val > 5
GROUP BY window_start, window_end INTO File();
----
1000,3,100
2000,3,125

SELECT window_start, id % 4 AS k, AVG(val) AS a
FROM TABLE(HOP(TABLE events, DESCRIPTOR(ts), INTERVAL '1' SECOND, INTERVAL '2' SECOND))
GROUP BY window_start, window_end, id % 4 INTO File();
----
0,1,22
0,2,25
0,3,40
1000,0,15
1000,1,22
1000,2,15
1000,3,50
2000,0,15
2000,2,5
2000,3,60

SELECT id, val FROM events e WHERE val > (SELECT AVG(val) FROM events2 e2 WHERE e2.id = e.id) INTO File();
----
3,40
3,60

SELECT id FROM events e WHERE EXISTS (SELECT 1 FROM events2 e2 WHERE e2.id = e.id AND e2.val > e.val) INTO File();
----
1
1
2
2

SELECT id + 1 AS a, val AS v, id * 2 AS b, id AS c FROM readings WHERE val % 7 = 0 INTO File();
----
1,0,0,0
11,70,20,10
12,7,22,11
22,77,42,21
23,14,44,22
33,84,64,32
34,21,66,33

SELECT window_start, window_end, COUNT(*) AS n, SUM(val) AS s
FROM TABLE(HOP(TABLE readings, DESCRIPTOR(ts), INTERVAL '0.5' SECOND, INTERVAL '2' SECOND)) WHERE val > 50
GROUP BY window_start, window_end INTO File();
