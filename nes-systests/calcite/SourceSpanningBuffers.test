# name: calcite/SourceSpanningBuffers.test
# description: Reproducer: a CSV source of more than one 4 KiB buffer (t5: 4546 bytes), unioned with a window's result and
#              fed into another window, fails with "Out-of-order timestamps are not supported: timestamp 0 is below the
#              watermark 18446744073709551615": a buffer of the source arrives after its end-of-stream watermark. With
#              t5 below 4 KiB, or with larger buffers (operator_buffer_size=65536), it passes; also with one worker thread
#              it fails. Expected: distinct c2 of t2 plus the rows of t5.
# groups: [Calcite]

CREATE LOGICAL SOURCE t2(a2 INT64, b2 INT64, c2 INT64, d2 INT64, e2 INT64, x2 VARSIZED);
CREATE PHYSICAL SOURCE FOR t2 TYPE File;
