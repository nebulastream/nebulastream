# name: inference/InferModelYuNetFaceAlignment.test
# description: Detects a face with YuNet and aligns it to the canonical SFace landmarks
# groups: [Inference, PythonUDF, CompilerOnly]

CREATE LOGICAL SOURCE portraits(encoded VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR portraits TYPE File;
ATTACH FILE python_udf/portrait.jpg.base64.csv

CREATE MODEL yunet ('model/face_detection_yunet_2026may_320_packed.onnx')
INPUT (tensor VARSIZED)
OUTPUT (packedFaces VARSIZED);

CREATE SINK sink(alignedImageBytes UINT64 NOT NULL) TYPE File;

SELECT OCTET_LENGTH(PYTHON((imageBytes, face): $python$
    import cv2
    import numpy as np

    encoded = np.frombuffer(imageBytes, dtype=np.uint8)
    image = cv2.imdecode(encoded, cv2.IMREAD_COLOR)
    landmarks = np.frombuffer(face, dtype=np.float32)
    if landmarks.size != 15:
        raise ValueError("YuNet did not detect a face")

    target = np.empty((5, 2), dtype=np.float64)
    target[0, 0], target[0, 1] = 38.2946, 51.6963
    target[1, 0], target[1, 1] = 73.5318, 51.5014
    target[2, 0], target[2, 1] = 56.0252, 71.7366
    target[3, 0], target[3, 1] = 41.5493, 92.3655
    target[4, 0], target[4, 1] = 70.7299, 92.2041

    source = np.empty((5, 2), dtype=np.float64)
    image_width = float(image.shape[1])
    image_height = float(image.shape[0])
    for index in range(5):
        source[index, 0] = float(landmarks[4 + index * 2]) * image_width
        source[index, 1] = float(landmarks[5 + index * 2]) * image_height

    source_mean_x = 0.0
    source_mean_y = 0.0
    target_mean_x = 0.0
    target_mean_y = 0.0
    for index in range(5):
        source_mean_x += source[index, 0]
        source_mean_y += source[index, 1]
        target_mean_x += target[index, 0]
        target_mean_y += target[index, 1]
    source_mean_x /= 5.0
    source_mean_y /= 5.0
    target_mean_x /= 5.0
    target_mean_y /= 5.0

    denominator = 0.0
    numerator_a = 0.0
    numerator_b = 0.0
    for index in range(5):
        source_x = source[index, 0] - source_mean_x
        source_y = source[index, 1] - source_mean_y
        target_x = target[index, 0] - target_mean_x
        target_y = target[index, 1] - target_mean_y
        denominator += source_x * source_x + source_y * source_y
        numerator_a += source_x * target_x + source_y * target_y
        numerator_b += source_x * target_y - source_y * target_x
    if denominator == 0.0:
        raise ValueError("degenerate YuNet landmarks")

    a = numerator_a / denominator
    b = numerator_b / denominator
    transformation = np.empty((2, 3), dtype=np.float64)
    transformation[0, 0] = a
    transformation[0, 1] = -b
    transformation[0, 2] = target_mean_x - a * source_mean_x + b * source_mean_y
    transformation[1, 0] = b
    transformation[1, 1] = a
    transformation[1, 2] = target_mean_y - b * source_mean_x - a * source_mean_y

    aligned = cv2.warpAffine(
        image,
        transformation,
        (112, 112),
        flags=cv2.INTER_LINEAR,
        borderMode=cv2.BORDER_CONSTANT,
        borderValue=(0.0, 0.0, 0.0, 0.0))
    success, jpeg = cv2.imencode(".jpg", aligned, (cv2.IMWRITE_JPEG_QUALITY, 95))
    if not success:
        raise ValueError("could not encode aligned face")
    return str(jpeg.data.as_byte(), int(jpeg.nbytes))
$python$) AS VARSIZED) AS alignedImageBytes
FROM (
    SELECT imageBytes, PYTHON((packedFaces): $python$
        import math
        import numpy as np

        input_size = 320
        total_locations = 0
        for stride in (8, 16, 32):
            grid_size = input_size // stride
            total_locations += grid_size * grid_size
        values = np.frombuffer(packedFaces, dtype=np.float32)
        if values.size != total_locations * 16:
            raise ValueError("unexpected packed YuNet output size")

        best_score = -1.0
        best_stride = 0
        best_grid_size = 0
        best_index = 0
        best_bbox_offset = 0
        best_landmark_offset = 0
        preceding_locations = 0
        for stride in (8, 16, 32):
            grid_size = input_size // stride
            location_count = grid_size * grid_size
            class_offset = preceding_locations
            object_offset = total_locations + preceding_locations
            bbox_offset = 2 * total_locations + 4 * preceding_locations
            landmark_offset = 6 * total_locations + 10 * preceding_locations
            for index in range(location_count):
                class_score = min(1.0, max(0.0, float(values[class_offset + index])))
                object_score = min(1.0, max(0.0, float(values[object_offset + index])))
                score = math.sqrt(class_score * object_score)
                if score > best_score:
                    best_score = score
                    best_stride = stride
                    best_grid_size = grid_size
                    best_index = index
                    best_bbox_offset = bbox_offset
                    best_landmark_offset = landmark_offset
            preceding_locations += location_count

        face_bytes = ""
        if best_score >= 0.6:
            row = best_index // best_grid_size
            column = best_index % best_grid_size
            bbox = best_bbox_offset + best_index * 4
            center_x = (column + float(values[bbox])) * best_stride
            center_y = (row + float(values[bbox + 1])) * best_stride
            width = math.exp(float(values[bbox + 2])) * best_stride
            height = math.exp(float(values[bbox + 3])) * best_stride
            face = np.empty((15,), dtype=np.float32)
            scale = float(input_size)
            face[0] = (center_x - width / 2.0) / scale
            face[1] = (center_y - height / 2.0) / scale
            face[2] = width / scale
            face[3] = height / scale
            landmark_offset = best_landmark_offset + best_index * 10
            for index in range(5):
                face[4 + index * 2] = (float(values[landmark_offset + index * 2]) + column) * best_stride / scale
                face[5 + index * 2] = (float(values[landmark_offset + index * 2 + 1]) + row) * best_stride / scale
            face[14] = best_score
            face_bytes = str(face.data.as_byte(), int(face.nbytes))
        return face_bytes
    $python$) AS VARSIZED AS face
    FROM MODEL_INFERENCE(yunet, (
        SELECT imageBytes, PYTHON((imageBytes): $python$
            import cv2
            import numpy as np

            encoded = np.frombuffer(imageBytes, dtype=np.uint8)
            image = cv2.imdecode(encoded, cv2.IMREAD_COLOR)
            resized = cv2.resize(image, (320, 320), interpolation=cv2.INTER_LINEAR)
            tensor = resized.astype(np.float32).transpose((2, 0, 1)).copy()
            return str(tensor.data.as_byte(), int(tensor.nbytes))
        $python$) AS VARSIZED AS tensor
        FROM (SELECT FROM_BASE64(encoded) AS imageBytes FROM portraits)
    ))
)
INTO file();
----
7624
