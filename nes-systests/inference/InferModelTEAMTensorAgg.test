# name: inference/InferModelTEAMTensorAgg.test
# description: TEAM inference on tensors that TENSOR_AGG assembles from per-station sensor streams
# groups: [Inference, Aggregation]

# Every seismic station is a separate physical source that streams its (preprocessed) recording sample by sample,
# with real timestamps: one tuple per sample with the three channels n, e, z and the station's coordinates.
# TENSOR_AGG places every tuple by its station slot and sample index, which assembles the unmodified model's inputs
#     waveforms [25, 3000, 3]   TENSOR_AGG(n, e, z AT (station_slot, sample_idx) SHAPE (25, 3000, 3))
#     coords    [25, 3]         TENSOR_AGG(latitude, longitude, depth_km AT (station_slot) SHAPE (25, 3))
# per event, independent of the order in which the stations' tuples arrive. See InferModelTEAM.test for the model.
#
# The streams hold events 3, 26 and 47 for a prediction at t = 5 s, written by
#     model/team_baseline/prepare_team_input.py --time 5 --events 3 26 47 --stream-dir stream_t5
# Only data that exists 5 s into an event is streamed: the first 1000 samples of the stations whose P wave has
# arrived (6, 5 and 10 of them). Everything else is zero in TEAM's input, which TENSOR_AGG's default fills in.
# The expected predictions are TensorFlow's results on the same inputs.

GlobalConfiguration worker.query_engine.number_of_worker_threads: [1, 4]

CREATE LOGICAL SOURCE stations(event_idx UINT64 NOT NULL, station_slot UINT64 NOT NULL, sample_idx UINT64 NOT NULL,
    timestamp_ms UINT64 NOT NULL, n FLOAT32 NOT NULL, e FLOAT32 NOT NULL, z FLOAT32 NOT NULL,
    latitude FLOAT32 NOT NULL, longitude FLOAT32 NOT NULL, depth_km FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.BCL.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.CNMT.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.CSO1.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.CTD.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.DUR.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.LRNO.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.LSS.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.MCLF.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.MMP1.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.MZZ.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.NAS.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.NRN.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.PLS.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.PLTA.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.PTT.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.SCO.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.SGMA.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.SPR.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.TRL.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.TRN1.csv
CREATE PHYSICAL SOURCE FOR stations TYPE File;
ATTACH FILE model/team_baseline/stream_t5/IT.VSE.csv

# The preprocessed tensors of the same events, as Python builds them (see InferModelTEAMMultipleSources.test).
CREATE LOGICAL SOURCE team(event_idx UINT64 NOT NULL, event_id UINT64 NOT NULL, waveforms VARSIZED NOT NULL, coords VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR team TYPE File;
ATTACH FILE model/team_baseline/team_input_t5_event3.csv
CREATE PHYSICAL SOURCE FOR team TYPE File;
ATTACH FILE model/team_baseline/team_input_t5_event26.csv
CREATE PHYSICAL SOURCE FOR team TYPE File;
ATTACH FILE model/team_baseline/team_input_t5_event47.csv

CREATE MODEL teamBaseline ('model/team_baseline/saved_model_single_output')
INPUT (waveforms VARSIZED, coords VARSIZED)
OUTPUT (
    mag0_alpha FLOAT32, mag0_mu FLOAT32, mag0_sigma FLOAT32,
    mag1_alpha FLOAT32, mag1_mu FLOAT32, mag1_sigma FLOAT32,
    mag2_alpha FLOAT32, mag2_mu FLOAT32, mag2_sigma FLOAT32,
    mag3_alpha FLOAT32, mag3_mu FLOAT32, mag3_sigma FLOAT32,
    mag4_alpha FLOAT32, mag4_mu FLOAT32, mag4_sigma FLOAT32,
    loc0_alpha FLOAT32, loc0_lat FLOAT32, loc0_lon FLOAT32, loc0_depth FLOAT32, loc0_sigma_lat FLOAT32, loc0_sigma_lon FLOAT32, loc0_sigma_depth FLOAT32,
    loc1_alpha FLOAT32, loc1_lat FLOAT32, loc1_lon FLOAT32, loc1_depth FLOAT32, loc1_sigma_lat FLOAT32, loc1_sigma_lon FLOAT32, loc1_sigma_depth FLOAT32,
    loc2_alpha FLOAT32, loc2_lat FLOAT32, loc2_lon FLOAT32, loc2_depth FLOAT32, loc2_sigma_lat FLOAT32, loc2_sigma_lon FLOAT32, loc2_sigma_depth FLOAT32,
    loc3_alpha FLOAT32, loc3_lat FLOAT32, loc3_lon FLOAT32, loc3_depth FLOAT32, loc3_sigma_lat FLOAT32, loc3_sigma_lon FLOAT32, loc3_sigma_depth FLOAT32,
    loc4_alpha FLOAT32, loc4_lat FLOAT32, loc4_lon FLOAT32, loc4_depth FLOAT32, loc4_sigma_lat FLOAT32, loc4_sigma_lon FLOAT32, loc4_sigma_depth FLOAT32,
    loc5_alpha FLOAT32, loc5_lat FLOAT32, loc5_lon FLOAT32, loc5_depth FLOAT32, loc5_sigma_lat FLOAT32, loc5_sigma_lon FLOAT32, loc5_sigma_depth FLOAT32,
    loc6_alpha FLOAT32, loc6_lat FLOAT32, loc6_lon FLOAT32, loc6_depth FLOAT32, loc6_sigma_lat FLOAT32, loc6_sigma_lon FLOAT32, loc6_sigma_depth FLOAT32,
    loc7_alpha FLOAT32, loc7_lat FLOAT32, loc7_lon FLOAT32, loc7_depth FLOAT32, loc7_sigma_lat FLOAT32, loc7_sigma_lon FLOAT32, loc7_sigma_depth FLOAT32,
    loc8_alpha FLOAT32, loc8_lat FLOAT32, loc8_lon FLOAT32, loc8_depth FLOAT32, loc8_sigma_lat FLOAT32, loc8_sigma_lon FLOAT32, loc8_sigma_depth FLOAT32,
    loc9_alpha FLOAT32, loc9_lat FLOAT32, loc9_lon FLOAT32, loc9_depth FLOAT32, loc9_sigma_lat FLOAT32, loc9_sigma_lon FLOAT32, loc9_sigma_depth FLOAT32,
    loc10_alpha FLOAT32, loc10_lat FLOAT32, loc10_lon FLOAT32, loc10_depth FLOAT32, loc10_sigma_lat FLOAT32, loc10_sigma_lon FLOAT32, loc10_sigma_depth FLOAT32,
    loc11_alpha FLOAT32, loc11_lat FLOAT32, loc11_lon FLOAT32, loc11_depth FLOAT32, loc11_sigma_lat FLOAT32, loc11_sigma_lon FLOAT32, loc11_sigma_depth FLOAT32,
    loc12_alpha FLOAT32, loc12_lat FLOAT32, loc12_lon FLOAT32, loc12_depth FLOAT32, loc12_sigma_lat FLOAT32, loc12_sigma_lon FLOAT32, loc12_sigma_depth FLOAT32,
    loc13_alpha FLOAT32, loc13_lat FLOAT32, loc13_lon FLOAT32, loc13_depth FLOAT32, loc13_sigma_lat FLOAT32, loc13_sigma_lon FLOAT32, loc13_sigma_depth FLOAT32,
    loc14_alpha FLOAT32, loc14_lat FLOAT32, loc14_lon FLOAT32, loc14_depth FLOAT32, loc14_sigma_lat FLOAT32, loc14_sigma_lon FLOAT32, loc14_sigma_depth FLOAT32);

CREATE SINK tensorSizes(event_idx UINT64 NOT NULL, samples UINT64 NOT NULL, waveformBytes UINT64 NOT NULL, coordBytes UINT64 NOT NULL) TYPE File;
CREATE SINK tensors(event_idx UINT64 NOT NULL, waveforms VARSIZED NOT NULL, coords VARSIZED NOT NULL) TYPE File;
CREATE SINK prediction(event_idx UINT64 NOT NULL, magnitude FLOAT32 NOT NULL,
    latitude FLOAT64 NOT NULL, longitude FLOAT64 NOT NULL, depth_km FLOAT64 NOT NULL) TYPE File;

# Each event's window holds 1000 samples per streaming station, yet the tensors always have the model's full size:
# 25 * 3000 * 3 and 25 * 3 float32 values.
SELECT event_idx, COUNT(n) AS samples,
    OCTET_LENGTH(TENSOR_AGG(n, e, z AT (station_slot, sample_idx) SHAPE (25, 3000, 3))) AS waveformBytes,
    OCTET_LENGTH(TENSOR_AGG(latitude, longitude, depth_km AT (station_slot) SHAPE (25, 3))) AS coordBytes
FROM stations
GROUP BY event_idx
WINDOW TUMBLING(timestamp_ms, SIZE 31 SEC)
INTO tensorSizes;
----
3,6000,900000,300
26,5000,900000,300
47,10000,900000,300

# The assembled tensors are byte for byte the ones Python builds.
SELECT event_idx,
    TO_BASE64(TENSOR_AGG(n, e, z AT (station_slot, sample_idx) SHAPE (25, 3000, 3))) AS waveforms,
    TO_BASE64(TENSOR_AGG(latitude, longitude, depth_km AT (station_slot) SHAPE (25, 3))) AS coords
FROM stations
GROUP BY event_idx
WINDOW TUMBLING(timestamp_ms, SIZE 31 SEC)
INTO tensors;
====
SELECT event_idx, waveforms, coords
FROM team
INTO tensors;

SELECT event_idx,
    mag0_alpha * mag0_mu + mag1_alpha * mag1_mu + mag2_alpha * mag2_mu + mag3_alpha * mag3_mu + mag4_alpha * mag4_mu AS magnitude,
    (loc0_alpha * loc0_lat + loc1_alpha * loc1_lat + loc2_alpha * loc2_lat + loc3_alpha * loc3_lat + loc4_alpha * loc4_lat
        + loc5_alpha * loc5_lat + loc6_alpha * loc6_lat + loc7_alpha * loc7_lat + loc8_alpha * loc8_lat + loc9_alpha * loc9_lat
        + loc10_alpha * loc10_lat + loc11_alpha * loc11_lat + loc12_alpha * loc12_lat + loc13_alpha * loc13_lat + loc14_alpha * loc14_lat)
        * 100.0 / 111.195 + 42.0 AS latitude,
    (loc0_alpha * loc0_lon + loc1_alpha * loc1_lon + loc2_alpha * loc2_lon + loc3_alpha * loc3_lon + loc4_alpha * loc4_lon
        + loc5_alpha * loc5_lon + loc6_alpha * loc6_lon + loc7_alpha * loc7_lon + loc8_alpha * loc8_lon + loc9_alpha * loc9_lon
        + loc10_alpha * loc10_lon + loc11_alpha * loc11_lon + loc12_alpha * loc12_lon + loc13_alpha * loc13_lon + loc14_alpha * loc14_lon)
        * 100.0 / 111.195 + 12.0 AS longitude,
    (loc0_alpha * loc0_depth + loc1_alpha * loc1_depth + loc2_alpha * loc2_depth + loc3_alpha * loc3_depth + loc4_alpha * loc4_depth
        + loc5_alpha * loc5_depth + loc6_alpha * loc6_depth + loc7_alpha * loc7_depth + loc8_alpha * loc8_depth + loc9_alpha * loc9_depth
        + loc10_alpha * loc10_depth + loc11_alpha * loc11_depth + loc12_alpha * loc12_depth + loc13_alpha * loc13_depth + loc14_alpha * loc14_depth)
        * 100.0 AS depth_km
FROM MODEL_INFERENCE(teamBaseline, (
    SELECT event_idx,
        TENSOR_AGG(n, e, z AT (station_slot, sample_idx) SHAPE (25, 3000, 3)) AS waveforms,
        TENSOR_AGG(latitude, longitude, depth_km AT (station_slot) SHAPE (25, 3)) AS coords
    FROM stations
    GROUP BY event_idx
    WINDOW TUMBLING(timestamp_ms, SIZE 31 SEC)))
INTO prediction;
----
3,3.495391,41.980669,12.108277,52.812177
26,3.484021,41.981246,12.127388,51.288474
47,3.496059,41.999821,12.096440,52.312624
