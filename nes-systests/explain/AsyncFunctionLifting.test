# name: explain/AsyncFunctionLifting.test
# description: Each async occurrence becomes an append operator; equal calls are not merged.
# groups: [explain, async]

CREATE LOGICAL SOURCE textStream(id UINT64 NOT NULL, data VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR textStream TYPE File;
ATTACH INLINE
1,Hello

CREATE SINK callSink(id UINT64 NOT NULL, response VARSIZED NOT NULL) TYPE File;
CREATE SINK filterSink(id UINT64 NOT NULL, data VARSIZED NOT NULL) TYPE File;

# Logical operators append named results. Padding is deferred to decomposition.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, HTTP_CALL(data, 'http://localhost/echo') AS response FROM textStream INTO callSink;
----
== Optimized Global Plan ==
SINK(CALLSINK)
  PROJECTION(fields: [ID, __ASYNC_CALL_0 as RESPONSE])
    ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_0])
      SOURCE(TEXTSTREAM)
==END==

# A synchronous argument is computed before its async operator.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, CONCAT(HTTP_CALL(CONCAT(data, '!'), 'http://localhost/echo'), '?') AS response FROM textStream INTO callSink;
----
== Optimized Global Plan ==
SINK(CALLSINK)
  PROJECTION(fields: [ID, CONCAT(__ASYNC_CALL_1, ?) as RESPONSE])
    ASYNC HTTP_CALL(args: [__ASYNC_ARG_0, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_1])
      PROJECTION(fields: [DATA, ID, CONCAT(DATA, !) as __ASYNC_ARG_0])
        SOURCE(TEXTSTREAM)
==END==

# Synchronous work between calls remains between their operators.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, HTTP_CALL(CONCAT(HTTP_CALL(data, 'http://localhost/a'), data), 'http://localhost/b') AS response FROM textStream INTO callSink;
----
== Optimized Global Plan ==
SINK(CALLSINK)
  PROJECTION(fields: [ID, __ASYNC_CALL_2 as RESPONSE])
    ASYNC HTTP_CALL(args: [__ASYNC_ARG_1, http://localhost/b], outputs: [RESPONSE as __ASYNC_CALL_2])
      PROJECTION(fields: [DATA, ID, CONCAT(__ASYNC_CALL_0, DATA) as __ASYNC_ARG_1, __ASYNC_CALL_0])
        ASYNC HTTP_CALL(args: [DATA, http://localhost/a], outputs: [RESPONSE as __ASYNC_CALL_0])
          SOURCE(TEXTSTREAM)
==END==

# Identical written calls are distinct occurrences, with distinct result fields.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, CONCAT(HTTP_CALL(data, 'http://localhost/echo'), HTTP_CALL(data, 'http://localhost/echo')) AS response FROM textStream INTO callSink;
----
== Optimized Global Plan ==
SINK(CALLSINK)
  PROJECTION(fields: [ID, CONCAT(__ASYNC_CALL_0, __ASYNC_CALL_1) as RESPONSE])
    ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_1])
      ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_0])
        SOURCE(TEXTSTREAM)
==END==

# A physical padding projection supplies the slots required by the handoff buffer layout.
# Placement varies by topology; each sender/receiver pair still shares a worker.
EXPLAIN (DISTRIBUTED) FORMAT TEXT
SELECT id, HTTP_CALL(data, 'http://localhost/echo') AS response FROM textStream INTO callSink;
----
<REGEX>
-- [0-9]+ plan\(s\) on [a-z0-9-]+:[0-9]+ --
(?:(?!--).*\n)*SINK\(HANDOFF\)
  PROJECTION\(fields: \[ID, DATA,  as __ASYNC_CALL_0\]\)
    SOURCE\((?:TEXTSTREAM|NETWORK)\)
(?:(?!--).*\n)*.*SOURCE\(ASYNC\)
</REGEX>
<REGEX>PROJECTION\(fields: \[ID, __ASYNC_CALL_0 as RESPONSE\]\)</REGEX>
<REGEX>SINK\(CALLSINK\)</REGEX>
<!REGEX>HTTP_CALL</!REGEX>
==END==

# Each occurrence gets its own pair; computed arguments may cross a network boundary.
EXPLAIN (DISTRIBUTED) FORMAT TEXT
SELECT id, HTTP_CALL(CONCAT(HTTP_CALL(data, 'http://localhost/a'), data), 'http://localhost/b') AS response FROM textStream INTO callSink;
----
<REGEX>
-- [0-9]+ plan\(s\) on [a-z0-9-]+:[0-9]+ --
(?:(?!--).*\n)*SINK\(HANDOFF\)
  PROJECTION\(fields: \[ID, DATA,  as __ASYNC_CALL_0\]\)
    SOURCE\((?:TEXTSTREAM|NETWORK)\)
(?:(?!--).*\n)*.*SOURCE\(ASYNC\)
</REGEX>
<REGEX>PROJECTION\(fields: \[DATA, ID, __ASYNC_ARG_1, __ASYNC_CALL_0,  as __ASYNC_CALL_2\]\)</REGEX>
<REGEX>PROJECTION\(fields: \[ID, __ASYNC_CALL_2 as RESPONSE\]\)</REGEX>
<REGEX>SINK\(CALLSINK\)</REGEX>
<!REGEX>HTTP_CALL</!REGEX>
==END==

# Predicate calls run below their selection; helper fields are not visible above it.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, data FROM textStream WHERE HTTP_CALL(data, 'http://localhost/echo') = 'echo:Hello' INTO filterSink;
----
== Optimized Global Plan ==
SINK(FILTERSINK)
  PROJECTION(fields: [DATA, ID])
    SELECTION(__ASYNC_CALL_0 = echo:Hello)
      ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_0])
        SOURCE(TEXTSTREAM)
==END==

EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, data FROM textStream WHERE HTTP_CALL(HTTP_CALL(data, 'http://localhost/echo'), 'http://localhost/echo') = 'echo:Hello' INTO filterSink;
----
== Optimized Global Plan ==
SINK(FILTERSINK)
  PROJECTION(fields: [DATA, ID])
    SELECTION(__ASYNC_CALL_1 = echo:Hello)
      ASYNC HTTP_CALL(args: [__ASYNC_CALL_0, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_1])
        ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_0])
          SOURCE(TEXTSTREAM)
==END==

# WHERE and SELECT contain four occurrences, not two shared calls.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, HTTP_CALL(HTTP_CALL(data, 'http://localhost/echo'), 'http://localhost/echo') AS response
FROM textStream
WHERE HTTP_CALL(HTTP_CALL(data, 'http://localhost/echo'), 'http://localhost/echo') = 'echo:Hello'
INTO callSink;
----
== Optimized Global Plan ==
SINK(CALLSINK)
  PROJECTION(fields: [ID, __ASYNC_CALL_3 as RESPONSE])
    ASYNC HTTP_CALL(args: [__ASYNC_CALL_2, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_3])
      ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_2])
        PROJECTION(fields: [DATA, ID])
          SELECTION(__ASYNC_CALL_1 = echo:Hello)
            ASYNC HTTP_CALL(args: [__ASYNC_CALL_0, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_1])
              ASYNC HTTP_CALL(args: [DATA, http://localhost/echo], outputs: [RESPONSE as __ASYNC_CALL_0])
                SOURCE(TEXTSTREAM)
==END==

# Directly nested calls also remain separate operators.
EXPLAIN (OPTIMIZED) FORMAT TEXT
SELECT id, HTTP_CALL(HTTP_CALL(data, 'http://localhost/a'), 'http://localhost/b') AS response FROM textStream INTO callSink;
----
== Optimized Global Plan ==
SINK(CALLSINK)
  PROJECTION(fields: [ID, __ASYNC_CALL_1 as RESPONSE])
    ASYNC HTTP_CALL(args: [__ASYNC_CALL_0, http://localhost/b], outputs: [RESPONSE as __ASYNC_CALL_1])
      ASYNC HTTP_CALL(args: [DATA, http://localhost/a], outputs: [RESPONSE as __ASYNC_CALL_0])
        SOURCE(TEXTSTREAM)
==END==
