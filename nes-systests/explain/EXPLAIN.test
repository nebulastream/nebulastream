# name: explain/EXPLAIN.test
# description: Validates the output of EXPLAIN statements: the pipelines that Calcite places on the workers.
# groups: [explain, inference]

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,1000
2,3,2000

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE File;
ATTACH INLINE
1,2,1000
2,4,2000

CREATE SINK sinkFilter(id UINT64 NOT NULL, value UINT64 NOT NULL) TYPE File;
CREATE SINK sinkJoin(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL, id2 UINT64 NOT NULL, value2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL) TYPE File;

CREATE MODEL iris ('model/iris.onnx')
INPUT (p1 FLOAT32, p2 FLOAT32, p3 FLOAT32, p4 FLOAT32)
OUTPUT (setosa FLOAT32, versicolor FLOAT32, virginica FLOAT32);

CREATE LOGICAL SOURCE stream_inference(p1 FLOAT32 NOT NULL, p2 FLOAT32 NOT NULL, p3 FLOAT32 NOT NULL, p4 FLOAT32 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream_inference TYPE File;
ATTACH INLINE
6.1,3.5,1.4,0.2
4.9,3.0,1.4,0.2
4.7,3.2,1.3,0.2



# A selection and a projection
EXPLAIN FORMAT TEXT SELECT id, "VALUE" FROM "STREAM" WHERE "VALUE" > 2 INTO sinkFilter;
----
== Placed Pipelines ==
on sink-node:8080:
Sink(names=[[ID, VALUE]])
  Emit(fields=[[ID, VALUE]], layout=[CSV])
    Scan(fields=[[ID, VALUE]], layout=[ROW(ID, VALUE)])
      NetworkSource(from=[source-node:8080], channel=[channel-1])
on source-node:8080:
NetworkSink(to=[sink-node:8080], channel=[channel-1])
  Emit(fields=[[ID, VALUE]], layout=[ROW(ID, VALUE)])
    Selection(condition=[>($1, CAST(2):BIGINT UNSIGNED NOT NULL)])
      Scan(fields=[[ID, VALUE, TIMESTAMP]], layout=[CSV])
        SourceScan(table=[[STREAM]], physicalSource=[1])
==END==

# A window join, with an event-time watermark assigner after each source
EXPLAIN FORMAT TEXT
SELECT a.window_start AS "START", a.window_end AS "END", a.id, a."VALUE", a."TIMESTAMP", b.id2, b.value2, b.timestamp2
FROM TABLE(TUMBLE(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '1' SECOND)) AS a
JOIN TABLE(TUMBLE(TABLE stream2, DESCRIPTOR(timestamp2), INTERVAL '1' SECOND)) AS b
ON a.window_start = b.window_start AND a.id = b.id2
INTO sinkJoin;
----
== Placed Pipelines ==
on sink-node:8080:
Sink(names=[[START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2]])
  Emit(fields=[[START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2]], layout=[CSV])
    Scan(fields=[[START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2]], layout=[ROW(START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2)])
      NetworkSource(from=[source-node:8080], channel=[channel-1])
on source-node:8080:
NetworkSink(to=[sink-node:8080], channel=[channel-1])
  Emit(fields=[[START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2]], layout=[ROW(START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2)])
    JoinProbe(join=[1], type=[INNER], implementation=[HASH_JOIN], kind=[TUMBLING], size=[1000], condition=[=($0, $3)], fields=[[START, END, ID, VALUE, TIMESTAMP, ID2, VALUE2, TIMESTAMP2]])
      JoinBuild(join=[1], side=[left], time=[TIMESTAMP], stored=[[ID, VALUE, TIMESTAMP]])
        WatermarkAssigner(time=[TIMESTAMP])
          Scan(fields=[[ID, VALUE, TIMESTAMP]], layout=[CSV])
            SourceScan(table=[[STREAM]], physicalSource=[1])
      JoinBuild(join=[1], side=[right], time=[TIMESTAMP2], stored=[[ID2, VALUE2, TIMESTAMP2]])
        WatermarkAssigner(time=[TIMESTAMP2])
          Scan(fields=[[ID2, VALUE2, TIMESTAMP2]], layout=[CSV])
            SourceScan(table=[[STREAM2]], physicalSource=[2])
==END==

# A union of two selections with computed fields
EXPLAIN FORMAT TEXT
SELECT id * 2 AS id FROM "STREAM" WHERE id > 0
UNION ALL
SELECT id2 * 2 AS id FROM stream2 WHERE id2 > 0
INTO File();
----
== Placed Pipelines ==
on sink-node:8080:
Sink(names=[[ID]])
  Emit(fields=[[CALCITE_F0]], layout=[CSV])
    Map(CALCITE_F0=[*($0, CAST(2):BIGINT UNSIGNED NOT NULL)])
      Scan(fields=[[ID, VALUE, TIMESTAMP]], layout=[ROW(ID, VALUE, TIMESTAMP)])
        NetworkSource(from=[source-node:8080], channel=[channel-1])
  Emit(fields=[[CALCITE_F1]], layout=[CSV])
    Map(CALCITE_F1=[*($0, CAST(2):BIGINT UNSIGNED NOT NULL)])
      Scan(fields=[[ID2, VALUE2, TIMESTAMP2]], layout=[ROW(ID2, VALUE2, TIMESTAMP2)])
        NetworkSource(from=[source-node:8080], channel=[channel-2])
on source-node:8080:
NetworkSink(to=[sink-node:8080], channel=[channel-1])
  Emit(fields=[[ID, VALUE, TIMESTAMP]], layout=[ROW(ID, VALUE, TIMESTAMP)])
    Selection(condition=[>($0, CAST(0):BIGINT UNSIGNED NOT NULL)])
      Scan(fields=[[ID, VALUE, TIMESTAMP]], layout=[CSV])
        SourceScan(table=[[STREAM]], physicalSource=[1])
on source-node:8080:
NetworkSink(to=[sink-node:8080], channel=[channel-2])
  Emit(fields=[[ID2, VALUE2, TIMESTAMP2]], layout=[ROW(ID2, VALUE2, TIMESTAMP2)])
    Selection(condition=[>($0, CAST(0):BIGINT UNSIGNED NOT NULL)])
      Scan(fields=[[ID2, VALUE2, TIMESTAMP2]], layout=[CSV])
        SourceScan(table=[[STREAM2]], physicalSource=[2])
==END==

# Model inference
EXPLAIN FORMAT TEXT
SELECT * FROM TABLE(MODEL_INFERENCE(TABLE stream_inference, 'iris'))
INTO File();
----
== Placed Pipelines ==
on sink-node:8080:
Sink(names=[[P1, P2, P3, P4, SETOSA, VERSICOLOR, VIRGINICA]])
  Emit(fields=[[P1, P2, P3, P4, CALCITE_F0, CALCITE_F1, CALCITE_F2]], layout=[CSV])
    InferModel(model=[IRIS], reads=[[0, 1, 2, 3]], appends=[[CALCITE_F0, CALCITE_F1, CALCITE_F2]])
      Scan(fields=[[P1, P2, P3, P4]], layout=[ROW(P1, P2, P3, P4)])
        NetworkSource(from=[source-node:8080], channel=[channel-1])
on source-node:8080:
NetworkSink(to=[sink-node:8080], channel=[channel-1])
  Emit(fields=[[P1, P2, P3, P4]], layout=[ROW(P1, P2, P3, P4)])
    Scan(fields=[[P1, P2, P3, P4]], layout=[CSV])
      SourceScan(table=[[STREAM_INFERENCE]], physicalSource=[1])
==END==
