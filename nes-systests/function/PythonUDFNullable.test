# name: function/PythonUDFNullable.test
# description: Passes nullable arguments as Python None and accepts None from explicitly nullable Python UDFs
# groups: [Function, PythonUDF, NullHandling, CompilerOnly, CompilationIntensive]

GlobalConfiguration worker.dump_compilation_result: [FILE]

CREATE LOGICAL SOURCE nullable_values(id UINT64 NOT NULL, number INT64, text VARSIZED);
CREATE PHYSICAL SOURCE FOR nullable_values TYPE File;
ATTACH INLINE
1,5,hello
2,,
3,,x
4,7,

CREATE SINK nullable_sink(result INT64) TYPE File;

# Both nullable scalar and VARSIZED arguments arrive as None. The UDF can also return None.
CREATE FUNCTION udf_1 (number INT64, text VARSIZED) RETURNS INT64 BRIDGE 'codon' AS $python$
    if number is None and text is None:
        return None
    result = 0 if number is None else number
    if text is not None:
        result += len(text)
    return result
$python$;

SELECT udf_1(number, text) AS result
FROM nullable_values
INTO nullable_sink;
----
10
NULL
1
7

# The UDF can turn None into a value.
CREATE FUNCTION udf_2 (number INT64) RETURNS INT64 BRIDGE 'codon' AS $python$
return 100 if number is None else number
$python$;

SELECT udf_2(number) AS result
FROM nullable_values
INTO nullable_sink;
----
5
100
100
7
