# name: function/PythonUDFError.test
# description: Reports exceptions raised by a Python UDF as query errors without terminating the worker
# groups: [Function, PythonUDF, CompilerOnly]

GlobalConfiguration worker.dump_compilation_result: [FILE]

CREATE LOGICAL SOURCE numbers(value VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR numbers TYPE File;
ATTACH INLINE
24.4

CREATE SINK sink(result UINT64 NOT NULL) TYPE File;

CREATE FUNCTION udf_1 (value VARSIZED) RETURNS UINT64 EXECUTION INLINE AS $python$
    return int(value)
$python$;

SELECT udf_1(value) AS result
FROM numbers
INTO file();
----
ERROR UdfExecutionError "Python UDF failed: invalid literal for int() with base 10: '24.4'"


# The argument type has to match the declared one: a VARSIZED column is no UINT64 argument
CREATE FUNCTION udf_2 (value UINT64) RETURNS UINT64 EXECUTION INLINE AS $python$
    return value
$python$;

SELECT udf_2(value) AS result
FROM numbers
INTO file();
----
ERROR 2028
