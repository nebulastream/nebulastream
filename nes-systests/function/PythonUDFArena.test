# name: function/PythonUDFArena.test
# description: Grows a Codon list through the NES arena-backed allocation and realloc ABI
# groups: [Function, PythonUDF, CompilerOnly]

GlobalConfiguration worker.dump_compilation_result: [FILE]

CREATE LOGICAL SOURCE numbers(n UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR numbers TYPE File;
ATTACH INLINE
10000

CREATE FUNCTION udf_1 (n UINT64) RETURNS UINT64 EXECUTION INLINE AS $python$
    values = []
    for value in range(n):
        values.append(value)
    return len(values)
$python$;

SELECT udf_1(n) AS result
FROM numbers
INTO file();
----
10000

# Rejected at registration: an uncollectable allocation would outlive the UDF invocation.
CREATE FUNCTION udf_2 (n UINT64) RETURNS UINT64 EXECUTION INLINE AS $python$
    from internal.gc import add_roots, alloc_uncollectable
    allocation = alloc_uncollectable(8)
    add_roots(allocation, allocation)
    return n
$python$;
----
ERROR QueryCompilerError

# Rejected at registration: sleep needs a runtime function that NES does not provide to UDFs.
CREATE FUNCTION udf_3 (n UINT64) RETURNS UINT64 EXECUTION INLINE AS $python$
from time import sleep
sleep(0.0)
return n
$python$;
----
ERROR QueryCompilerError
