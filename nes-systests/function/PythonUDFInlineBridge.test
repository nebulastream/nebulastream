# name: function/PythonUDFInlineBridge.test
# description: CREATE FUNCTION ... AS body run by the cpython interpreter backend instead of a Codon AOT compile
# groups: [Function, PythonUDF, PythonUdf]

CREATE LOGICAL SOURCE values(id UINT64 NOT NULL, number INT64, text VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR values TYPE File;
ATTACH INLINE
1,5,10
2,,20
3,-7,30

CREATE FUNCTION udf_1 (id UINT64, number INT64, text VARSIZED) RETURNS INT64 EXECUTION IN_PROCESS AS $python$
    if number is None:
        return None
    return int(id) + number + int(text)
$python$;

SELECT udf_1(id, number, text) AS result
FROM values
INTO file();
