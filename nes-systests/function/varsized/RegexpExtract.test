# name: function/varsized/RegexpExtract.test
# description: Tests REGEXP_EXTRACT(str, regex [, group]), which returns a capture group of the first match (NULL if there is none)
# groups: [Function, Text, Projection]

CREATE LOGICAL SOURCE bids(id UINT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR bids TYPE File;
ATTACH INLINE
1,Apple,https://www.nexmark.com/item.htm?query=1
2,Google,https://www.nexmark.com/item.htm?query=1&channel_id=42
3,other,https://www.nexmark.com/item.htm?channel_id=7&query=1
4,other,channel_id=abc
5,other,https://www.nexmark.com/item.htm?query=1&channel_id=
6,other,https://www.nexmark.com/item.htm?query=1&xchannel_id=5
7,other,

CREATE LOGICAL SOURCE nullableInputs(id UINT64 NOT NULL, text VARSIZED, regex VARSIZED, grp INT32);
CREATE PHYSICAL SOURCE FOR nullableInputs TYPE File;
ATTACH INLINE
1,abc123def,([a-z]+)([0-9]+),2
2,,([a-z]+)([0-9]+),2
3,abc123def,,2
4,abc123def,([a-z]+)([0-9]+),
5,abc123def,([a-z]+)([0-9]+),3
6,abc123def,([a-z]+)([0-9]+),-1
7,abc123def,(x)?([a-z]+),1
8,abc123def,([,1

CREATE LOGICAL SOURCE WrongDataType(id UINT64 NOT NULL, text VARSIZED NOT NULL, number FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR WrongDataType TYPE File;
ATTACH INLINE
1,abc,1.0

# Nexmark q21: the channel id is the second group, NULL if the parameter is absent
SELECT id, REGEXP_EXTRACT(url, '(&|^)channel_id=([^&]*)', 2) AS channel_id FROM bids INTO FILE();
----
1,NULL
2,42
3,NULL
4,abc
5,
6,NULL
7,NULL

# Group 0 is the whole match, which is also the default without a group argument
SELECT id, REGEXP_EXTRACT(url, 'channel_id=[0-9]+', 0) AS explicitGroup, REGEXP_EXTRACT(url, 'channel_id=[0-9]+') AS defaultGroup FROM bids INTO FILE();
----
1,NULL,NULL
2,channel_id=42,channel_id=42
3,channel_id=7,channel_id=7
4,NULL,NULL
5,NULL,NULL
6,channel_id=5,channel_id=5
7,NULL,NULL

# Nexmark q21 CASE combining LOWER and REGEXP_EXTRACT
SELECT id,
       CASE
           WHEN LOWER(channel) = 'apple' THEN '0'
           WHEN LOWER(channel) = 'google' THEN '1'
           ELSE REGEXP_EXTRACT(url, '(&|^)channel_id=([^&]*)', 2)
       END AS channel_id
FROM bids
INTO FILE();
----
1,0
2,1
3,NULL
4,abc
5,
6,NULL
7,NULL

# Non-constant arguments: NULL inputs, out-of-range groups, non-participating groups and invalid regexes give NULL
SELECT id, REGEXP_EXTRACT(text, regex, grp) AS extracted FROM nullableInputs INTO FILE();
----
1,123
2,NULL
3,NULL
4,NULL
5,NULL
6,NULL
7,NULL
8,NULL

# An invalid constant regex is rejected when the query is compiled
SELECT id, REGEXP_EXTRACT(url, '([', 1) AS extracted FROM bids INTO FILE();
----
ERROR 2010

SELECT id, REGEXP_EXTRACT(text, '(a)', number) AS extracted FROM WrongDataType INTO FILE();
----
ERROR 2006

SELECT id, REGEXP_EXTRACT(text) AS extracted FROM WrongDataType INTO FILE();
----
ERROR 2002
