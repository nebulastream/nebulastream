# name: function/PythonUDFCv2WarpAffine.test
# description: Shifts a 16-bit frame with cv2.warpAffine (linear interpolation, replicated border) through the embedded Codon cv2 facade
# groups: [Function, PythonUDF, CompilerOnly]

CREATE LOGICAL SOURCE frames(encoded VARSIZED NOT NULL, width UINT64 NOT NULL, height UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR frames TYPE File;
ATTACH INLINE
,16,12

CREATE SINK sink(aligned VARSIZED NOT NULL) TYPE File;

SELECT TO_BASE64(PYTHON((image, width, height): $python$
    import cv2
    import numpy as np

    mono16 = np.frombuffer(image, dtype=np.uint16).reshape((int(height), int(width)))
    m = np.array([[1.0, 0.0, -3.0], [0.0, 1.0, -6.0]])
    aligned = cv2.warpAffine(mono16, m, (int(width), int(height)), flags=cv2.INTER_LINEAR, borderMode=cv2.BORDER_REPLICATE)
    return str(aligned.data.as_byte(), int(aligned.nbytes))
$python$) AS VARSIZED) AS aligned
FROM (SELECT FROM_BASE64(encoded) AS image, width, height FROM frames)
INTO sink;
----

