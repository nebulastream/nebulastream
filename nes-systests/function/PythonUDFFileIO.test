# name: function/PythonUDFFileIO.test
# description: Characterizes Codon's handling of Python file reads and HTTP requests
# groups: [Function, PythonUDF, CompilerOnly]

GlobalConfiguration worker.dump_compilation_result: [FILE]

CREATE LOGICAL SOURCE trigger(id UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR trigger TYPE File;
ATTACH INLINE
1

# Rejected at registration: file access needs libc functions that the NES runtime does not provide to UDFs.
CREATE FUNCTION udf_1 (id UINT64) RETURNS VARSIZED EXECUTION INLINE AS $python$
    file = open("TESTDATA/python_udf/file_input.txt", "r")
    contents = file.read()
    file.close()
    return contents
$python$;
----
ERROR QueryCompilerError

# Codon currently has no urllib/HTTP implementation in its bundled standard library, so this
# characterizes the import-time rejection at registration rather than an external-symbol rejection.
CREATE FUNCTION udf_2 (id UINT64) RETURNS VARSIZED EXECUTION INLINE AS $python$
    from urllib.request import urlopen
    response = urlopen("http://127.0.0.1:8080/")
    return response.read()
$python$;
----
ERROR QueryCompilerError

# The rejected registrations above are the test. Systest checks them when it runs the file, which needs a query.
SELECT id FROM trigger INTO file();
----
1
