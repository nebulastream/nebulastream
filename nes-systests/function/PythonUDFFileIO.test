# name: function/PythonUDFFileIO.test
# description: Characterizes Codon's handling of Python file reads and HTTP requests
# groups: [Function, PythonUDF, CompilerOnly]

GlobalConfiguration worker.dump_compilation_result: [FILE]

CREATE LOGICAL SOURCE trigger(id UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR trigger TYPE File;
ATTACH INLINE
1

SELECT PYTHON((id): $python$
    file = open("TESTDATA/python_udf/file_input.txt", "r")
    contents = file.read()
    file.close()
    return contents
$python$) AS VARSIZED AS contents
FROM trigger
INTO file();
----
ERROR QueryCompilerError

# Codon currently has no urllib/HTTP implementation in its bundled standard library, so this
# characterizes the import-time rejection rather than an external-symbol rejection.
SELECT PYTHON((id): $python$
    from urllib.request import urlopen
    response = urlopen("http://127.0.0.1:8080/")
    return response.read()
$python$) AS VARSIZED AS contents
FROM trigger
INTO file();
----
ERROR QueryCompilerError
