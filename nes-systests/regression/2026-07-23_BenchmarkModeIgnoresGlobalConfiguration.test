       COUNT(value) as out48, COUNT(value) as out49, COUNT(value) as out50, COUNT(value) as out51,
       COUNT(value) as out52, COUNT(value) as out53, COUNT(value) as out54, COUNT(value) as out55,
       COUNT(value) as out56, COUNT(value) as out57, COUNT(value) as out58, COUNT(value) as out59,
       COUNT(value) as out60, COUNT(value) as out61, COUNT(value) as out62, COUNT(value) as out63,
       COUNT(value) as out64, COUNT(value) as out65, COUNT(value) as out66, COUNT(value) as out67,
       COUNT(value) as out68, COUNT(value) as out69, COUNT(value) as out70, COUNT(value) as out71,
       COUNT(value) as out72, COUNT(value) as out73, COUNT(value) as out74, COUNT(value) as out75,
       COUNT(value) as out76, COUNT(value) as out77, COUNT(value) as out78, COUNT(value) as out79,
       COUNT(value) as out80, COUNT(value) as out81, COUNT(value) as out82, COUNT(value) as out83,
