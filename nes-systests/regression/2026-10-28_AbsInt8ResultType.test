# description: ABS(INT8) consumed by MIN/MAX must compile and keep its type.
# Negating a negative input once promoted the result to INT32, causing "select with different types" when MIN/MAX
# compared it with their state. In Calcite's types ABS(TINYINT) is a TINYINT, so ABS(-128) wraps to -128 before MIN/MAX.
# groups: [regression, Function, FunctionAbs, Aggregation, WindowOperators]

CREATE LOGICAL SOURCE aggregateStream(i8 INT8 NOT NULL, nullableI8 INT8, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR aggregateStream TYPE File;
ATTACH INLINE
-128,-128,0
-7,-7,1
0,0,2
7,7,3
42,,4
-7,,10
7,,11

# Consume ABS directly: an intermediate emit/scan could narrow the value and hide the bug.
# Include INT8_MIN: its absolute value does not fit TINYINT and wraps to -128.
SELECT window_start AS "START", MIN(ABS(i8)) AS minimum, MAX(ABS(i8)) AS maximum
FROM TABLE(TUMBLE(TABLE aggregateStream, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.01' SECOND))
GROUP BY window_start, window_end
INTO File();
----
0,-128,42
10,7,7

# The first window mixes NULL and non-NULL inputs; the second contains only NULLs.
# MIN/MAX must ignore NULLs in the first and preserve NULL results in the second.
SELECT window_start AS "START", MIN(ABS(nullableI8)) AS minimum, MAX(ABS(nullableI8)) AS maximum
FROM TABLE(TUMBLE(TABLE aggregateStream, DESCRIPTOR("TIMESTAMP"), INTERVAL '0.01' SECOND))
GROUP BY window_start, window_end
INTO File();
----
0,-128,7
10,NULL,NULL
