# description: reproduces for https://github.com/nebulastream/nebulastream/issues/1052
# groups: [regression]

CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, timestamp1 UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE FileSource;
ATTACH INLINE
1,1
2,1
3,1

CREATE LOGICAL SOURCE stream2(id2 UINT64 NOT NULL, timestamp2 UINT64 NOT NULL, e BOOLEAN NOT NULL);
CREATE PHYSICAL SOURCE FOR stream2 TYPE FileSource;
ATTACH INLINE
1,1,false
2,1,false
3,1,false

CREATE SINK sink(i UINT64 NOT NULL) TYPE FileSink;


SELECT id AS i FROM (SELECT * FROM stream)
INNER JOIN (SELECT * FROM stream2)
ON id = id2
AND NOT e
BINARY_WINDOW TUMBLING (timestamp1, timestamp2, size 1 sec) INTO sink;
----
1
2
3
