# name: DeeplyNestedVarsizedEquality.test
# groups: [Varsized, Selection]

CREATE LOGICAL SOURCE T(ID INT64 NOT NULL, V1 VARSIZED NOT NULL, V2 VARSIZED NOT NULL, V3 VARSIZED NOT NULL, V4 VARSIZED NOT NULL, V5 VARSIZED NOT NULL, V6 VARSIZED NOT NULL, V7 VARSIZED NOT NULL, V8 VARSIZED NOT NULL, V9 VARSIZED NOT NULL, V10 VARSIZED NOT NULL, V11 VARSIZED NOT NULL, V12 VARSIZED NOT NULL, V13 VARSIZED NOT NULL, V14 VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR T TYPE File;
ATTACH INLINE
1,v1,v2,v3,v4,v5,v6,v7,v8,v9,v10,v11,v12,v13,v14
2,z,z,z,z,z,z,z,z,z,z,z,z,z,z

CREATE SINK idSink(ID INT64 NOT NULL) TYPE File;

# k=12 VARSIZED comparisons, pure AND chain, no OR
SELECT ID FROM T WHERE V1 = VARSIZED('v1') AND V2 = VARSIZED('v2') AND V3 = VARSIZED('v3') AND V4 = VARSIZED('v4') AND V5 = VARSIZED('v5') AND V6 = VARSIZED('v6') AND V7 = VARSIZED('v7') AND V8 = VARSIZED('v8') AND V9 = VARSIZED('v9') AND V10 = VARSIZED('v10') AND V11 = VARSIZED('v11') AND V12 = VARSIZED('v12') INTO idSink;
----
1
