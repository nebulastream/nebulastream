# name: datatype/NumericLiterals.test
# description: Numeric literals have Calcite's types: an integer is an INTEGER, or a BIGINT beyond its range, and a
#   fractional number is written as a DOUBLE (1.5E0), as decimals (1.5) are not supported
# groups: [DataTypes, NumericLiterals]

CREATE LOGICAL SOURCE stream(u8 UINT8 NOT NULL, u16 UINT16 NOT NULL, i64 INT64 NOT NULL, f64 FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,256,41,1.5

CREATE SINK sink(one INT32 NOT NULL, two_fifty_six INT32 NOT NULL, sixty_five_k INT32 NOT NULL, four_g INT64 NOT NULL, minus_one INT32 NOT NULL, minus_129 INT32 NOT NULL, minus_32769 INT32 NOT NULL, minus_2147483649 INT64 NOT NULL, float_literal FLOAT64 NOT NULL, negative_float FLOAT64 NOT NULL, explicit_uint8 UINT8 NOT NULL, explicit_uint16 UINT16 NOT NULL, comparison BOOLEAN NOT NULL, sum_value INT64 NOT NULL, float_sum FLOAT64 NOT NULL) TYPE File;

SELECT
    1 AS "ONE",
    256 AS two_fifty_six,
    65536 AS sixty_five_k,
    4294967296 AS four_g,
    -1 AS minus_one,
    -129 AS minus_129,
    -32769 AS minus_32769,
    -2147483649 AS minus_2147483649,
    1.5E0 AS float_literal,
    -0.5E0 AS negative_float,
    CAST(255 AS TINYINT UNSIGNED) AS explicit_uint8,
    CAST(65535 AS SMALLINT UNSIGNED) AS explicit_uint16,
    u16 = 256 AS comparison,
    i64 + 1 AS sum_value,
    f64 + 1.5E0 AS float_sum
FROM "STREAM" WHERE u8 = 1 AND u16 = 256 INTO sink;
----
1,256,65536,4294967296,-1,-129,-32769,-2147483649,1.5,-0.5,255,65535,true,42,3.0
