# name: parser/RenameAfterAgg.test
# description: Checks that AS renames of window aggregates and window bounds reach the sink in any SELECT order
# groups: [Parser]

CREATE LOGICAL SOURCE input(
    id UINT64 NOT NULL,
    value UINT64 NOT NULL,
    ts UINT64 NOT NULL
);

CREATE PHYSICAL SOURCE FOR input TYPE File;
ATTACH INLINE
1,10,1000
1,20,1010

CREATE SINK output(
    id UINT64 NOT NULL,
    sumValue UINT64,
    startValue UINT64 NOT NULL
) TYPE File;

CREATE SINK output2(
    id UINT64 NOT NULL,
    sumValue UINT64,
    start UINT64 NOT NULL
) TYPE File;

SELECT id, SUM("VALUE") AS sumValue, window_start AS startValue
FROM TABLE(HOP(TABLE input, DESCRIPTOR(ts), INTERVAL '0.005' SECOND, INTERVAL '0.01' SECOND))
GROUP BY window_start, window_end, id
INTO output;
----
1 10 995
1 10 1000
1 20 1005
1 20 1010

SELECT id, window_start AS startValue, SUM("VALUE") AS sumValue
FROM TABLE(HOP(TABLE input, DESCRIPTOR(ts), INTERVAL '0.005' SECOND, INTERVAL '0.01' SECOND))
GROUP BY window_start, window_end, id
INTO output;
----
1 10 995
1 10 1000
1 20 1005
1 20 1010

SELECT id, SUM("VALUE") AS sumValue, window_start AS "START"
FROM TABLE(HOP(TABLE input, DESCRIPTOR(ts), INTERVAL '0.005' SECOND, INTERVAL '0.01' SECOND))
GROUP BY window_start, window_end, id
INTO output2;
----
1 10 995
1 10 1000
1 20 1005
1 20 1010
