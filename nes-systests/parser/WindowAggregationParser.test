# name: parser/WindowAggregationParser.test
# description: Sliding-window aggregation with WHERE, GROUP BY and HAVING, and rejection of malformed aggregation queries
# groups: [Aggregation, WindowOperators, Parser]

# Source definitions
CREATE LOGICAL SOURCE stream(id UINT64 NOT NULL, value UINT64 NOT NULL, timestamp UINT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR stream TYPE File;
ATTACH INLINE
1,1,1000
12,1,1001
4,1,1002
1,2,2000
11,2,2001
16,2,2002
1,3,3000
11,3,3001
1,3,3003
1,3,3200
1,4,4000
1,5,5000
1,6,6000
1,7,7000
1,8,8000
1,9,9000
1,10,10000
1,11,11000
1,12,12000
1,13,13000
1,14,14000
1,15,15000
1,16,16000
1,17,17000
1,18,18000
1,19,19000
1,20,20000
1,21,21000

CREATE SINK sinkStream(start UINT64 NOT NULL, end UINT64 NOT NULL, id UINT64 NOT NULL, sumValue UINT64)  TYPE File;
CREATE SINK sinkUnbounded(id UINT64 NOT NULL, sumValue UINT64) TYPE File;

# Sliding-window aggregation with a WHERE filter and a GROUP BY key
SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS sumValue
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND))
WHERE id > 15
GROUP BY window_start, window_end, id
INTO sinkStream;
----
2000,3000,16,2
1500,2500,16,2

# HAVING that repeats the projected aggregate expression
SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS sumValue
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND))
WHERE id > 15
GROUP BY window_start, window_end, id
HAVING SUM("VALUE") > 0
INTO sinkStream;
----
2000,3000,16,2
1500,2500,16,2

# HAVING over an aggregate of an expression
SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE" + 1) AS sumValue
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND))
WHERE id > 15
GROUP BY window_start, window_end, id
HAVING SUM("VALUE" + 1) > 0
INTO sinkStream;
----
2000,3000,16,3
1500,2500,16,3

# Filter on the projected aggregate alias (standard SQL does not allow a SELECT alias in HAVING,
# so the filter is applied to the aggregation in a subquery)
SELECT "START", "END", id, sumValue
FROM (SELECT window_start AS "START", window_end AS "END", id, SUM("VALUE") AS sumValue
      FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND))
      WHERE id > 15
      GROUP BY window_start, window_end, id)
WHERE sumValue > 0
INTO sinkStream;
----
2000,3000,16,2
1500,2500,16,2

# Negative test: GROUP BY before WHERE
SELECT SUM("VALUE") AS sumValue
FROM TABLE(HOP(TABLE "STREAM", DESCRIPTOR("TIMESTAMP"), INTERVAL '0.5' SECOND, INTERVAL '1' SECOND))
GROUP BY window_start, window_end, id
WHERE id > 15
INTO sinkStream;
----
ERROR 2000

# Aggregation without a window: an unbounded aggregation over the whole stream
SELECT id, SUM("VALUE") AS sumValue
FROM "STREAM"
WHERE id > 15
GROUP BY id
INTO sinkUnbounded;
----
16,2
