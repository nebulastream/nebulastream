# name: VectorConstruction.test
# description: Exercises the `VECTOR(...)` constructor: element type inference from constants, fields and expressions, implicit casting to the joined element type, vectors of fixed-size arrays, vectors of registered struct plugins (Point), rejection of element types that cannot be joined, and rejection of nested variable-sized element types.
# groups: [Formatter, JSON]

CREATE LOGICAL SOURCE numbers(id UINT64 NOT NULL, a INT32 NOT NULL, b INT32 NOT NULL, c INT64 NOT NULL, f FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR numbers TYPE File;
ATTACH INLINE
1,1,2,3,0.5
2,-4,5,-6,1.25

# Vector from typed constants
SELECT id, VECTOR(INT32(1), INT32(2), INT32(3)) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1,2,3]}
{"ID":2,"VEC":[1,2,3]}

# Vector from raw literals
SELECT id, VECTOR(7, 8, 9) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[7,8,9]}
{"ID":2,"VEC":[7,8,9]}

# Vector with a single element
SELECT id, VECTOR(a) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1]}
{"ID":2,"VEC":[-4]}

# Vector from fields of the same type
SELECT id, VECTOR(a, b) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1,2]}
{"ID":2,"VEC":[-4,5]}

# Vector mixing fields and constants
SELECT id, VECTOR(a, INT32(100), b) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1,100,2]}
{"ID":2,"VEC":[-4,100,5]}

# Vector from expressions
SELECT id, VECTOR(a + b, a * INT32(2), b - a) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[3,2,1]}
{"ID":2,"VEC":[1,-8,9]}

# INT32 and INT64 elements are joined to INT64; negative INT32 values must be sign-extended by the cast
SELECT id, VECTOR(a, c) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1,3]}
{"ID":2,"VEC":[-4,-6]}

# Integer and float elements are joined to FLOAT64
SELECT id, VECTOR(a, f) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1.0,0.5]}
{"ID":2,"VEC":[-4.0,1.25]}

# Constructed vectors can be written into a sink with an explicitly declared vector type
SELECT id, VECTOR(a, b) AS vec FROM numbers INTO File(SCHEMA(id UINT64 NOT NULL, vec INT32 VECTOR NOT NULL) AS "SINK"."SCHEMA", 'JSON' AS "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1,2]}
{"ID":2,"VEC":[-4,5]}

# The sink's vector type can also be declared with the ARRAY[] syntax
SELECT id, VECTOR(a, b, a) AS vec FROM numbers INTO File(SCHEMA(id UINT64 NOT NULL, vec INT32 ARRAY[] NOT NULL) AS "SINK"."SCHEMA", 'JSON' AS "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VEC":[1,2,1]}
{"ID":2,"VEC":[-4,5,-4]}

# Multiple constructed vectors of different lengths in one projection
SELECT id, VECTOR(a) AS v1, VECTOR(a, b, a, b) AS v2 FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"V1":[1],"V2":[1,2,1,2]}
{"ID":2,"V1":[-4],"V2":[-4,5,-4,5]}

# Vector of strings is prohibited (VARSIZED VECTOR nests two variable-sized types)
SELECT id, VECTOR('Hello', 'World') AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2046

# Vector of vectors is prohibited (nests two variable-sized types)
SELECT id, VECTOR(VECTOR(a, b), VECTOR(b, a)) AS matrix FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2046

# Vector of fixed-size arrays (INT32 ARRAY[][2], nesting depth 1) is allowed
SELECT id, VECTOR(ARRAY(a, b), ARRAY(b, a)) AS matrix FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"MATRIX":[[1,2],[2,1]]}
{"ID":2,"MATRIX":[[-4,5],[5,-4]]}

# Vector of fixed-size arrays with three rows
SELECT id, VECTOR(ARRAY(a, b), ARRAY(b, b), ARRAY(INT32(0), a)) AS matrix FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"MATRIX":[[1,2],[2,2],[0,1]]}
{"ID":2,"MATRIX":[[-4,5],[5,5],[0,-4]]}

# Vector of nested fixed-size arrays: Nx2x2
SELECT id, VECTOR(ARRAY(ARRAY(a, b), ARRAY(b, a)), ARRAY(ARRAY(INT32(0), INT32(1)), ARRAY(a, a))) AS cube FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"CUBE":[[[1,2],[2,1]],[[0,1],[1,1]]]}
{"ID":2,"CUBE":[[[-4,5],[5,-4]],[[0,1],[-4,-4]]]}

# A constructed vector can itself be an element of a fixed-size array (INT32 ARRAY[2][], nesting depth 1)
SELECT id, ARRAY(VECTOR(a, b, a), VECTOR(b)) AS vecs FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"VECS":[[1,2,1],[2]]}
{"ID":2,"VECS":[[-4,5,-4],[5]]}

# Element types of nested arrays are not promoted: INT32 ARRAY[2] and INT64 ARRAY[2] cannot be joined
SELECT id, VECTOR(ARRAY(a, b), ARRAY(c, c)) AS matrix FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007

# Inner arrays of different sizes cannot be joined
SELECT id, VECTOR(ARRAY(a, b), ARRAY(a, b, a)) AS matrix FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007

# A scalar and an array cannot be joined
SELECT id, VECTOR(a, ARRAY(a, b)) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007

# A scalar and a vector cannot be joined
SELECT id, VECTOR(a, VECTOR(a, b)) AS vec FROM numbers INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007

# Vectors of existing array / vector columns
CREATE LOGICAL SOURCE pairs(id UINT64 NOT NULL, p1 INT32 ARRAY[2] NOT NULL, p2 INT32 ARRAY[2] NOT NULL, v INT32 VECTOR NOT NULL, w INT32 VECTOR NOT NULL);
CREATE PHYSICAL SOURCE FOR pairs TYPE File SET('JSON' AS INPUT_FORMATTER."TYPE");
ATTACH INLINE
{"ID": 1, "P1": [1, 2], "P2": [3, 4], "V": [1, 2, 3], "W": [4]}
{"ID": 2, "P1": [5, 6], "P2": [7, 8], "V": [9], "W": [10, 11]}

SELECT id, VECTOR(p1, p2) AS matrix FROM pairs INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"MATRIX":[[1,2],[3,4]]}
{"ID":2,"MATRIX":[[5,6],[7,8]]}

# Mixing existing array columns with constructed arrays
SELECT id, VECTOR(p1, ARRAY(INT32(0), INT32(0)), p2) AS matrix FROM pairs INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"MATRIX":[[1,2],[0,0],[3,4]]}
{"ID":2,"MATRIX":[[5,6],[0,0],[7,8]]}

# Constructed vectors next to existing vector columns
SELECT id, v, VECTOR(id, id) AS ids, w FROM pairs INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"V":[1,2,3],"IDS":[1,1],"W":[4]}
{"ID":2,"V":[9],"IDS":[2,2],"W":[10,11]}

# Vector of existing vector columns is prohibited (nests two variable-sized types)
SELECT id, VECTOR(v, w) AS vecs FROM pairs INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2046

# A vector and a fixed-size array cannot be joined
SELECT id, VECTOR(v, p1) AS vec FROM pairs INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007

# Vectors of struct plugins (Point)
CREATE LOGICAL SOURCE coords(id UINT64 NOT NULL, x1 FLOAT64 NOT NULL, y1 FLOAT64 NOT NULL, x2 FLOAT64 NOT NULL, y2 FLOAT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR coords TYPE File;
ATTACH INLINE
1,1.0,2.0,3.0,4.0
2,-1.5,0.5,10.0,20.0

SELECT id, VECTOR(Point(x1, y1), Point(x2, y2)) AS points FROM coords INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"POINTS":[{"x":1.0,"y":2.0},{"x":3.0,"y":4.0}]}
{"ID":2,"POINTS":[{"x":-1.5,"y":0.5},{"x":10.0,"y":20.0}]}

# Points from constants and expressions
SELECT id, VECTOR(Point(FLOAT64(0.0), FLOAT64(0.0)), Point(x1 + x2, y1 + y2)) AS points FROM coords INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"POINTS":[{"x":0.0,"y":0.0},{"x":4.0,"y":6.0}]}
{"ID":2,"POINTS":[{"x":0.0,"y":0.0},{"x":8.5,"y":20.5}]}

# Vector of points matches a sink schema declared as Point VECTOR
SELECT id, VECTOR(Point(x1, y1), Point(x2, y2)) AS points FROM coords INTO File(SCHEMA(id UINT64 NOT NULL, points Point VECTOR NOT NULL) AS "SINK"."SCHEMA", 'JSON' AS "SINK".OUTPUT_FORMAT);
----
{"ID":1,"POINTS":[{"x":1.0,"y":2.0},{"x":3.0,"y":4.0}]}
{"ID":2,"POINTS":[{"x":-1.5,"y":0.5},{"x":10.0,"y":20.0}]}

# Vector of fixed-size arrays of points: Nx2 grid
SELECT id, VECTOR(ARRAY(Point(x1, y1), Point(x2, y2)), ARRAY(Point(x2, y2), Point(x1, y1))) AS grid FROM coords INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"GRID":[[{"x":1.0,"y":2.0},{"x":3.0,"y":4.0}],[{"x":3.0,"y":4.0},{"x":1.0,"y":2.0}]]}
{"ID":2,"GRID":[[{"x":-1.5,"y":0.5},{"x":10.0,"y":20.0}],[{"x":10.0,"y":20.0},{"x":-1.5,"y":0.5}]]}

# Vectors of structs that themselves contain a struct plugin (Circle contains a Point)
SELECT id, VECTOR(Circle(Point(x1, y1), FLOAT64(1.0)), Circle(Point(x2, y2), FLOAT64(2.0))) AS circles FROM coords INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"CIRCLES":[{"center":{"x":1.0,"y":2.0},"radius":1.0},{"center":{"x":3.0,"y":4.0},"radius":2.0}]}
{"ID":2,"CIRCLES":[{"center":{"x":-1.5,"y":0.5},"radius":1.0},{"center":{"x":10.0,"y":20.0},"radius":2.0}]}

# A struct and a scalar cannot be joined
SELECT id, VECTOR(Point(x1, y1), x2) AS vec FROM coords INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007

# Two different struct types cannot be joined
SELECT id, VECTOR(Point(x1, y1), Circle(Point(x2, y2), FLOAT64(1.0))) AS vec FROM coords INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
ERROR 2007
