# name: Decimal.test
# description: Exercises the Decimal DataType plugin. A Decimal is stored as a struct of an unscaled INT64 and an INT32
# scale. The default deserializer parses textual numbers (with or without a decimal point), the default serializer
# re-inserts the decimal point, and the plugin registers `Add_Decimal_Decimal` so that `+` on two Decimal columns
# rescales the operand with the smaller scale before adding the unscaled values.
# groups: [Formatter, JSON]

CREATE LOGICAL SOURCE prices(id UINT64 NOT NULL, price Decimal NOT NULL, tax Decimal NOT NULL);
CREATE PHYSICAL SOURCE FOR prices TYPE File;
ATTACH INLINE
1,10.50,2.25
2,199.99,0.01
3,3.14159,1.00001
4,42,8

CREATE LOGICAL SOURCE mixedScales(id UINT64 NOT NULL, a Decimal NOT NULL, b Decimal NOT NULL);
CREATE PHYSICAL SOURCE FOR mixedScales TYPE File;
ATTACH INLINE
1,1.5,2.25
2,100.123,0.1
3,7,0.5
4,12.75,3

CREATE LOGICAL SOURCE sales(id UINT64 NOT NULL, ts UINT64 NOT NULL, price Decimal NOT NULL);
CREATE PHYSICAL SOURCE FOR sales TYPE File;
ATTACH INLINE
1,1,10.50
2,2,2.25
3,3,199.99
4,11,0.01
5,12,42
6,21,3.14159

CREATE LOGICAL SOURCE pricesJson(id UINT64 NOT NULL, price Decimal NOT NULL, tax Decimal NOT NULL);
CREATE PHYSICAL SOURCE FOR pricesJson TYPE File SET('JSON' AS INPUT_FORMATTER."TYPE");
ATTACH INLINE
{"ID":1,"PRICE":10.50,"TAX":2.25}
{"ID":2,"PRICE":199.99,"TAX":0.01}

# Round-trip Decimal columns through the CSV deserializer and the JSON serializer
SELECT * FROM prices INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"PRICE":10.50,"TAX":2.25}
{"ID":2,"PRICE":199.99,"TAX":0.01}
{"ID":3,"PRICE":3.14159,"TAX":1.00001}
{"ID":4,"PRICE":42,"TAX":8}

# Project a single Decimal column
SELECT id, price FROM prices INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"PRICE":10.50}
{"ID":2,"PRICE":199.99}
{"ID":3,"PRICE":3.14159}
{"ID":4,"PRICE":42}

# Add two Decimal columns with the same scale: the unscaled values are added and the scale is kept
SELECT id, price + tax AS total FROM prices INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"TOTAL":12.75}
{"ID":2,"TOTAL":200.00}
{"ID":3,"TOTAL":4.14160}
{"ID":4,"TOTAL":50}

# Add two Decimal columns with different scales: the operand with the smaller scale is upscaled to the larger one
SELECT id, a + b AS res FROM mixedScales INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"RES":3.75}
{"ID":2,"RES":100.223}
{"ID":3,"RES":7.5}
{"ID":4,"RES":15.75}

# Addition is commutative regardless of which operand carries the larger scale
SELECT id, b + a AS res FROM mixedScales INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"RES":3.75}
{"ID":2,"RES":100.223}
{"ID":3,"RES":7.5}
{"ID":4,"RES":15.75}

# Chain additions: the result of a Decimal add is itself a Decimal
SELECT id, price + tax + tax AS total FROM prices INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"TOTAL":15.00}
{"ID":2,"TOTAL":200.01}
{"ID":3,"TOTAL":5.14161}
{"ID":4,"TOTAL":58}

# Add a Decimal to itself
SELECT id, price + price AS doubled FROM prices INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"DOUBLED":21.00}
{"ID":2,"DOUBLED":399.98}
{"ID":3,"DOUBLED":6.28318}
{"ID":4,"DOUBLED":84}

# Decimals can also be read from a JSON source
SELECT * FROM pricesJson INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"PRICE":10.50,"TAX":2.25}
{"ID":2,"PRICE":199.99,"TAX":0.01}

# Added Decimals read from a JSON source
SELECT id, price + tax AS total FROM pricesJson INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"ID":1,"TOTAL":12.75}
{"ID":2,"TOTAL":200.00}

# Decimals can be written into a CSV sink

SELECT * FROM prices INTO FILE();
----
1,10.50,2.25
2,199.99,0.01
3,3.14159,1.00001
4,42,8

# SUM over a Decimal column: the aggregation state is a Decimal starting at 0 (scale 0) and the plugin's Add_Decimal_Decimal
# is used for lift and combine, so operands with a smaller scale are upscaled before adding
SELECT start, end, SUM(price) AS total FROM sales WINDOW TUMBLING(ts, size 10 ms) INTO File('JSON' as "SINK".OUTPUT_FORMAT);
----
{"START":0,"END":10,"TOTAL":212.74}
{"START":10,"END":20,"TOTAL":42.01}
{"START":20,"END":30,"TOTAL":3.14159}
