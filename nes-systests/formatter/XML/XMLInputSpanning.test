# name: formatter/XML/XMLInputSpanning.test
# description: Packed-XML config of the HL7 indexers with records spanning raw-buffer boundaries.
#   The fixture (testdata/small/xml/mixed_types_50.xml, ~275 bytes/record, 50 records) is read with
#   4096-byte buffers, so record bodies regularly straddle buffers and the 1-byte '\n' message
#   delimiter lands on either side of the split (a 1-byte delimiter cannot itself be split -- the
#   simpler spanning shape vs HL7's FS|CR pair). The result checker sorts rows, so multi-threaded
#   buffer order is irrelevant. Record data mirrors small/hl7/mixed_types_50.hl7, so the expected
#   rows are the HL7InputSpanning ones verbatim.
#   Fixture leaf layout (F=5 -> arity 25): values at slots 4 (id INT32), 8 (price FLOAT64),
#   12 (name VARSIZED), 16 (url VARSIZED, ~200 chars), 20 (opt UINT64 nullable -- empty element on
#   every third record); x01..x20 are the junk leaves around them.
# groups: [Formatter, XML]

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [4096]

CREATE LOGICAL SOURCE xmlMixed(x01 VARSIZED, x02 VARSIZED, x03 VARSIZED, x04 VARSIZED, id INT32 NOT NULL, x05 VARSIZED, x06 VARSIZED, x07 VARSIZED, price FLOAT64 NOT NULL, x08 VARSIZED, x09 VARSIZED, x10 VARSIZED, name VARSIZED NOT NULL, x11 VARSIZED, x12 VARSIZED, x13 VARSIZED, url VARSIZED NOT NULL, x14 VARSIZED, x15 VARSIZED, x16 VARSIZED, opt UINT64, x17 VARSIZED, x18 VARSIZED, x19 VARSIZED, x20 VARSIZED);
CREATE PHYSICAL SOURCE FOR xmlMixed TYPE File SET("HL7" AS INPUT_FORMATTER.`TYPE`, '\n' AS INPUT_FORMATTER.message_delimiter, '<' AS INPUT_FORMATTER.segment_delimiter, '>' AS INPUT_FORMATTER.field_delimiter, '' AS INPUT_FORMATTER.component_delimiter, '' AS INPUT_FORMATTER.subcomponent_delimiter);
ATTACH FILE small/xml/mixed_types_50.xml

CREATE LOGICAL SOURCE xmlMixedSimd(x01 VARSIZED, x02 VARSIZED, x03 VARSIZED, x04 VARSIZED, id INT32 NOT NULL, x05 VARSIZED, x06 VARSIZED, x07 VARSIZED, price FLOAT64 NOT NULL, x08 VARSIZED, x09 VARSIZED, x10 VARSIZED, name VARSIZED NOT NULL, x11 VARSIZED, x12 VARSIZED, x13 VARSIZED, url VARSIZED NOT NULL, x14 VARSIZED, x15 VARSIZED, x16 VARSIZED, opt UINT64, x17 VARSIZED, x18 VARSIZED, x19 VARSIZED, x20 VARSIZED);
CREATE PHYSICAL SOURCE FOR xmlMixedSimd TYPE File SET("SIMDHL7" AS INPUT_FORMATTER.`TYPE`, '\n' AS INPUT_FORMATTER.message_delimiter, '<' AS INPUT_FORMATTER.segment_delimiter, '>' AS INPUT_FORMATTER.field_delimiter, '' AS INPUT_FORMATTER.component_delimiter, '' AS INPUT_FORMATTER.subcomponent_delimiter);
ATTACH FILE small/xml/mixed_types_50.xml

CREATE SINK dataSink(xmlMixed.id INT32 NOT NULL, xmlMixed.price FLOAT64 NOT NULL, xmlMixed.name VARSIZED NOT NULL, xmlMixed.opt UINT64) TYPE File;
CREATE SINK dataSinkSimd(xmlMixedSimd.id INT32 NOT NULL, xmlMixedSimd.price FLOAT64 NOT NULL, xmlMixedSimd.name VARSIZED NOT NULL, xmlMixedSimd.opt UINT64) TYPE File;

SELECT id, price, name, opt FROM xmlMixed INTO dataSink;
----
1,1.07,bob,1000
2,2.14,carol,2000
