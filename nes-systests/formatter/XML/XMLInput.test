# name: formatter/XML/XMLInput.test
# description: Packed record-per-line XML parsed by the UNMODIFIED HL7 indexers, purely by
#   configuration (the XML plan's generality claim): structural class {<,>} (segment '<', field '>',
#   component/subcomponent disabled), 1-byte message delimiter '\n'. Splitting at every structural
#   byte yields arity 4F+5 leaves for F data elements -- element values standalone at slot 4f+4; tag
#   names, close tags and empties are junk leaves (VARSIZED, lazy -- projecting past them is free).
#   Fixture (testdata/small/xml/two_ints_10.xml, generated by generate_fixtures.py): 10 records
#   <rec><id>i</id><val>i*100</val></rec> for i in 1..10; F=2 -> arity 13, id at slot 4, val at 8.
# groups: [Formatter, XML]

CREATE LOGICAL SOURCE xmlStream(x01 VARSIZED, x02 VARSIZED, x03 VARSIZED, x04 VARSIZED, id INT32 NOT NULL, x05 VARSIZED, x06 VARSIZED, x07 VARSIZED, val UINT64 NOT NULL, x08 VARSIZED, x09 VARSIZED, x10 VARSIZED, x11 VARSIZED);
CREATE PHYSICAL SOURCE FOR xmlStream TYPE File SET("HL7" AS INPUT_FORMATTER.`TYPE`, '\n' AS INPUT_FORMATTER.message_delimiter, '<' AS INPUT_FORMATTER.segment_delimiter, '>' AS INPUT_FORMATTER.field_delimiter, '' AS INPUT_FORMATTER.component_delimiter, '' AS INPUT_FORMATTER.subcomponent_delimiter);
ATTACH FILE small/xml/two_ints_10.xml

CREATE SINK idValSink(xmlStream.id INT32 NOT NULL, xmlStream.val UINT64 NOT NULL) TYPE File;
CREATE SINK junkSink(xmlStream.x01 VARSIZED, xmlStream.x02 VARSIZED, xmlStream.x04 VARSIZED, xmlStream.x08 VARSIZED, xmlStream.x10 VARSIZED, xmlStream.id INT32 NOT NULL) TYPE File;

# The data elements at their 4f+4 leaf slots.
SELECT id, val FROM xmlStream INTO idValSink;
----
1,100
2,200
3,300
4,400
5,500
6,600
7,700
8,800
9,900
10,1000

# Junk leaves ARE addressable: the empty leaf before '<rec' (x01, nullable -> NULL), the root tag
# name (x02), the first element's tag name (x04), and the close tags (x08 = '/val', x10 = '/rec').
SELECT x01, x02, x04, x08, x10, id FROM xmlStream INTO junkSink;
----
NULL,rec,id,/val,/rec,1
NULL,rec,id,/val,/rec,2
NULL,rec,id,/val,/rec,3
NULL,rec,id,/val,/rec,4
NULL,rec,id,/val,/rec,5
NULL,rec,id,/val,/rec,6
NULL,rec,id,/val,/rec,7
NULL,rec,id,/val,/rec,8
NULL,rec,id,/val,/rec,9
NULL,rec,id,/val,/rec,10

# Same data through the SIMD variant (1-byte-delimiter flatten mode).
CREATE LOGICAL SOURCE xmlStreamSimd(x01 VARSIZED, x02 VARSIZED, x03 VARSIZED, x04 VARSIZED, id INT32 NOT NULL, x05 VARSIZED, x06 VARSIZED, x07 VARSIZED, val UINT64 NOT NULL, x08 VARSIZED, x09 VARSIZED, x10 VARSIZED, x11 VARSIZED);
CREATE PHYSICAL SOURCE FOR xmlStreamSimd TYPE File SET("SIMDHL7" AS INPUT_FORMATTER.`TYPE`, '\n' AS INPUT_FORMATTER.message_delimiter, '<' AS INPUT_FORMATTER.segment_delimiter, '>' AS INPUT_FORMATTER.field_delimiter, '' AS INPUT_FORMATTER.component_delimiter, '' AS INPUT_FORMATTER.subcomponent_delimiter);
ATTACH FILE small/xml/two_ints_10.xml

CREATE SINK idValSinkSimd(xmlStreamSimd.id INT32 NOT NULL, xmlStreamSimd.val UINT64 NOT NULL) TYPE File;

SELECT id, val FROM xmlStreamSimd INTO idValSinkSimd;
----
1,100
2,200
3,300
4,400
5,500
6,600
7,700
8,800
9,900
10,1000
