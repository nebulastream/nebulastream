# name: formatter/HL7/HL7Input.test
# description: HL7 input indexer -- MLLP-framed messages ("\x1C\r"-delimited), one message per record,
#   all structural bytes (segment <CR>, field |, component ^, subcomponent &) forming one delimiter
#   class. The schema covers ALL leaves in document order, including junk leaves (the "\x0BMSH" head,
#   the `^~\&` splits, the segment name, the empty pad after the final <CR>); junk leaves are VARSIZED
#   and lazy -- projecting past them costs nothing. Fixture (testdata/small/hl7/two_ints_10.hl7,
#   generated by generate_fixtures.py): 10 messages, header
#   MSH|^~\&|NES|NES|BENCH|BENCH|20260101000000||ORU^R01|1|P|2.5, segment OBX|<id>|<val> with
#   (id, val) = (i, i*100) for i in 1..10.
# groups: [Formatter, HL7]

CREATE LOGICAL SOURCE hl7Stream(h01 VARSIZED, h02 VARSIZED, h03 VARSIZED, h04 VARSIZED, h05 VARSIZED, h06 VARSIZED, h07 VARSIZED, h08 VARSIZED, h09 VARSIZED, h10 VARSIZED, h11 VARSIZED, h12 VARSIZED, h13 VARSIZED, h14 VARSIZED, h15 VARSIZED, seg VARSIZED, id INT32 NOT NULL, val UINT64 NOT NULL, pad VARSIZED);
CREATE PHYSICAL SOURCE FOR hl7Stream TYPE File SET("HL7" AS INPUT_FORMATTER.`TYPE`);
ATTACH FILE small/hl7/two_ints_10.hl7

CREATE SINK idValSink(hl7Stream.id INT32 NOT NULL, hl7Stream.val UINT64 NOT NULL) TYPE File;
CREATE SINK junkSink(hl7Stream.h05 VARSIZED, hl7Stream.h10 VARSIZED, hl7Stream.h11 VARSIZED, hl7Stream.seg VARSIZED, hl7Stream.id INT32 NOT NULL) TYPE File;

# The data fields at their leaf positions.
SELECT id, val FROM hl7Stream INTO idValSink;
----
1,100
2,200
3,300
4,400
5,500
6,600
7,700
8,800
9,900
10,1000

# Junk leaves ARE addressable: constant header leaves (h05 = sending app, h11 = message type), the
# empty MSH-8 leaf (h10, nullable -> NULL), and the segment name.
SELECT h05, h10, h11, seg, id FROM hl7Stream INTO junkSink;
----
NES,NULL,ORU,OBX,1
NES,NULL,ORU,OBX,2
NES,NULL,ORU,OBX,3
NES,NULL,ORU,OBX,4
NES,NULL,ORU,OBX,5
NES,NULL,ORU,OBX,6
NES,NULL,ORU,OBX,7
NES,NULL,ORU,OBX,8
NES,NULL,ORU,OBX,9
NES,NULL,ORU,OBX,10

# Same data through the SIMD variant of the indexer.
CREATE LOGICAL SOURCE hl7StreamSimd(h01 VARSIZED, h02 VARSIZED, h03 VARSIZED, h04 VARSIZED, h05 VARSIZED, h06 VARSIZED, h07 VARSIZED, h08 VARSIZED, h09 VARSIZED, h10 VARSIZED, h11 VARSIZED, h12 VARSIZED, h13 VARSIZED, h14 VARSIZED, h15 VARSIZED, seg VARSIZED, id INT32 NOT NULL, val UINT64 NOT NULL, pad VARSIZED);
CREATE PHYSICAL SOURCE FOR hl7StreamSimd TYPE File SET("SIMDHL7" AS INPUT_FORMATTER.`TYPE`);
ATTACH FILE small/hl7/two_ints_10.hl7

CREATE SINK idValSinkSimd(hl7StreamSimd.id INT32 NOT NULL, hl7StreamSimd.val UINT64 NOT NULL) TYPE File;

SELECT id, val FROM hl7StreamSimd INTO idValSinkSimd;
----
1,100
2,200
3,300
4,400
5,500
6,600
7,700
8,800
9,900
10,1000
