# name: formatter/HL7/HL7InputSpanning.test
# description: HL7 input indexer with messages spanning raw-buffer boundaries. The fixture
#   (testdata/small/hl7/mixed_types_50.hl7, ~287 bytes/message, 50 messages) is read with 4096-byte
#   buffers, so message bodies regularly straddle buffers and the "\x1C\r" message delimiter itself
#   is occasionally split (FS as a buffer's last byte, CR as the next buffer's first) -- exercising
#   the multi-record spanning-tuple reassembly in parseLeadingRecord. The result checker sorts rows,
#   so multi-threaded buffer order is irrelevant.
#   Fixture leaf layout (22): h01..h15 header leaves, seg, then data (id INT32, price FLOAT64,
#   name VARSIZED, url VARSIZED, opt UINT64 nullable -- empty on every third message), pad.
# groups: [Formatter, HL7]

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [4096]

CREATE LOGICAL SOURCE hl7Mixed(h01 VARSIZED, h02 VARSIZED, h03 VARSIZED, h04 VARSIZED, h05 VARSIZED, h06 VARSIZED, h07 VARSIZED, h08 VARSIZED, h09 VARSIZED, h10 VARSIZED, h11 VARSIZED, h12 VARSIZED, h13 VARSIZED, h14 VARSIZED, h15 VARSIZED, seg VARSIZED, id INT32 NOT NULL, price FLOAT64 NOT NULL, name VARSIZED NOT NULL, url VARSIZED NOT NULL, opt UINT64, pad VARSIZED);
CREATE PHYSICAL SOURCE FOR hl7Mixed TYPE File SET("HL7" AS INPUT_FORMATTER.`TYPE`);
ATTACH FILE small/hl7/mixed_types_50.hl7

CREATE LOGICAL SOURCE hl7MixedSimd(h01 VARSIZED, h02 VARSIZED, h03 VARSIZED, h04 VARSIZED, h05 VARSIZED, h06 VARSIZED, h07 VARSIZED, h08 VARSIZED, h09 VARSIZED, h10 VARSIZED, h11 VARSIZED, h12 VARSIZED, h13 VARSIZED, h14 VARSIZED, h15 VARSIZED, seg VARSIZED, id INT32 NOT NULL, price FLOAT64 NOT NULL, name VARSIZED NOT NULL, url VARSIZED NOT NULL, opt UINT64, pad VARSIZED);
CREATE PHYSICAL SOURCE FOR hl7MixedSimd TYPE File SET("SIMDHL7" AS INPUT_FORMATTER.`TYPE`);
ATTACH FILE small/hl7/mixed_types_50.hl7

CREATE SINK dataSink(hl7Mixed.id INT32 NOT NULL, hl7Mixed.price FLOAT64 NOT NULL, hl7Mixed.name VARSIZED NOT NULL, hl7Mixed.opt UINT64) TYPE File;
CREATE SINK dataSinkSimd(hl7MixedSimd.id INT32 NOT NULL, hl7MixedSimd.price FLOAT64 NOT NULL, hl7MixedSimd.name VARSIZED NOT NULL, hl7MixedSimd.opt UINT64) TYPE File;

SELECT id, price, name, opt FROM hl7Mixed INTO dataSink;
----
1,1.07,bob,1000
2,2.14,carol,2000
