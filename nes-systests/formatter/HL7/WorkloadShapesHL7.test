# name: formatter/HL7/WorkloadShapesHL7.test
# description: The paper-workload query shapes through the HL7 three-rung ablation ladder
#   (r-base "SequentialUncompiledHL7" interpreted, r-comp "SequentialHL7" compiled W1 carry,
#   r-par "SIMDHL7" parallel) -- all three run the SAME SIMD flatten into the in-place event band.
#   Fixture small/hl7/bid_10.hl7 (generate_fixtures.py): 10 MLLP-framed messages
#   OBX|<ts>|<auctionId>|<bidder>|<price>|<channel>|<url>, bid_strings-shaped; 6 data fields ->
#   23 leaves (15 header + segment name + 6 data + trailing pad). Shapes: q_project (SELECT
#   price), q_route (varsized string-eq -> full-data-record output; literal SELECT * would also
#   emit the junk leaves, so the 6 data leaves are projected explicitly), q22 (unconditional
#   CONCAT alert), Q_ex (string-eq AND id-OR AND float threshold -> nested CONCAT of a FLOAT and
#   a UINT column). On the uncompiled rung these run against MATERIALIZED values (no lazy
#   raw-text forward), and every junk leaf is declared VARSIZED NOT NULL (the interpreted parse
#   loop has no NULL coercion; empty leaves parse as empty strings). Prices are exact binary
#   fractions in shortest form, so lazy raw-forward and materialize-then-serialize agree
#   byte-for-byte. 512-byte raw buffers force messages (~112 bytes) to straddle buffer
#   boundaries, exercising the sequential carry alongside the query shapes.
# groups: [Formatter, HL7, Workload]

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [512]

CREATE LOGICAL SOURCE bidUnc(h01 VARSIZED NOT NULL, h02 VARSIZED NOT NULL, h03 VARSIZED NOT NULL, h04 VARSIZED NOT NULL, h05 VARSIZED NOT NULL, h06 VARSIZED NOT NULL, h07 VARSIZED NOT NULL, h08 VARSIZED NOT NULL, h09 VARSIZED NOT NULL, h10 VARSIZED NOT NULL, h11 VARSIZED NOT NULL, h12 VARSIZED NOT NULL, h13 VARSIZED NOT NULL, h14 VARSIZED NOT NULL, h15 VARSIZED NOT NULL, seg VARSIZED NOT NULL, ts UINT64 NOT NULL, auctionId UINT64 NOT NULL, bidder UINT64 NOT NULL, price FLOAT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL, pad VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR bidUnc TYPE BlockingFile SET("SequentialUncompiledHL7" AS INPUT_FORMATTER.`TYPE`, "SEQUENTIAL" AS INPUT_FORMATTER.`THREADING_MODE`);
ATTACH FILE small/hl7/bid_10.hl7

CREATE LOGICAL SOURCE bidSeq(h01 VARSIZED, h02 VARSIZED, h03 VARSIZED, h04 VARSIZED, h05 VARSIZED, h06 VARSIZED, h07 VARSIZED, h08 VARSIZED, h09 VARSIZED, h10 VARSIZED, h11 VARSIZED, h12 VARSIZED, h13 VARSIZED, h14 VARSIZED, h15 VARSIZED, seg VARSIZED, ts UINT64 NOT NULL, auctionId UINT64 NOT NULL, bidder UINT64 NOT NULL, price FLOAT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL, pad VARSIZED);
CREATE PHYSICAL SOURCE FOR bidSeq TYPE BlockingFile SET("SequentialHL7" AS INPUT_FORMATTER.`TYPE`, "SEQUENTIAL" AS INPUT_FORMATTER.`THREADING_MODE`);
ATTACH FILE small/hl7/bid_10.hl7

CREATE LOGICAL SOURCE bidPar(h01 VARSIZED, h02 VARSIZED, h03 VARSIZED, h04 VARSIZED, h05 VARSIZED, h06 VARSIZED, h07 VARSIZED, h08 VARSIZED, h09 VARSIZED, h10 VARSIZED, h11 VARSIZED, h12 VARSIZED, h13 VARSIZED, h14 VARSIZED, h15 VARSIZED, seg VARSIZED, ts UINT64 NOT NULL, auctionId UINT64 NOT NULL, bidder UINT64 NOT NULL, price FLOAT64 NOT NULL, channel VARSIZED NOT NULL, url VARSIZED NOT NULL, pad VARSIZED);
CREATE PHYSICAL SOURCE FOR bidPar TYPE File SET("SIMDHL7" AS INPUT_FORMATTER.`TYPE`);
ATTACH FILE small/hl7/bid_10.hl7

# ---- r-base: interpreted (SequentialUncompiledHL7) ----

# q_project: k=1 projection.
SELECT price FROM bidUnc INTO File();
----
1.5
4.25
2.75
5.5
3.25
0.5
6.75
3.375
8.125
9.5

# q_route: string-eq against a MATERIALIZED varsized -> full-data-record output.
SELECT ts, auctionId, bidder, price, channel, url FROM bidUnc WHERE channel == VARSIZED("Google") INTO File();
----
1000,1001,21,1.5,Google,https://example.com/a
4000,1001,24,5.5,Google,https://example.com/d
5000,1005,25,3.25,Google,https://example.com/e
6000,1003,26,0.5,Google,https://example.com/f
8000,1001,28,3.375,Google,https://example.com/h

# q22: unconditional CONCAT alert.
SELECT auctionId, bidder, price, CONCAT(VARSIZED("alert: bid on channel "), channel) AS alert FROM bidUnc INTO File();
----
1001,21,1.5,alert: bid on channel Google
1002,22,4.25,alert: bid on channel Apple
1003,23,2.75,alert: bid on channel Bing
1001,24,5.5,alert: bid on channel Google
1005,25,3.25,alert: bid on channel Google
1003,26,0.5,alert: bid on channel Google
1007,27,6.75,alert: bid on channel Yahoo
1001,28,3.375,alert: bid on channel Google
1009,29,8.125,alert: bid on channel Apple
984,30,9.5,alert: bid on channel Bing

# Q_ex: the NEEDMI working example -- CONCAT of MATERIALIZED float + uint columns.
SELECT CONCAT(CONCAT(CONCAT(VARSIZED("Detected low price ("), price), VARSIZED(") [Google] for auction ")), auctionId) AS alert, ts AS rowcount FROM bidUnc WHERE channel == VARSIZED("Google") AND (auctionId == UINT64(1001) OR auctionId == UINT64(1003)) AND price < FLOAT64(3.5) INTO File();
----
Detected low price (1.5) [Google] for auction 1001,1000
Detected low price (0.5) [Google] for auction 1003,6000
Detected low price (3.375) [Google] for auction 1001,8000

