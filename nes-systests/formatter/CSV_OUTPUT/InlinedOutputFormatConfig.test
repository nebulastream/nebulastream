# name: OutputFormatConfig.test
# description: tests the output formatter configuration
# groups: [Formatter, CSV]

CREATE LOGICAL SOURCE csvSource(textdata VARSIZED);

CREATE PHYSICAL SOURCE FOR csvSource TYPE FileSource SET('CSV' AS "INPUT_FORMATTER"."TYPE");
ATTACH INLINE
This
is
a
test
quoted "string"

SELECT * FROM csvSource INTO FileSink('CSV' as "OUTPUT_FORMATTER"."TYPE", TRUE as "CSV_OUTPUT_FORMATTER".QUOTE_STRINGS);
----
"This"
"is"
"a"
"test"
"quoted ""string"""

SELECT * FROM csvSource INTO FileSink('CSV' as "OUTPUT_FORMATTER"."TYPE", FALSE as "CSV_OUTPUT_FORMATTER".QUOTE_STRINGS);
----
This
is
a
test
quoted "string"
