# name: formatter/SchemaJSON/SchemaJSONSpanning.test
# description: SchemaJSON across raw-buffer boundaries (M5). With 4096-byte raw buffers, 250 variable-length
#   NDJSON records total ~9622 bytes -> multiple raw buffers, with records straddling the boundaries. The
#   SequenceShredder stitches each split record and re-indexes it through the same SchemaJSON indexer. The
#   result checker sorts rows, so ordering across buffers is irrelevant; the SET of 250 rows must match.
# groups: [Formatter, SchemaJSON]

GlobalConfiguration worker.default_query_execution.operator_buffer_size: [4096]

CREATE LOGICAL SOURCE spanStream(id UINT64 NOT NULL, val UINT64 NOT NULL, name VARSIZED NOT NULL);
CREATE PHYSICAL SOURCE FOR spanStream TYPE File SET("SchemaJSON" AS INPUT_FORMATTER.`TYPE`);
ATTACH INLINE
