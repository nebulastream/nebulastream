"""Python builtins that Codon's stdlib does not define. NES imports this module into every Codon UDF
module (`from nes_compat import *`), so UDF code that names these builtins compiles.

NES passes a VARSIZED or CHAR argument declared with BYTES to Codon UDFs as bytes, and any other as a str that holds valid
UTF-8 (_nes_check_utf8), as the Python executions do (PythonPhysicalFunction.cpp). bytes wraps a str, which holds the raw
bytes, and does no copying.
"""


def _nes_check_utf8(value: str):
    """Raises ValueError unless value holds valid UTF-8. The str methods (unicode plugin) work on UTF-8 code points."""
    position = 0
    size = value.len
    while position < size:
        lead = int(value.ptr[position])
        if lead < 0x80:
            position += 1
            continue
        elif lead >> 5 == 0b110:
            length, minimum = 2, 0x80
        elif lead >> 4 == 0b1110:
            length, minimum = 3, 0x800
        elif lead >> 3 == 0b11110:
            length, minimum = 4, 0x10000
        else:
            raise ValueError("invalid UTF-8")
        if position + length > size:
            raise ValueError("invalid UTF-8")
        codepoint = lead & (0xFF >> (length + 1))
        for offset in range(1, length):
            continuation = int(value.ptr[position + offset])
            if continuation >> 6 != 0b10:
                raise ValueError("invalid UTF-8")
            codepoint = (codepoint << 6) | (continuation & 0x3F)
        if codepoint < minimum or codepoint > 0x10FFFF or 0xD800 <= codepoint <= 0xDFFF:
            raise ValueError("invalid UTF-8")
        position += length


def _nes_ascii_space(value: int) -> bool:
    """The whitespace of bytes.strip(): space, \\t, \\n, \\r, \\v and \\f."""
    return value == 32 or 9 <= value <= 13


class bytes:
    """Holds its bytes in a str and works on the bytes: the str methods (unicode plugin) work on code points, so these
    methods use the fields .ptr and .len of the str."""
    _value: str

    def __init__(self, value: str):
        self._value = value

    def __init__(self, data: Ptr[byte], size: int):
        self._value = str(data, size)

    def __len__(self) -> int:
        return self._value.len

    def __bool__(self) -> bool:
        return self._value.len > 0

    def __getitem__(self, index: int) -> int:
        size = self._value.len
        position = index + size if index < 0 else index
        if position < 0 or position >= size:
            raise IndexError("index out of range")
        return int(self._value.ptr[position])

    def __getitem__(self, indices: Slice) -> bytes:
        start, stop, step, length = indices.adjust_indices(self._value.len)
        if length <= 0:
            return bytes("")
        if step == 1:
            return bytes(str(self._value.ptr + start, length))
        data = Ptr[byte](length)
        for k in range(length):
            data[k] = self._value.ptr[start + k * step]
        return bytes(data, length)

    def __iter__(self) -> Generator[int]:
        for position in range(self._value.len):
            yield int(self._value.ptr[position])

    def __contains__(self, value: bytes) -> bool:
        return value._value in self._value

    def __contains__(self, value: int) -> bool:
        return any(element == value for element in self)

    def __eq__(self, other: bytes) -> bool:
        return self._value == other._value

    def __ne__(self, other: bytes) -> bool:
        return self._value != other._value

    def __hash__(self) -> int:
        return hash(self._value)

    def __add__(self, other: bytes) -> bytes:
        return bytes(self._value + other._value)

    def __repr__(self) -> str:
        """CPython's repr of bytes: printable ASCII stays, other bytes become \\xhh."""
        found_single = False
        found_double = False
        for value in self:
            if value == 39:
                found_single = True
            elif value == 34:
                found_double = True
        quote = '"' if found_single and not found_double else "'"
        digits = "0123456789abcdef"
        parts = ["b", quote]
        for value in self:
            if value == 92 or value == int(quote.ptr[0]):
                parts.append("\\" + chr(value))
            elif value == 9:
                parts.append("\\t")
            elif value == 10:
                parts.append("\\n")
            elif value == 13:
                parts.append("\\r")
            elif 32 <= value < 127:
                parts.append(chr(value))
            else:
                parts.append("\\x" + digits[value >> 4] + digits[value & 0xF])
        parts.append(quote)
        return "".join(parts)

    def __str__(self) -> str:
        return repr(self)

    def startswith(self, prefix: bytes) -> bool:
        return self._value.startswith(prefix._value)

    def endswith(self, suffix: bytes) -> bool:
        return self._value.endswith(suffix._value)

    def find(self, value: bytes) -> int:
        """The byte offset of value, or -1."""
        size = value._value.len
        for position in range(self._value.len - size + 1):
            if str(self._value.ptr + position, size) == value._value:
                return position
        return -1

    def split(self, separator: bytes) -> List[bytes]:
        return [bytes(part) for part in self._value.split(separator._value)]

    def strip(self) -> bytes:
        start = 0
        end = self._value.len
        while start < end and _nes_ascii_space(int(self._value.ptr[start])):
            start += 1
        while end > start and _nes_ascii_space(int(self._value.ptr[end - 1])):
            end -= 1
        return bytes(str(self._value.ptr + start, end - start))

    def _ascii_case(self, upper: bool) -> bytes:
        """bytes.lower() and bytes.upper() change ASCII letters only."""
        size = self._value.len
        data = Ptr[byte](size)
        for position in range(size):
            value = int(self._value.ptr[position])
            if upper and 97 <= value <= 122:
                value -= 32
            elif not upper and 65 <= value <= 90:
                value += 32
            data[position] = byte(value)
        return bytes(data, size)

    def lower(self) -> bytes:
        return self._ascii_case(False)

    def upper(self) -> bytes:
        return self._ascii_case(True)

    def replace(self, old: bytes, new: bytes) -> bytes:
        return bytes(self._value._replace(old._value, new._value, -1))

    def decode(self, encoding: str = "utf-8", errors: str = "strict") -> str:
        if encoding.lower() not in ("utf-8", "utf8") or errors != "strict":
            raise ValueError("bytes.decode only supports strict UTF-8")
        _nes_check_utf8(self._value)
        return self._value


@extend
class str:
    def encode(self, encoding: str = "utf-8", errors: str = "strict") -> bytes:
        return bytes(self)


class bytearray:
    pass


# ponytail: a mutable set, immutability is not enforced; a real frozenset class when a UDF needs to hash one.
def frozenset(iterable = List[int]()):
    return set(iterable)


def _nes_result(value):
    """Converts the result of a UDF to what NES expects for a VARSIZED result, a str holding the raw bytes."""
    if type(value).__name__ == "bytes":
        return value._value
    elif type(value).__name__ == "Optional[bytes]":
        return None if value is None else Optional[str](value._value)
    else:
        return value
