# Codon's stdlib internal/str.codon, shadowed by the unicode plugin.
#
# A Codon str holds UTF-8 bytes, and Codon's str methods work on the bytes: len() counts bytes, an index selects a byte,
# and lower() or isspace() know only ASCII. These methods work on code points and follow CPython's str methods
# (Objects/unicodeobject.c): len(), indexes, slices and the positions that find() returns count code points, and the
# character classes and case mappings follow Unicode. The Unicode data comes from the natives of the unicode plugin.
#
# The methods that work on whole byte sequences stay Codon's: comparison, hashing, search, replace, join, partition and
# split at a separator give the same result on UTF-8 bytes as on code points. They use the field .len, which is the
# number of bytes, because len() counts code points. Code that needs the bytes of a str uses .ptr and .len.
#
# A str is expected to hold valid UTF-8. NES checks the UDF arguments (nes_compat.codon), and str literals and the
# results of these methods are valid UTF-8.
#
# Changes to the original are marked with 'NES:'.

# Copyright (C) 2022-2026 Exaloop Inc. <https://exaloop.io>

_MAX: Literal[int] = 0x7FFFFFFFFFFFFFFF

# NES: the natives of the unicode plugin (src/Unicode.hpp).
@C
def nes_unicode_flags(code_point: i32) -> u32:
    pass

@C
def nes_unicode_map(code_point: i32, kind: int, out: Ptr[i32]) -> int:
    pass

@C
def nes_unicode_decimal(code_point: i32) -> int:
    pass

_NES_ALPHA: Literal[int] = 1
_NES_DECIMAL: Literal[int] = 2
_NES_DIGIT: Literal[int] = 4
_NES_NUMERIC: Literal[int] = 8
_NES_SPACE: Literal[int] = 16
_NES_PRINTABLE: Literal[int] = 32
_NES_LOWER: Literal[int] = 64
_NES_UPPER: Literal[int] = 128
_NES_TITLE: Literal[int] = 256
_NES_CASED: Literal[int] = 512
_NES_CASE_IGNORABLE: Literal[int] = 1024
_NES_XID_START: Literal[int] = 2048
_NES_XID_CONTINUE: Literal[int] = 4096
_NES_LINEBREAK: Literal[int] = 8192

_NES_MAP_LOWER: Literal[int] = 0
_NES_MAP_UPPER: Literal[int] = 1
_NES_MAP_TITLE: Literal[int] = 2
_NES_MAP_FOLD: Literal[int] = 3

def _nes_flags(code_point: int) -> int:
    return int(nes_unicode_flags(i32(code_point)))

def _nes_has(code_point: int, flag: int) -> bool:
    return (_nes_flags(code_point) & flag) != 0

def _nes_sequence_length(lead: int) -> int:
    """The length of the UTF-8 sequence that starts with the byte lead. A continuation byte counts as one character."""
    if lead < 0x80:
        return 1
    if lead >= 0xF0:
        return 4
    if lead >= 0xE0:
        return 3
    if lead >= 0xC0:
        return 2
    return 1

def _nes_encode(code_point: int, p: Ptr[byte]) -> int:
    """Writes the UTF-8 bytes of code_point to p and returns their number."""
    if code_point < 0x80:
        p[0] = byte(code_point)
        return 1
    if code_point < 0x800:
        p[0] = byte(0xC0 | (code_point >> 6))
        p[1] = byte(0x80 | (code_point & 0x3F))
        return 2
    if code_point < 0x10000:
        p[0] = byte(0xE0 | (code_point >> 12))
        p[1] = byte(0x80 | ((code_point >> 6) & 0x3F))
        p[2] = byte(0x80 | (code_point & 0x3F))
        return 3
    p[0] = byte(0xF0 | (code_point >> 18))
    p[1] = byte(0x80 | ((code_point >> 12) & 0x3F))
    p[2] = byte(0x80 | ((code_point >> 6) & 0x3F))
    p[3] = byte(0x80 | (code_point & 0x3F))
    return 4

def _nes_chr(code_point: int) -> str:
    p = Ptr[byte](4)
    n = _nes_encode(code_point, p)
    return str(p, n)

class _NesBuffer:
    """A growing UTF-8 buffer for the results of the methods below."""
    data: Ptr[byte]
    n: int
    m: int

    def __init__(self, capacity: int):
        m = capacity if capacity > 8 else 8
        self.data = Ptr[byte](m)
        self.n = 0
        self.m = m

    def _reserve(self, extra: int):
        from internal.gc import realloc
        needed = self.n + extra
        if needed > self.m:
            m = self.m
            while m < needed:
                m *= 2
            self.data = realloc(self.data, m, self.m)
            self.m = m

    def add(self, code_point: int):
        self._reserve(4)
        self.n += _nes_encode(code_point, self.data + self.n)

    def add_bytes(self, p: Ptr[byte], n: int):
        self._reserve(n)
        str.memcpy(self.data + self.n, p, n)
        self.n += n

    def add_str(self, s: str):
        self.add_bytes(s.ptr, s.len)

    def add_mapping(self, mapping: Ptr[i32], n: int):
        for k in range(n):
            self.add(int(mapping[k]))

    def add_hex(self, value: int, digits: int):
        h = "0123456789abcdef"
        k = digits - 1
        while k >= 0:
            self.add(int(h.ptr[(value >> (4 * k)) & 0xF]))
            k -= 1

    def __str__(self) -> str:
        return str(self.data, self.n)

@extend
class str:
    # Magic methods

    def __hash__(self) -> int:
        h = 0
        p, n = self.ptr, self.len
        i = 0
        while i < n:
            h = 31 * h + int(p[i])
            i += 1
        return h

    def __lt__(self, other: str) -> bool:
        return self._cmp(other) < 0

    def __le__(self, other: str) -> bool:
        return self._cmp(other) <= 0

    def __gt__(self, other: str) -> bool:
        return self._cmp(other) > 0

    def __ge__(self, other: str) -> bool:
        return self._cmp(other) >= 0

    # NES: the number of code points. The field .len is the number of bytes.
    def __len__(self) -> int:
        return self._nes_code_points()

    # NES: .len instead of __len__(), which counts code points.
    def c_str(self) -> cobj:
        n = self.len
        p = cobj(n + 1)
        str.memcpy(p, self.ptr, n)
        p[n] = byte(0)
        return p

    # NES: CPython's repr: printable characters stay, others become \xhh, \uhhhh or \Uhhhhhhhh.
    def __repr__(self) -> str:
        found_single = False
        found_double = False
        i = 0
        while i < self.len:
            if self.ptr[i] == byte(39):
                found_single = True
            elif self.ptr[i] == byte(34):
                found_double = True
            i += 1
        quote = 34 if found_single and not found_double else 39

        out = _NesBuffer(self.len + 2)
        out.add(quote)
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            i += n
            if code_point == quote or code_point == 92:
                out.add(92)
                out.add(code_point)
            elif code_point == 9:
                out.add(92)
                out.add(116)
            elif code_point == 10:
                out.add(92)
                out.add(110)
            elif code_point == 13:
                out.add(92)
                out.add(114)
            elif 32 <= code_point < 127 or (code_point >= 128 and _nes_has(code_point, _NES_PRINTABLE)):
                out.add(code_point)
            elif code_point < 0x100:
                out.add(92)
                out.add(120)
                out.add_hex(code_point, 2)
            elif code_point < 0x10000:
                out.add(92)
                out.add(117)
                out.add_hex(code_point, 4)
            else:
                out.add(92)
                out.add(85)
                out.add_hex(code_point, 8)
        out.add(quote)
        return str(out)

    # NES: indexes count code points.
    def __getitem__(self, idx: int) -> str:
        n = self._nes_code_points()
        if idx < 0:
            idx += n
        if not (0 <= idx < n):
            raise IndexError("string index out of range")
        if n == self.len:
            return str(self.ptr + idx, 1)
        start = self._nes_offset(idx)
        return str(self.ptr + start, self._nes_char_length(start))

    # NES: slices count code points.
    def __getitem__(self, s: Slice) -> str:
        if s.start is None and s.stop is None and s.step is None:
            return self.__copy__()
        n = self._nes_code_points()
        start, stop, step, length = s.adjust_indices(n)
        if length <= 0:
            return ""
        if n == self.len:
            if step == 1:
                return str(self.ptr + start, length)
            return self._make_from_range(start, stop, step, length)
        if step == 1:
            begin = self._nes_offset(start)
            end = begin + str(self.ptr + begin, self.len - begin)._nes_offset(length)
            return str(self.ptr + begin, end - begin)
        starts = self._nes_starts()
        out = _NesBuffer(length * 2)
        for k in range(length):
            index = start + k * step
            out.add_bytes(self.ptr + starts[index], starts[index + 1] - starts[index])
        return str(out)

    def _make_from_range(self, start: int, stop: int, step: int, length: int) -> str:
        p = Ptr[byte](length)
        j = 0
        for i in range(start, stop, step):
            p[j] = self.ptr[i]
            j += 1
        return str(p, length)

    # NES: yields code points.
    def __iter__(self) -> Generator[str]:
        i = 0
        while i < self.len:
            n = self._nes_char_length(i)
            yield str(self.ptr + i, n)
            i += n

    # NES: yields code points.
    def __reversed__(self) -> Generator[str]:
        i = self.len
        while i > 0:
            j = i - 1
            while j > 0 and (int(self.ptr[j]) & 0xC0) == 0x80:
                j -= 1
            yield str(self.ptr + j, i - j)
            i = j

    def __mul__(self, x: int) -> str:
        total = x * self.len
        p = Ptr[byte](total)
        n = 0
        for _ in range(x):
            str.memcpy(p + n, self.ptr, self.len)
            n += self.len
        return str(p, total)

    def _cmp(self, other: str) -> int:
        n = min(self.len, other.len)
        i = 0
        while i < n:
            c1 = self.ptr[i]
            c2 = other.ptr[i]
            if c1 != c2:
                return int(c1) - int(c2)
            i += 1
        return self.len - other.len

    # NES: UTF-8 helpers. Offsets count bytes, indexes count code points.

    def _nes_code_points(self) -> int:
        p = self.ptr
        n = self.len
        count = 0
        i = 0
        while i < n:
            if (int(p[i]) & 0xC0) != 0x80:
                count += 1
            i += 1
        return count

    def _nes_is_ascii(self) -> bool:
        p = self.ptr
        n = self.len
        i = 0
        while i < n:
            if int(p[i]) >= 0x80:
                return False
            i += 1
        return True

    def _nes_char_length(self, offset: int) -> int:
        n = _nes_sequence_length(int(self.ptr[offset]))
        return n if offset + n <= self.len else self.len - offset

    def _nes_decode(self, offset: int) -> Tuple[int, int]:
        """The code point at the byte offset and the number of its bytes."""
        lead = int(self.ptr[offset])
        if lead < 0x80:
            return (lead, 1)
        n = _nes_sequence_length(lead)
        if n == 1 or offset + n > self.len:
            return (lead, 1)
        code_point = lead & (0x7F >> n)
        for k in range(1, n):
            code_point = (code_point << 6) | (int(self.ptr[offset + k]) & 0x3F)
        return (code_point, n)

    def _nes_decode_all(self) -> List[int]:
        code_points = List[int](self.len)
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            code_points.append(code_point)
            i += n
        return code_points

    def _nes_offset(self, index: int) -> int:
        """The byte offset of the code point index; .len for the index len(self)."""
        p = self.ptr
        n = self.len
        k = 0
        i = 0
        while i < n:
            if (int(p[i]) & 0xC0) != 0x80:
                if k == index:
                    return i
                k += 1
            i += 1
        return n

    def _nes_index(self, offset: int) -> int:
        """The code point index of the byte offset."""
        return str(self.ptr, offset)._nes_code_points()

    def _nes_starts(self) -> List[int]:
        """The byte offset of each code point, and .len at the end."""
        starts = List[int](self.len + 1)
        i = 0
        while i < self.len:
            starts.append(i)
            i += self._nes_char_length(i)
        starts.append(self.len)
        return starts

    def _nes_all(self, flag: int) -> bool:
        """At least one code point, and all have the flag."""
        if self.len == 0:
            return False
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            if not _nes_has(code_point, flag):
                return False
            i += n
        return True

    def _nes_ascii_case(self, p: Ptr[byte], upper: bool) -> bool:
        """Writes the bytes to p with the ASCII letters in lower (or upper) case. True if all bytes are ASCII.

        The loop has no early exit and no call, so LLVM can vectorize it. A byte below 0x80 is always a complete
        character in UTF-8, so the bytes in p are correct for the ASCII characters of any string."""
        src = self.ptr
        first = 97 if upper else 65
        delta = -32 if upper else 32
        seen = 0
        for i in range(self.len):
            b = int(src[i])
            seen |= b
            p[i] = byte(b + delta if first <= b < first + 26 else b)
        return seen < 0x80

    def _nes_case_mixed(self, p: Ptr[byte], kind: int) -> str:
        """The case mapping of a string with non-ASCII characters. p holds the result of _nes_ascii_case: the runs of
        ASCII bytes come from p, and each other character goes through nes_unicode_map (lower: with the final sigma)."""
        src = self.ptr
        n = self.len
        out = _NesBuffer(n + 8)
        mapping = Ptr[i32](3)
        i = 0
        while i < n:
            start = i
            while i < n and int(src[i]) < 0x80:
                i += 1
            if i > start:
                out.add_bytes(p + start, i - start)
            if i < n:
                code_point, length = self._nes_decode(i)
                if kind == _NES_MAP_LOWER and code_point == 0x3A3:
                    out.add(0x3C2 if self._nes_final_sigma_at(i, length) else 0x3C3)
                else:
                    out.add_mapping(mapping, nes_unicode_map(i32(code_point), kind, mapping))
                i += length
        return str(out)

    def _nes_decode_before(self, offset: int) -> Tuple[int, int]:
        """The code point that ends at the byte offset and the byte offset where it starts."""
        start = offset - 1
        while start > 0 and (int(self.ptr[start]) & 0xC0) == 0x80:
            start -= 1
        code_point, n = self._nes_decode(start)
        if start + n != offset:
            return (int(self.ptr[offset - 1]), offset - 1)
        return (code_point, start)

    def _nes_final_sigma_at(self, offset: int, length: int) -> bool:
        """_nes_final_sigma on the bytes: the sigma at the byte offset has a cased letter before it and none after it."""
        j = offset
        cased_before = False
        while j > 0:
            code_point, j = self._nes_decode_before(j)
            if not _nes_has(code_point, _NES_CASE_IGNORABLE):
                cased_before = _nes_has(code_point, _NES_CASED)
                break
        if not cased_before:
            return False
        j = offset + length
        while j < self.len:
            code_point, n = self._nes_decode(j)
            if not _nes_has(code_point, _NES_CASE_IGNORABLE):
                return not _nes_has(code_point, _NES_CASED)
            j += n
        return True

    def _nes_add_lower(code_points: List[int], index: int, out: _NesBuffer, mapping: Ptr[i32]):
        """CPython's lower_ucs4: the full lowercase mapping, with the final form of a capital sigma."""
        code_point = code_points[index]
        if code_point == 0x3A3:
            out.add(0x3C2 if str._nes_final_sigma(code_points, index) else 0x3C3)
        else:
            out.add_mapping(mapping, nes_unicode_map(i32(code_point), _NES_MAP_LOWER, mapping))

    def _nes_final_sigma(code_points: List[int], index: int) -> bool:
        """CPython's handle_capital_sigma: a cased letter before the sigma, and none after it."""
        j = index - 1
        while j >= 0 and _nes_has(code_points[j], _NES_CASE_IGNORABLE):
            j -= 1
        if j < 0 or not _nes_has(code_points[j], _NES_CASED):
            return False
        j = index + 1
        while j < len(code_points) and _nes_has(code_points[j], _NES_CASE_IGNORABLE):
            j += 1
        return j == len(code_points) or not _nes_has(code_points[j], _NES_CASED)

import algorithms.strings as algorithms

@extend
class str:
    # NES: searches the bytes, which needs no code point positions.
    def __contains__(self, pattern: str) -> bool:
        return algorithms.find(self, pattern) >= 0

    # Helper methods. NES: they test bytes for ASCII, and the stdlib (format.codon, builtin.codon) uses them.

    def _isdigit(a: byte) -> bool:
        return _C.isdigit(i32(int(a))) != i32(0)

    def _isspace(a: byte) -> bool:
        return _C.isspace(i32(int(a))) != i32(0)

    def _isupper(a: byte) -> bool:
        return _C.isupper(i32(int(a))) != i32(0)

    def _islower(a: byte) -> bool:
        return _C.islower(i32(int(a))) != i32(0)

    def _isalpha(a: byte) -> bool:
        return _C.isalpha(i32(int(a))) != i32(0)

    def _isalnum(a: byte) -> bool:
        return _C.isalnum(i32(int(a))) != i32(0)

    def _toupper(a: byte) -> byte:
        return byte(int(_C.toupper(i32(int(a)))))

    def _tolower(a: byte) -> byte:
        return byte(int(_C.tolower(i32(int(a)))))

    def _slice(self, i: int, j: int) -> str:
        return str(self.ptr + i, j - i)

    def _at(self, i: int) -> str:
        return str(self.ptr + i, 1)

    def join(self, l: Generator[str]) -> str:
        buf = _strbuf()
        if self.len == 0:
            for a in l:
                buf.append(a)
        else:
            first = True
            for a in l:
                if first:
                    first = False
                else:
                    buf.append(self)
                buf.append(a)
        return buf.__str__()

    def join(self, l: List[str]) -> str:
        if len(l) == 0:
            return ""
        if len(l) == 1:
            return l[0]
        if self.len == 0:
            return str.cat(l)

        # compute length
        n = 0
        i = 0
        while i < len(l):
            n += l[i].len
            if i < len(l) - 1:
                n += self.len
            i += 1

        # copy to new buffer
        p = Ptr[byte](n)
        r = 0
        i = 0
        while i < len(l):
            str.memcpy(p + r, l[i].ptr, l[i].len)
            r += l[i].len
            if i < len(l) - 1:
                str.memcpy(p + r, self.ptr, self.len)
                r += self.len
            i += 1

        return str(p, n)

    # NES: the character classes of CPython, for all of Unicode.

    def isdigit(self) -> bool:
        return self._nes_all(_NES_DIGIT)

    def isdecimal(self) -> bool:
        return self._nes_all(_NES_DECIMAL)

    def isnumeric(self) -> bool:
        return self._nes_all(_NES_NUMERIC)

    def isalpha(self) -> bool:
        return self._nes_all(_NES_ALPHA)

    def isalnum(self) -> bool:
        return self._nes_all(_NES_ALPHA | _NES_DECIMAL | _NES_DIGIT | _NES_NUMERIC)

    def isspace(self) -> bool:
        return self._nes_all(_NES_SPACE)

    def isprintable(self) -> bool:
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            if not _nes_has(code_point, _NES_PRINTABLE):
                return False
            i += n
        return True

    def isascii(self) -> bool:
        return self._nes_is_ascii()

    def islower(self) -> bool:
        cased = False
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            flags = _nes_flags(code_point)
            if flags & (_NES_UPPER | _NES_TITLE):
                return False
            elif flags & _NES_LOWER:
                cased = True
            i += n
        return cased

    def isupper(self) -> bool:
        cased = False
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            flags = _nes_flags(code_point)
            if flags & (_NES_LOWER | _NES_TITLE):
                return False
            elif flags & _NES_UPPER:
                cased = True
            i += n
        return cased

    def istitle(self) -> bool:
        cased = False
        previous_is_cased = False
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            flags = _nes_flags(code_point)
            if flags & (_NES_UPPER | _NES_TITLE):
                if previous_is_cased:
                    return False
                previous_is_cased = True
                cased = True
            elif flags & _NES_LOWER:
                if not previous_is_cased:
                    return False
                previous_is_cased = True
                cased = True
            else:
                previous_is_cased = False
            i += n
        return cased

    def isidentifier(self) -> bool:
        if self.len == 0:
            return False
        code_point, n = self._nes_decode(0)
        if not _nes_has(code_point, _NES_XID_START):
            return False
        i = n
        while i < self.len:
            code_point, n = self._nes_decode(i)
            if not _nes_has(code_point, _NES_XID_CONTINUE):
                return False
            i += n
        return True

    # NES: the full case mappings of CPython, for all of Unicode. One pass maps the ASCII bytes. Only a string with
    # non-ASCII characters takes a second pass, which maps the non-ASCII characters one by one.

    def lower(self) -> str:
        n = self.len
        if n == 0:
            return ""
        p = Ptr[byte](n)
        if self._nes_ascii_case(p, False):
            return str(p, n)
        return self._nes_case_mixed(p, _NES_MAP_LOWER)

    def upper(self) -> str:
        n = self.len
        if n == 0:
            return ""
        p = Ptr[byte](n)
        if self._nes_ascii_case(p, True):
            return str(p, n)
        return self._nes_case_mixed(p, _NES_MAP_UPPER)

    def casefold(self) -> str:
        n = self.len
        if n == 0:
            return ""
        p = Ptr[byte](n)
        if self._nes_ascii_case(p, False):
            return str(p, n)
        return self._nes_case_mixed(p, _NES_MAP_FOLD)

    def swapcase(self) -> str:
        code_points = self._nes_decode_all()
        out = _NesBuffer(self.len)
        mapping = Ptr[i32](3)
        for k in range(len(code_points)):
            code_point = code_points[k]
            flags = _nes_flags(code_point)
            if flags & _NES_UPPER:
                str._nes_add_lower(code_points, k, out, mapping)
            elif flags & _NES_LOWER:
                out.add_mapping(mapping, nes_unicode_map(i32(code_point), _NES_MAP_UPPER, mapping))
            else:
                out.add(code_point)
        return str(out)

    def capitalize(self) -> str:
        code_points = self._nes_decode_all()
        out = _NesBuffer(self.len)
        mapping = Ptr[i32](3)
        for k in range(len(code_points)):
            if k == 0:
                out.add_mapping(mapping, nes_unicode_map(i32(code_points[0]), _NES_MAP_TITLE, mapping))
            else:
                str._nes_add_lower(code_points, k, out, mapping)
        return str(out)

    def title(self) -> str:
        code_points = self._nes_decode_all()
        out = _NesBuffer(self.len)
        mapping = Ptr[i32](3)
        previous_is_cased = False
        for k in range(len(code_points)):
            code_point = code_points[k]
            if previous_is_cased:
                str._nes_add_lower(code_points, k, out, mapping)
            else:
                out.add_mapping(mapping, nes_unicode_map(i32(code_point), _NES_MAP_TITLE, mapping))
            previous_is_cased = _nes_has(code_point, _NES_CASED)
        return str(out)

    def _build(*args):
        total = 0
        for t in args:
            if isinstance(t, str):
                total += t.len
            else:
                total += t[0].len * t[1]
        p = Ptr[byte](total)
        i = 0

        for t in args:
            if isinstance(t, str):
                str.memcpy(p + i, t.ptr, t.len)
                i += t.len
            else:
                s, n = t
                for _ in range(n):
                    str.memcpy(p + i, s.ptr, s.len)
                    i += s.len

        return str(p, total)

    # NES: widths count code points; the fill character is one code point.

    def ljust(self, width: int, fillchar: str = " ") -> str:
        if len(fillchar) != 1:
            raise TypeError("The fill character must be exactly one character long")
        n = len(self)
        if width <= n:
            return self
        return str._build(self, (fillchar, width - n))

    def rjust(self, width: int, fillchar: str = " ") -> str:
        if len(fillchar) != 1:
            raise TypeError("The fill character must be exactly one character long")
        n = len(self)
        if width <= n:
            return self
        return str._build((fillchar, width - n), self)

    def center(self, width: int, fillchar: str = " ") -> str:
        if len(fillchar) != 1:
            raise TypeError("The fill character must be exactly one character long")
        n = len(self)
        if width <= n:
            return self
        # NES: CPython's split of the padding, which puts the odd character to the left for an odd width.
        pad = width - n
        left_pad = pad // 2 + (pad & width & 1)
        return str._build((fillchar, left_pad), self, (fillchar, pad - left_pad))

    def zfill(self, width: int) -> str:
        n = len(self)
        if n >= width:
            return self

        plus = byte(43)   # +
        minus = byte(45)  # -
        zero = byte(48)   # 0

        zf = self.rjust(width, '0')
        fill = width - n
        p = zf.ptr

        if n > 0 and (p[fill] == plus or p[fill] == minus):
            p[0] = p[fill]
            p[fill] = zero

        return zf

    # NES: start, end and the returned positions count code points.

    def _nes_range(self, start: int, end: Optional[int]) -> Tuple[int, int, int]:
        """CPython's ADJUST_INDICES on code point indexes, and the number of code points."""
        n = len(self)
        e: int = end if end is not None else n
        if e > n:
            e = n
        elif e < 0:
            e += n
            if e < 0:
                e = 0
        if start < 0:
            start += n
            if start < 0:
                start = 0
        return (start, e, n)

    def _nes_bytes_of(self, start: int, end: int, n: int) -> Tuple[int, int]:
        """The byte offsets of the code point indexes start <= end <= n."""
        if n == self.len:
            return (start, end)
        begin = self._nes_offset(start)
        return (begin, begin + str(self.ptr + begin, self.len - begin)._nes_offset(end - start))

    def count(self, sub: str, start: int = 0, end: Optional[int] = None) -> int:
        start, e, n = self._nes_range(start, end)
        if start > n or e - start < len(sub):
            return 0
        if sub.len == 0:
            return e - start + 1
        begin, finish = self._nes_bytes_of(start, e, n)
        return algorithms.count(self._slice(begin, finish), sub)

    def find(self, sub: str, start: int = 0, end: Optional[int] = None) -> int:
        start, e, n = self._nes_range(start, end)
        if start > n or e - start < len(sub):
            return -1
        begin, finish = self._nes_bytes_of(start, e, n)
        pos = algorithms.find(self._slice(begin, finish), sub)
        return pos if pos < 0 else start + str(self.ptr + begin, pos)._nes_code_points()

    def rfind(self, sub: str, start: int = 0, end: Optional[int] = None) -> int:
        start, e, n = self._nes_range(start, end)
        if start > n or e - start < len(sub):
            return -1
        begin, finish = self._nes_bytes_of(start, e, n)
        pos = algorithms.rfind(self._slice(begin, finish), sub)
        return pos if pos < 0 else start + str(self.ptr + begin, pos)._nes_code_points()

    def index(self, sub: str, start: int = 0, end: Optional[int] = None) -> int:
        i = self.find(sub, start, end)
        if i == -1:
            raise ValueError("substring not found")
        else:
            return i

    def rindex(self, sub: str, start: int = 0, end: Optional[int] = None) -> int:
        i = self.rfind(sub, start, end)
        if i == -1:
            raise ValueError("substring not found")
        else:
            return i

    def _nes_tailmatch(self, sub: str, start: int, end: Optional[int], at_end: bool) -> bool:
        """CPython's tailmatch."""
        start, e, n = self._nes_range(start, end)
        sub_length = len(sub)
        e -= sub_length
        if e < start:
            return False
        if sub_length == 0:
            return True
        index = e if at_end else start
        offset = index if n == self.len else self._nes_offset(index)
        if offset + sub.len > self.len:
            return False
        return sub == self._slice(offset, offset + sub.len)

    def startswith(self, prefix: str, start: int = 0, end: Optional[int] = None) -> bool:
        return self._nes_tailmatch(prefix, start, end, False)

    def endswith(self, suffix: str, start: int = 0, end: Optional[int] = None) -> bool:
        return self._nes_tailmatch(suffix, start, end, True)

    # NES: whitespace is Unicode whitespace, as in CPython. strip(None) strips whitespace, strip("") nothing.

    def _nes_strip_set(self, chars: Optional[str]) -> List[int]:
        return chars._nes_decode_all() if chars is not None else List[int]()

    def _nes_strips(code_point: int, chars: Optional[str], strip_set: List[int]) -> bool:
        if chars is None:
            return _nes_has(code_point, _NES_SPACE)
        return code_point in strip_set

    def lstrip(self, chars: Optional[str] = None) -> str:
        strip_set = self._nes_strip_set(chars)
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            if not str._nes_strips(code_point, chars, strip_set):
                break
            i += n
        return self._slice(i, self.len)

    def rstrip(self, chars: Optional[str] = None) -> str:
        strip_set = self._nes_strip_set(chars)
        i = self.len
        while i > 0:
            j = i - 1
            while j > 0 and (int(self.ptr[j]) & 0xC0) == 0x80:
                j -= 1
            code_point, _ = self._nes_decode(j)
            if not str._nes_strips(code_point, chars, strip_set):
                break
            i = j
        return self._slice(0, i)

    def strip(self, chars: Optional[str] = None) -> str:
        return self.lstrip(chars).rstrip(chars)

    def partition(self, sep: str) -> Tuple[str, str, str]:
        if not sep:
            raise ValueError("empty separator")
        pos = algorithms.find(self, sep)
        if pos < 0:
            return self, "", ""
        return self._slice(0, pos), sep, self._slice(pos + sep.len, self.len)

    def rpartition(self, sep: str) -> Tuple[str, str, str]: # XXX
        if not sep:
            raise ValueError("empty separator")
        pos = algorithms.rfind(self, sep)
        if pos < 0:
            return "", "", self
        return self._slice(0, pos), sep, self._slice(pos + sep.len, self.len)

    def split(self, sep: Optional[str] = None, maxsplit: int = -1) -> List[str]:
        if sep is None:
            return self._split_whitespace(
                maxsplit if maxsplit >= 0 else _MAX
            )
        sep: str = sep

        if sep.len == 0:
            raise ValueError("empty separator")

        # special case for length-1 pattern
        if sep.len == 1:
            return self._split_char(sep.ptr[0], maxsplit if maxsplit >= 0 else _MAX)

        MAX_PREALLOC = 12
        maxsplit = maxsplit if maxsplit >= 0 else _MAX
        prealloc_size = MAX_PREALLOC if maxsplit >= MAX_PREALLOC else maxsplit + 1
        v = List[str](capacity=prealloc_size)
        i = 0
        j = 0
        n = self.len

        while maxsplit > 0:
            maxsplit -= 1
            pos = algorithms.find(self._slice(i, n), sep)
            if pos < 0:
                break
            j = i + pos
            v.append(self._slice(i, j))
            i = j + sep.len

        v.append(self._slice(i, n))
        return v

    def rsplit(self, sep: Optional[str] = None, maxsplit: int = -1) -> List[str]:
        if sep is None:
            return self._rsplit_whitespace(
                maxsplit if maxsplit >= 0 else _MAX
            )
        sep: str = sep

        if sep.len == 0:
            raise ValueError("empty separator")

        # special case for length-1 pattern
        if sep.len == 1:
            return self._rsplit_char(sep.ptr[0], maxsplit if maxsplit >= 0 else _MAX)

        MAX_PREALLOC = 12
        maxsplit = maxsplit if maxsplit >= 0 else _MAX
        prealloc_size = MAX_PREALLOC if maxsplit >= MAX_PREALLOC else maxsplit + 1
        v = List[str](capacity=prealloc_size)
        i = 0
        j = self.len
        n = j

        while maxsplit > 0:
            maxsplit -= 1
            pos = algorithms.rfind(self._slice(0, j), sep)
            if pos < 0:
                break
            v.append(self._slice(pos + sep.len, j))
            j = pos

        v.append(self._slice(0, j))
        v.reverse()
        return v

    # NES: CPython's line boundaries: \n, \r, \r\n, \v, \f, \x1c, \x1d, \x1e, \x85,   and  .
    def splitlines(self, keepends: bool = False) -> List[str]:
        v = List[str]()
        i = 0
        j = 0
        n = self.len
        while i < n:
            eol = i
            found = False
            while i < n:
                code_point, length = self._nes_decode(i)
                if _nes_has(code_point, _NES_LINEBREAK):
                    eol = i
                    i += length
                    if code_point == 13 and i < n and self.ptr[i] == byte(10):
                        i += 1
                    found = True
                    break
                i += length
            if not found:
                eol = n
            if keepends:
                eol = i
            if j == 0 and eol == n:
                v.append(self)
                break
            v.append(self._slice(j, eol))
            j = i
        return v

    def replace(self, old: str, new: str, maxcount: int = -1) -> str:
        # NES: an empty old inserts new between code points, not bytes.
        if old.len == 0 and not self._nes_is_ascii():
            if maxcount == 0 or new.len == 0:
                return self
            remaining = maxcount if maxcount > 0 else _MAX
            out = _NesBuffer(self.len + new.len)
            out.add_str(new)
            remaining -= 1
            i = 0
            while i < self.len:
                n = self._nes_char_length(i)
                out.add_bytes(self.ptr + i, n)
                i += n
                if remaining > 0:
                    out.add_str(new)
                    remaining -= 1
            return str(out)
        return self._replace(old, new, maxcount)

    # NES: columns count code points.
    def expandtabs(self, tabsize: int = 8) -> str:
        out = _NesBuffer(self.len)
        column = 0
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            if code_point == 9:
                if tabsize > 0:
                    spaces = tabsize - (column % tabsize)
                    column += spaces
                    for _ in range(spaces):
                        out.add(32)
            else:
                out.add_bytes(self.ptr + i, n)
                column += 1
                if code_point == 10 or code_point == 13:
                    column = 0
            i += n
        return str(out)

    # NES: the keys of map are code points (ord()), and a value is a str, a code point or None.
    def translate(self, map) -> str:
        out = _NesBuffer(self.len)
        i = 0
        while i < self.len:
            code_point, n = self._nes_decode(i)
            if code_point in map:
                val = map[code_point]
                if isinstance(val, int):
                    out.add(val)
                elif val is not None:
                    out.add_str(val)
            else:
                out.add_bytes(self.ptr + i, n)
            i += n
        return str(out)


    # Internal helpers

    def _correct_indices(self, start: int, end: int) -> Tuple[int, int]:
        n = self.len

        if end > n:
            end = n
        elif end < 0:
            end += n
            if end < 0:
                end = 0

        if start < 0:
            start += n
            if start < 0:
                start = 0

        return (start, end)

    # NES: CPython's whitespace (str.isspace) separates the words.
    def _split_whitespace(self, maxcount: int) -> List[str]:
        PREALLOC_MAX = 12
        l = List[str](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = self.len
        i = 0
        while i < str_len:
            # skip whitespace
            while i < str_len:
                code_point, n = self._nes_decode(i)
                if not _nes_has(code_point, _NES_SPACE):
                    break
                i += n
            if i == str_len:
                break
            if maxcount == 0:
                # the rest, with its trailing whitespace, as in CPython
                l.append(self._slice(i, str_len))
                return l
            maxcount -= 1
            j = i
            while i < str_len:
                code_point, n = self._nes_decode(i)
                if _nes_has(code_point, _NES_SPACE):
                    break
                i += n
            l.append(self._slice(j, i))
        return l

    # NES: CPython's whitespace (str.isspace) separates the words.
    def _rsplit_whitespace(self, maxcount: int) -> List[str]:
        PREALLOC_MAX = 12
        l = List[str](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        i = self.len
        while i > 0:
            # skip whitespace
            while i > 0:
                j = i - 1
                while j > 0 and (int(self.ptr[j]) & 0xC0) == 0x80:
                    j -= 1
                code_point, _ = self._nes_decode(j)
                if not _nes_has(code_point, _NES_SPACE):
                    break
                i = j
            if i == 0:
                break
            if maxcount == 0:
                # the rest, with its leading whitespace, as in CPython
                l.append(self._slice(0, i))
                l.reverse()
                return l
            maxcount -= 1
            end = i
            while i > 0:
                j = i - 1
                while j > 0 and (int(self.ptr[j]) & 0xC0) == 0x80:
                    j -= 1
                code_point, _ = self._nes_decode(j)
                if _nes_has(code_point, _NES_SPACE):
                    break
                i = j
            l.append(self._slice(i, end))
        l.reverse()
        return l

    def _split_char(self, char: byte, maxcount: int) -> List[str]:
        PREALLOC_MAX = 12
        l = List[str](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = self.len
        i = 0
        j = 0

        while i < str_len and maxcount > 0:
            if self.ptr[i] == char:
                l.append(self._slice(j, i))
                j = i + 1
                maxcount -= 1
            i += 1

        l.append(self._slice(j, str_len))
        return l

    def _rsplit_char(self, char: byte, maxcount: int) -> List[str]:
        PREALLOC_MAX = 12
        l = List[str](PREALLOC_MAX if maxcount >= PREALLOC_MAX else maxcount + 1)

        str_len = self.len
        i = str_len - 1
        j = str_len - 1

        while i >= 0 and maxcount > 0:
            if self.ptr[i] == char:
                l.append(self._slice(i + 1, j + 1))
                j = i - 1
                maxcount -= 1
            i -= 1

        l.append(self._slice(0, j + 1))
        l.reverse()
        return l

    def _findchar(self, c: byte):
        return _C.memchr(self.ptr, i32(int(c)), self.len)

    def _countchar(self, c: byte, maxcount: int):
        count = 0
        start = self.ptr
        end = start + self.len

        while True:
            start = str(start, end - start)._findchar(c)
            if not start:
                break
            count += 1
            if count >= maxcount:
                break
            start += 1
        return count

    def _replace_interleave(self, to: str, maxcount: int):
        self_s = self.ptr
        self_len = self.len
        to_len = to.len
        to_s = to.ptr
        count = 0
        i = 0

        if maxcount <= self_len:
            count = maxcount
        else:
            count = self_len + 1

        # assert count > 0
        if to_len > (_MAX - self_len) // count:
            raise OverflowError("replace bytes is too long")

        result_len = count * to_len + self_len
        result_s = Ptr[byte](result_len)
        result_s0 = result_s

        if to_len > 1:
            str.memcpy(result_s, to_s, to_len)
            result_s += to_len
            count -= 1

            while i < count:
                result_s[0] = self_s[0]
                result_s += 1
                self_s += 1
                str.memcpy(result_s, to_s, to_len)
                result_s += to_len
                i += 1
        else:
            result_s[0] = to_s[0]
            result_s += to_len
            count -= 1

            while i < count:
                result_s[0] = self_s[0]
                result_s += 1
                self_s += 1
                result_s[0] = to_s[0]
                result_s += to_len
                i += 1

        str.memcpy(result_s, self_s, self_len - i)
        return str(result_s0, result_len)

    def _replace_delete_single_character(self, from_c: byte, maxcount: int):
        self_len = self.len
        self_s = self.ptr

        count = self._countchar(from_c, maxcount)
        if count == 0:
            return self

        result_len = self_len - count
        # assert result_len >= 0
        result_s = Ptr[byte](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            nxt = str(start, end - start)._findchar(from_c)
            if not nxt:
                break
            str.memcpy(result_s, start, nxt - start)
            result_s += nxt - start
            start = nxt + 1

        str.memcpy(result_s, start, end - start)
        return str(result_s0, result_len)

    def _replace_delete_substring(self, from_s: str, maxcount: int):
        self_len = self.len
        self_s = self.ptr
        from_len = from_s.len

        count = algorithms.count_with_max(self, from_s, maxcount)
        if count == 0:
            return self

        result_len = self_len - (count * from_len)
        # assert result_len >= 0
        result_s = Ptr[byte](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            offset = algorithms.find(str(start, end - start), from_s)
            if offset == -1:
                break
            nxt = start + offset
            str.memcpy(result_s, start, nxt - start)
            result_s += nxt - start
            start = nxt + from_len

        str.memcpy(result_s, start, end - start)
        return str(result_s0, result_len)

    def _replace_single_character_in_place(self, from_c: byte, to_c: byte, maxcount: int):
        self_s = self.ptr
        self_len = self.len

        nxt = self._findchar(from_c)
        if not nxt:
            return self

        result_s = Ptr[byte](self_len)
        str.memcpy(result_s, self_s, self_len)

        start = result_s + (nxt - self_s)
        start[0] = to_c
        start += 1
        end = result_s + self_len
        maxcount -= 1

        while maxcount > 0:
            maxcount -= 1
            nxt = str(start, end - start)._findchar(from_c)
            if not nxt:
                break
            nxt[0] = to_c
            start = nxt + 1

        return str(result_s, self_len)

    def _replace_substring_in_place(self, from_s: str, to: str, maxcount: int):
        self_s = self.ptr
        self_len = self.len
        from_len = from_s.len
        to_s = to.ptr

        offset = algorithms.find(self, from_s)
        if offset == -1:
            return self

        result_s = Ptr[byte](self_len)
        str.memcpy(result_s, self_s, self_len)

        start = result_s + offset
        str.memcpy(start, to_s, from_len)
        start += from_len
        end = result_s + self_len
        maxcount -= 1

        while maxcount > 0:
            maxcount -= 1
            offset = algorithms.find(str(start, end - start), from_s)
            if offset == -1:
                break
            str.memcpy(start + offset, to_s, from_len)
            start += offset + from_len

        return str(result_s, self_len)

    def _replace_single_character(self, from_c: byte, to_s: str, maxcount: int):
        self_s = self.ptr
        self_len = self.len
        to_len = to_s.len

        count = self._countchar(from_c, maxcount)
        if count == 0:
            return self

        # assert count > 0
        if to_len - 1 > (_MAX - self_len) // count:
            raise OverflowError("replace bytes is too long")

        result_len = self_len + count * (to_len - 1)
        result_s = Ptr[byte](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            nxt = str(start, end - start)._findchar(from_c)
            if not nxt:
                break

            if nxt == start:
                str.memcpy(result_s, to_s.ptr, to_len)
                result_s += to_len
                start += 1
            else:
                str.memcpy(result_s, start, nxt - start)
                result_s += (nxt - start)
                str.memcpy(result_s, to_s.ptr, to_len)
                result_s += to_len
                start = nxt + 1

        str.memcpy(result_s, start, end - start)
        return str(result_s0, result_len)

    def _replace_substring(self, from_s: str, to_s: str, maxcount: int):
        self_s = self.ptr
        self_len = self.len
        from_len = from_s.len
        to_len = to_s.len

        count = algorithms.count_with_max(self, from_s, maxcount)
        if count == 0:
            return self

        # assert count > 0
        if to_len - from_len > (_MAX - self_len) // count:
            raise OverflowError("replace bytes is too long")

        result_len = self_len + count * (to_len - from_len)
        result_s = Ptr[byte](result_len)
        result_s0 = result_s

        start = self_s
        end = self_s + self_len
        while count > 0:
            count -= 1
            offset = algorithms.find(str(start, end - start), from_s)
            if offset == -1:
                break

            nxt = start + offset
            if nxt == start:
                str.memcpy(result_s, to_s.ptr, to_len)
                result_s += to_len
                start += from_len
            else:
                str.memcpy(result_s, start, nxt - start)
                result_s += (nxt - start)
                str.memcpy(result_s, to_s.ptr, to_len)
                result_s += to_len
                start = nxt + from_len

        str.memcpy(result_s, start, end - start)
        return str(result_s0, result_len)

    def _replace(self, from_s: str, to_s: str, maxcount: int):
        self_len = self.len
        from_len = from_s.len
        to_len = to_s.len

        if self_len < from_len:
            return self

        if maxcount < 0:
            maxcount = _MAX
        elif maxcount == 0:
            return self

        if from_len == 0:
            if to_len == 0:
                return self
            return self._replace_interleave(to_s, maxcount)

        if to_len == 0:
            if from_len == 1:
                return self._replace_delete_single_character(from_s.ptr[0], maxcount)
            return self._replace_delete_substring(from_s, maxcount)

        if from_len == to_len:
            if from_len == 1:
                return self._replace_single_character_in_place(from_s.ptr[0], to_s.ptr[0], maxcount)
            return self._replace_substring_in_place(from_s, to_s, maxcount)

        if from_len == 1:
            return self._replace_single_character(from_s.ptr[0], to_s, maxcount)
        else:
            return self._replace_substring(from_s, to_s, maxcount)

# NES: ord() and chr() for all code points. internal/__init__.codon imports this module after internal.builtin, so these
# replace the builtins, which work on one byte.
def ord(s: str) -> int:
    n = len(s)
    if n != 1:
        raise TypeError(
            f"ord() expected a character, but string of length {n} found"
        )
    code_point, _ = s._nes_decode(0)
    return code_point

def chr(i: int) -> str:
    if not (0 <= i <= 0x10FFFF):
        raise ValueError("chr() arg not in range(0x110000)")
    return _nes_chr(i)
