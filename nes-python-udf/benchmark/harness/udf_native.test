# name: benchmark/harness/udf_native.test
# description: UDFs over a NATIVE file source, no parsing
# groups: [benchmark]

CREATE LOGICAL SOURCE perf480(id INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR perf480 TYPE File SET('NATIVE' AS INPUT_FORMATTER."TYPE", 'PERFORMANCE' AS "SOURCE".CPUS);
ATTACH FILE udf/ids_480m.bin

CREATE LOGICAL SOURCE misc480(id INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR misc480 TYPE File SET('NATIVE' AS INPUT_FORMATTER."TYPE");
ATTACH FILE udf/ids_480m.bin

CREATE LOGICAL SOURCE perf60(id INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR perf60 TYPE File SET('NATIVE' AS INPUT_FORMATTER."TYPE", 'PERFORMANCE' AS "SOURCE".CPUS);
ATTACH FILE udf/ids_60m.bin

CREATE LOGICAL SOURCE misc60(id INT64 NOT NULL);
CREATE PHYSICAL SOURCE FOR misc60 TYPE File SET('NATIVE' AS INPUT_FORMATTER."TYPE");
ATTACH FILE udf/ids_60m.bin

CREATE FUNCTION inc_oop (x INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS AS $python$
    return x + 1
$python$;
CREATE FUNCTION lcg_oop (x INT64) RETURNS INT64 EXECUTION OUT_OF_PROCESS AS $python$
    h = x
    for _ in range(100):
        h = (h * 1103515245 + 12345) % 2147483648
    return h
$python$;

# 1, 2: source on a performance CPU
SELECT *, inc_oop(id) AS r FROM perf480 INTO Void();
----

SELECT *, lcg_oop(id) AS r FROM perf60 INTO Void();
----

# 3, 4: source on the misc CPUs
SELECT *, inc_oop(id) AS r FROM misc480 INTO Void();
----

SELECT *, lcg_oop(id) AS r FROM misc60 INTO Void();
----

# 5, 6: no UDF
SELECT * FROM misc480 INTO Void();
----

SELECT *, id + INT64(1) AS r FROM misc480 INTO Void();
----
