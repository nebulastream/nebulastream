"""Entry point of the connection-test runner.

It runs on the caller's Python with the stdlib only; pytest runs inside the runner container.
"""

import os
import sys

sys.path.insert(0, os.path.join(os.path.dirname(os.path.realpath(__file__)), "src"))

from conntest_runner.cli import main  # noqa: E402

if __name__ == "__main__":
    sys.exit(main())
