# Treat binary files as binary to prevent CRLF corruption and bad merges
*.onnx binary
*.png binary
*.zip binary
*.nes binary
*.bin binary
# Inference model fixtures (nes-inference/tests/testdata)
*.pb binary
*.pbtxt binary
*.meta binary
*.tflite binary
*.pdmodel binary
*.pdiparams binary
# TensorFlow SavedModel checkpoint shards have no usable suffix
nes-inference/tests/testdata/tiny_savedmodel/variables/* binary
# Unified-diff blank context lines intentionally contain one space.
vcpkg/vcpkg-registry/ports/nautilus/0005-object-code-cache.patch -whitespace
